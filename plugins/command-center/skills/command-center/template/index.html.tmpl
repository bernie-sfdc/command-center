   "FY27 Q3" shape. Analytics used FiscalQuarter__c for wins and the locally
   computed shape for creations, so the two could land in disjoint key sets and
   every row of the quarter table would show one or the other, never both. */
function normQ(v){
  const t = String(v==null?'':v).trim();
  /* Both orders: "FY27 Q3" and "Q3 FY27". The first pattern only matched the
     former, so the normaliser silently passed the latter through unchanged —
     which is the failure it exists to prevent. */
  let m = /(?:FY)?\s*(\d{2,4})\D*?Q\s*([1-4])/i.exec(t);
  if(!m){
