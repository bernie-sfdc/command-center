/* ═══════════════ Usage, overage and upsell ═══════════════
   Source: sfbase__EntitlementSchedule__c in Org62 — the same records behind the
   Usage Upsell Dashboard. Two of its formula fields do the work:

     RecommendedUpsellQuantity__c   positive = they need to buy more
     EstimatedOverageDate__c        when the allowance runs out at current pace

   The dashboard's own formula, per its FAQ, is
     average daily usage × remaining days = projected usage
     upsell quantity   = projected usage − current allowance
   which is what RecommendedUpsellQuantity__c already computes. Recomputing it
   here would risk disagreeing with the dashboard his manager looks at, so the
   Salesforce formula is used as-is and only interpreted.

   Usage__c is stored NEGATIVE (consumption drawn down from allowance), so a
   remaining balance below zero is a real overage. */
const RESTRICTED_RE = /restricted/i;
let _usage = null;
function usageRows(){
  return _usage || (_usage = usageRowsBuild());
}
function usageRowsBuild(){
  const now = today;
  return (S.ent||[])
    /* The FAQ is explicit that Restricted schedules are excluded from the
       dashboard. Showing them here would put him ahead of a number his
       manager cannot see. */
    .filter(r=>!RESTRICTED_RE.test(r.Usage_Classification__c||''))
    .map(r=>{
      /* num0(null) is 0 and Number.isFinite(0) is true, so the "if the formula
         came back null, fall back" branch below could never execute — Salesforce
         returns an explicit null for an unpopulated formula. NaN, not 0. */
      const nn = v => (v === null || v === undefined || v === '') ? NaN : Number(v);
      const allow = nn(r.sfbase__Allowance__c) || 0;
      const rem   = nn(r.Remaining_Balance__c);
      const up    = nn(r.RecommendedUpsellQuantity__c);
      const daily = nn(r.AverageDailyUsage__c);
      /* Usage__c is the authoritative consumption figure and is stored NEGATIVE.
         Deriving "used" from Remaining_Balance__c alone meant that if that formula
         came back null — which it can, being cross-object — a fully consumed
         entitlement rendered as Used 0, 0.0%, no overage tag. Prefer the real
         field, fall back to the balance, and only then give up. */
      const rawUse = nn(r.Usage__c);
      const used  = Number.isFinite(rawUse) && rawUse !== 0 ? Math.abs(rawUse)
                  : (allow && Number.isFinite(rem) ? (allow - rem) : 0);
      const pct   = allow > 0 ? (used / allow) * 100 : null;
      const eod   = r.EstimatedOverageDate__c || null;
      const end   = r.sfbase__EndDate__c || null;
      /* Predicted only counts if the run-out lands BEFORE the term ends. */
      const predicted = !!(eod && end && eod < end && eod >= now);
      /* Over if the balance says so, or — when the balance is missing — if
         consumption has passed the allowance. */
      const over = Number.isFinite(rem) ? rem < 0 : (allow > 0 && used > allow);
      return {
        r, allow, rem, used, pct, daily, eod, end,
        upsell: Number.isFinite(up) && up > 0 ? up : 0,
        over, predicted,
        acct: (r.sfbase__Entitlement__r && r.sfbase__Entitlement__r.sfbase__Account__r
               && r.sfbase__Entitlement__r.sfbase__Account__r.Name) || '—',
        acctId: (r.sfbase__Entitlement__r && r.sfbase__Entitlement__r.sfbase__Account__c) || null,
        type: (r.sfbase__Entitlement__r && r.sfbase__Entitlement__r.UsageType__r
               && r.sfbase__Entitlement__r.UsageType__r.Name) || 'entitlement',
        hasOpp: r.AddOnOpportunityCreated__c === true,
      };
    })
    /* Only what is actionable. A line at 0.02% of a five-year allowance is not
       a signal, and 277 of those would bury the two that are. */
    .filter(x=>x.over || x.upsell > 0 || x.predicted)
    .sort((a,b)=>(b.over?1:0)-(a.over?1:0) || b.upsell-a.upsell);
}
function num(n){
  const v = Number(n);
  if(!Number.isFinite(v)) return '—';
  if(Math.abs(v) >= 1e9) return (v/1e9).toFixed(2)+'B';
  if(Math.abs(v) >= 1e6) return (v/1e6).toFixed(2)+'M';
  if(Math.abs(v) >= 1e3) return Math.round(v).toLocaleString('en-US');
  return (Math.round(v*100)/100).toLocaleString('en-US');
}
