async function loadContacts(slug, force){
  const f = famRoll().find(x=>x.slug===slug); if(!f) return;
  $('draftPanel').style.display='none';
  /* The cache was being written and never read, so clicking the same family
     twice re-ran a LIMIT 200 Contact query. */
  if(!force && S.contacts[slug]){ paintContacts(slug); return; }
  $('peopleList').innerHTML = '<h3>'+esc(f.disp)+' contacts</h3><div class="empty"><span class="spin"></span> Loading from Salesforce…</div>';
  const ids = sfIdList(f.accts).slice(0,60).map(i=>"'"+i+"'").join(',');
  if(!ids){ $('peopleList').innerHTML='<div class="empty">No account records.</div>'; return; }
  try{
    const raw = await soql(
      "SELECT Id, Name, Title, Email, Department, AccountId, Account.Name, "+
      "LastActivityDate, CreatedDate, OwnerId, Owner.Name "+
      "FROM Contact WHERE AccountId IN ("+ids+") ORDER BY LastActivityDate DESC NULLS LAST LIMIT 200");

    /* Dedupe. Duplicate account records mean the same person appears several
       times. Key on email first (most reliable), else normalised name.
       Keep the record with the most recent activity and the richest title. */
    const seen = new Map();
    raw.forEach(c=>{
      const k = (c.Email || '').trim().toLowerCase() ||
                'n:'+(c.Name||'').trim().toLowerCase().replace(/[^a-z ]/g,'').replace(/\s+/g,' ');
      if(!k || k==='n:') return;
      const prev = seen.get(k);
      if(!prev){ seen.set(k, {...c, dupes:1}); return; }
      const better = (a,b)=>{
        const da = a.LastActivityDate||'', db = b.LastActivityDate||'';
        if(da !== db) return da > db ? a : b;
        return (a.Title||'').length >= (b.Title||'').length ? a : b;
      };
      const win = better(prev, c);
      seen.set(k, {...win, dupes:(prev.dupes||1)+1});
    });
    const rows = [...seen.values()];
    S.dupesRemoved = raw.length - rows.length;
    /* Stamp the two expensive derivations once per contact instead of four
       times per contact per render: roleOf runs up to 15 regexes and meddicOf
       calls it again internally. Re-stamped on render too — invalidateDerived
       clears these and only the fetch path used to set them, so after the first
       settle every paint was recomputing ~12,000 regex tests. */
    stampContacts(rows);
    S.contacts[slug] = rows;
    paintContacts(slug);
  }catch(e){
    /* Record the failure, so fillWriteWho's `if(!rows)` retry does not call
       this again on every resolve — an unbounded loop of LIMIT 200 queries. */
    S.contacts[slug] = [];
    S.err.contacts = e.message;
    const msg = '<div class="note err">Contact read failed: '+
      esc(plainErr(e.message))+' &mdash; nothing was loaded for this family.</div>';
    $('peopleList').innerHTML = msg;
    if($('wOut') && cur === 'write') $('wOut').innerHTML = msg;
  }
}
/* Split from the fetch so a cached family repaints with no connector call. */
function paintContacts(slug){
  const f = famRoll().find(x=>x.slug===slug); if(!f) return;
  const rows = S.contacts[slug] || [];
  stampContacts(rows);
  try{
    if(!rows.length){
      $('peopleList').innerHTML = '<h3>'+esc(f.disp)+' contacts</h3>'+
        '<div class="empty">No contacts on these account records.<br><span style="font-size:11px">'+
        'Worth adding &mdash; a family this size with no contacts means you\'re single-threaded on paper.</span></div>';
      return;
    }
    /* Coverage panel */
    const gaps = coverageGaps(rows);
    const seg = segOf(f);
    $('peopleGaps').style.display = 'block';
    $('peopleGaps').innerHTML = '<h3>'+esc(f.disp)+' &mdash; coverage '+
      '<span class="tag active">'+esc(seg.label)+'</span></h3>'+
      '<div class="meta" style="margin-bottom:10px">MEDDICC gaps across '+rows.length+
        ' mapped contacts. These are the seats that decide whether a deal closes or stalls.</div>'+
      (gaps.length ? '<div class="stack">'+gaps.map(g=>
        '<div style="border-left:3px solid '+(g.sev==='risk'?'var(--sf-red)':'#FE9339')+
        ';padding:7px 0 7px 11px"><strong style="font-size:12.5px">'+esc(g.t)+'</strong>'+
        '<div class="meta" style="margin-top:3px">'+esc(g.d)+'</div></div>').join('')+'</div>'
        : '<div class="note">All key MEDDICC seats have someone mapped. Confirm the Economic Buyer '+
          'and the Decision Process dates &mdash; those are the two that go stale quietest.</div>');

    /* Stakeholder map, grouped by seniority */
    const byLvl = {};
    rows.forEach((c,i)=>{ const {lvl} = c._role || roleOf(c);
      (byLvl[lvl.key] = byLvl[lvl.key] || {lvl, items:[]}).items.push({c,i}); });
    /* LEVELS is ordered for MATCHING (VP before C-suite); display goes by rank. */
    const order = LEVELS.slice().sort((a,b)=>a.rank-b.rank).map(l=>l.key).concat('unk');

    /* Capped. All 200 used to render — ~260KB of HTML and ~800 attached
       closures for a list nobody scrolls past the first screen of. */
    /* Per group, not one shared counter: a single running total meant a late
       group printed its full header count with zero rows underneath. */
    const PGCAP = 12;
    const totalShown = Object.values(byLvl)
      .reduce((t,g)=>t+Math.min(g.items.length, PGCAP), 0);
    $('peopleList').innerHTML = '<h3>Stakeholder map <span class="chip">'+
      (totalShown < rows.length ? totalShown+' of '+rows.length : rows.length)+
      '</span>'+(totalShown < rows.length
        ? ' <span class="meta" style="font-weight:500">newest '+PGCAP+
          ' per level</span>' : '')+'</h3>'+
      /* This legend used to say "green under 30, amber under 90, red never" —
         none of which matched the four .eng classes actually rendered. */
      '<div class="meta" style="margin-bottom:12px">Grouped by level of role. '+
        'Last touch: <span class="eng r30" title="under 30 days"></span> under 30 days &middot; '+
        '<span class="eng r90" title="under 90 days"></span> under 90 &middot; '+
        '<span class="eng old" title="over 90 days"></span> over 90 &middot; '+
        '<span class="eng never" title="never logged"></span> never logged. '+
        'Click anyone for detail. '+
        (LI_ROWS.length
          ? 'LinkedIn detail is embedded for '+LI_ROWS.length+' contact'+
            (LI_ROWS.length===1?'':'s')+'; everyone else links out to a search.'
          : '')+
        (S.dupesRemoved>0?' <strong>'+S.dupesRemoved+' duplicate record'+
          (S.dupesRemoved===1?'':'s')+' merged</strong> — your Org62 duplicate accounts were '+
          'listing the same people more than once.':'')+'</div>'+
      order.filter(k=>byLvl[k]).map(k=>{
        const grp = byLvl[k];
        const gShown = Math.min(grp.items.length, PGCAP);
        return '<div style="margin-bottom:14px">'+
          '<div class="sec" style="margin:0 0 7px">'+esc(grp.lvl.label)+
            ' <span style="color:var(--ink-3);font-weight:600">('+
              (grp.items.length > PGCAP ? gShown+' of '+grp.items.length
                                        : grp.items.length)+')</span></div>'+
          grp.items.slice(0, PGCAP).map(({c,i})=>{
            const d = daysAgo(c.LastActivityDate);
            /* Class names used to invert their own meaning: .eng.warm was amber
               and meant 90+ days, i.e. cold, while .eng.hot was less recent than
               .eng.champion — and "champion" was also a MEDDICC tag on the same
               row. Named for the threshold instead. */
            const eng = d==null?'never':d<30?'r30':d<90?'r90':'old';
            const {fn} = c._role || roleOf(c);
            const md = c._md || meddicOf(c);
            return '<div class="stk" data-s="'+i+'" data-f="'+slug+'" '+
                'tabindex="0" role="button" '+
                'style="padding:9px 0;border-bottom:1px solid var(--line);cursor:pointer">'+
              '<div class="row" style="gap:8px;flex-wrap:wrap">'+
                '<span class="eng '+eng+'"></span>'+
