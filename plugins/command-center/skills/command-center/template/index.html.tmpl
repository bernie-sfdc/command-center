/* Opens the panel. Always re-reads the record first: the page may have been
   open for hours, and a diff against stale values is worse than no diff. */
async function editRecord(obj, id, host){
  /* obj lands in a REST path, so it has to be one of the objects this app is
     allowed to touch — not merely one WRITABLE has no fields for. The write
     side was already safe (no fields, no diffs, applyEdit unreachable), but the
     GET could otherwise be steered to an arbitrary path. */
  if(!Object.prototype.hasOwnProperty.call(WRITABLE, obj)) return;
  const rid = sfId(id); if(!rid) return;
  const box = typeof host === 'string' ? $(host) : host;
  if(!box) return;
  if(box.dataset.open === '1'){ box.innerHTML=''; box.dataset.open='0'; return; }
  box.dataset.open = '1';
  box.innerHTML = '<div class="empty" style="padding:11px"><span class="spin"></span> '+
    'Re-reading the current values from Org62…</div>';

  const fields = WRITABLE[obj] || [];
  let live;
  try{
    const res = await call(SF, {
      url:'/services/data/'+APIV+'/sobjects/'+obj+'/'+rid,
      method:'GET',
      queryParams:{fields: fields.map(x=>x.f).join(',')},
    });
    if(!res || res.status_code !== 200) throw new Error('read returned '+(res&&res.status_code));
    live = res.body || {};
  }catch(e){
    box.innerHTML = '<div class="note err" style="margin-top:9px">Could not re-read the record: '+
      esc(plainErr(e.message))+'. Nothing was changed.</div>';
    return;
  }

  const uid = editKey(obj,rid);
  box.innerHTML = '<div class="exd-in" style="margin-top:9px">'+
    '<div class="sec" style="margin:0 0 8px">Edit in Salesforce</div>'+
    '<div class="meta" style="margin-bottom:10px">Current values, read from Org62 just now. '+
      'Change what is wrong and confirm &mdash; you will see a before and after first.</div>'+
    '<div class="adv-grid">'+
      fields.map(x=>{
        const cur = live[x.f];
        const v = cur == null ? '' : String(cur);
        const iid = uid+'-'+x.f;
        if(x.type === 'picklist'){
          const opts = x.opts ? x.opts() : [];
          const known = opts.indexOf(v) >= 0;
          return '<label>'+esc(x.label)+
            '<select id="'+iid+'" data-f="'+x.f+'" data-was="'+esc(v)+'">'+
              '<option value="">— not set —</option>'+
              (v && !known ? '<option value="'+esc(v)+'" selected>'+esc(v)+' (current)</option>' : '')+
              opts.map(o=>'<option value="'+esc(o)+'"'+(o===v?' selected':'')+'>'+esc(o)+'</option>').join('')+
            '</select></label>';
        }
        const t = x.type === 'number' ? 'number' : x.type === 'date' ? 'date' : 'text';
        return '<label>'+esc(x.label)+
          '<input type="'+t+'" id="'+iid+'" data-f="'+x.f+'" data-was="'+esc(v)+'" '+
            'value="'+esc(v)+'"></label>';
      }).join('')+
    '</div>'+
    '<div class="row" style="margin-top:11px">'+
      '<button class="btn" id="'+uid+'-review">Review the change</button>'+
      '<a class="btn sm ghost" href="'+SF_URL+obj+'/'+rid+'/view" target="_blank" '+
        'rel="noopener noreferrer">Open the record in Org62 ↗</a>'+
      '<span class="sp"></span>'+
      '<span class="meta">Nothing is written until you confirm.</span>'+
    '</div>'+
    (obj === 'Opportunity'
      ? '<div class="note warn" style="margin-top:10px">Only <strong>Next step</strong> is editable '+
        'here. Stage, amount and close date belong to the opportunity owner &mdash; agree those with '+
        'them and let them make the change.</div>'
      : '')+
    '<div id="'+uid+'-out" aria-live="polite"></div>'+
  '</div>';

  $(uid+'-review').onclick = ()=>reviewEdit(obj, rid, uid, live, fields);
}

function reviewEdit(obj, rid, uid, live, fields){
  const out = $(uid+'-out'); if(!out) return;
  const diffs = [];
  fields.forEach(x=>{
    const el = $(uid+'-'+x.f); if(!el) return;
    let now = el.value;
    const was = live[x.f] == null ? '' : String(live[x.f]);
    if(x.type === 'number'){
      /* "70000" and "70000.0" are the same number, and Salesforce returns the
         second. Compare numerically or every open of this panel shows a
         change that is not one. */
      const a = was === '' ? null : Number(was), b = now === '' ? null : Number(now);
      if(a === b) return;
      if(b != null && !Number.isFinite(b)) return;
      diffs.push({f:x.f, label:x.label, was, now, val: b});
      return;
    }
    if(now === was) return;
    diffs.push({f:x.f, label:x.label, was, now, val: now === '' ? null : now});
  });

  if(!diffs.length){
    out.innerHTML = '<div class="note" style="margin-top:10px">Nothing changed &mdash; '+
      'these values already match Org62.</div>';
    return;
  }

  out.innerHTML = '<div class="note warn" style="margin-top:10px">'+
    '<strong>Confirm '+diffs.length+' change'+(diffs.length===1?'':'s')+' to '+esc(obj==='Opportunity'?'this opportunity':'this SFR')+'</strong>'+
    '<div class="tw" style="margin-top:8px"><table><thead><tr>'+
      '<th scope="col">Field</th><th scope="col">Now in Org62</th><th scope="col">After</th>'+
    '</tr></thead><tbody>'+
      diffs.map(d=>'<tr><td><strong>'+esc(d.label)+'</strong></td>'+
        '<td style="color:var(--ink-3)">'+esc(d.was===''?'— empty —':d.was)+'</td>'+
        '<td style="color:var(--sf-blue);font-weight:600">'+esc(d.now===''?'— clear it —':d.now)+'</td></tr>').join('')+
    '</tbody></table></div>'+
    '<div class="row" style="margin-top:10px">'+
      '<button class="btn" id="'+uid+'-apply">Write this to Salesforce</button>'+
      '<button class="btn ghost" id="'+uid+'-cancel">Cancel</button>'+
    '</div></div>';

  $(uid+'-cancel').onclick = ()=>{ out.innerHTML = ''; };
  $(uid+'-apply').onclick  = ()=>applyEdit(obj, rid, uid, diffs);
}

async function applyEdit(obj, rid, uid, diffs){
  const out = $(uid+'-out'); if(!out) return;
  const btn = $(uid+'-apply');
  if(btn){ btn.disabled = true; btn.textContent = 'Writing…'; }

  const body = {};
  diffs.forEach(d=>{ body[d.f] = d.val; });

  /* The manual fallback, shown whenever the write cannot happen. It is the
     whole point of the panel still being useful without write access: the
     diagnosis is done and the exact values are in front of him. */
  const manual = why =>
    '<div class="note warn" style="margin-top:10px">'+
      '<strong>Nothing was written.</strong> '+esc(why)+
      '<div style="margin-top:8px">Enter these on the record yourself:</div>'+
      '<ul style="margin:6px 0 0;padding-left:18px;line-height:1.7">'+
        diffs.map(d=>'<li><strong>'+esc(d.label)+'</strong> → '+
          '<span class="mono">'+esc(d.now===''?'(clear the field)':d.now)+'</span></li>').join('')+
      '</ul>'+
      '<div class="row" style="margin-top:9px">'+
        '<a class="btn sm" href="'+SF_URL+obj+'/'+rid+'/view" target="_blank" '+
          'rel="noopener noreferrer">Open the record in Org62 ↗</a>'+
      '</div>'+
    '</div>';

  try{
    const res = await call(SFW, {
      url:'/services/data/'+APIV+'/sobjects/'+obj+'/'+rid,
      method:'PATCH',
      body,
    });
    /* A field update returns 204 No Content. Anything else is not a success,
       and is NOT retried — a refused write stays refused. */
    const code = res && res.status_code;
    if(code === 204 || code === 200){
      out.innerHTML = '<div class="note" style="margin-top:10px"><strong>Written to Salesforce.</strong> '+
        diffs.map(d=>esc(d.label)+' → '+esc(d.now===''?'cleared':d.now)).join(' · ')+
        '<div class="row" style="margin-top:9px">'+
          '<a class="btn sm" href="'+SF_URL+obj+'/'+rid+'/view" target="_blank" '+
            'rel="noopener noreferrer">See it in Org62 ↗</a>'+
          '<button class="btn sm ghost" id="'+uid+'-reload">Reload the app</button>'+
        '</div></div>';
      const r = $(uid+'-reload');
      if(r) r.onclick = ()=>reloadAll();
      return;
    }
    const detail = (res && res.body && JSON.stringify(res.body).slice(0,300)) || ('status '+code);
    out.innerHTML = manual('Salesforce refused the change: '+detail);
  }catch(e){
    const m = String(e && e.message || e);
    out.innerHTML = manual(
      /not permitted|bridge is not available|not currently shown/i.test(m)
        ? 'This app can read Org62 but is not authorised to write to it. That is a permission '+
          'setting on the Salesforce connector, not something the app can fix.'
        : plainErr(m));
  }finally{
    if(btn){ btn.disabled = false; btn.textContent = 'Write this to Salesforce'; }
  }
}

