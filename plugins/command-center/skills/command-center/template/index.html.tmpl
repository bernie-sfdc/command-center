const LEVELS = [
  {key:'evp',    rank:2, label:'EVP / SVP',        re:/\b(evp|svp|executive vice president|senior vice president)\b/i},
  {key:'vp',     rank:3, label:'VP',               re:/\b(vp|vice[\s-]?president|head of)\b/i},
  {key:'csuite', rank:1, label:'C-Suite & Board',  re:/\b(chief|c[eftoirm]o\b|cdo\b|ciso\b|cmo\b|cto\b|cio\b|coo\b|cfo\b|ceo\b|(?<!vice[\s-])president|board member|managing director|general manager|\bgm\b)/i},
  {key:'dir',    rank:4, label:'Director',         re:/\b(director|dir\.|sr\.? director|senior director|associate director)\b/i},
  {key:'mgr',    rank:5, label:'Manager / Lead',   re:/\b(manager|mgr|lead|supervisor|principal|architect|owner)\b/i},
  {key:'ic',     rank:6, label:'Practitioner',     re:/\b(specialist|analyst|engineer|consultant|coordinator|administrator|admin|developer|associate|scientist|technician)\b/i},
];
const FUNCS = [
  {key:'mktg',  label:'Marketing',        re:/marketing|brand|campaign|omnichannel|communications|digital marketing|crm/i},
  {key:'dig',   label:'Digital / eComm',  re:/digital|ecommerce|e-commerce|web|experience|omni/i},
  {key:'it',    label:'IT / Technology',  re:/\bit\b|information (technology|services|systems)|technology|infrastructure|security|ciso|salesforce|platform|architect|engineer/i},
  {key:'data',  label:'Data / Analytics', re:/data|analytics|insight|business intelligence|\bbi\b|reporting/i},
  {key:'comm',  label:'Commercial / Sales', re:/commercial|sales|revenue|business development|account manage|channel|distribut/i},
  {key:'clin',  label:'Clinical / Medical', re:/clinical|medical|scientific|pharmacovigilance|regulatory|quality|physician|nurse|patient (care|services)/i},
  {key:'ops',   label:'Operations',       re:/operations|\bops\b|supply chain|service|logistics|process|intake|revenue cycle/i},
  {key:'fin',   label:'Finance / Procurement', re:/finance|financial|procurement|purchasing|sourcing|contract|controller|treasur/i},
  {key:'cx',    label:'Customer / Member Experience', re:/customer|member|patient experience|\bcx\b|success|support|relationship/i},
];
function roleOf(c){
  const t = c.Title || '';
  const lvl = LEVELS.find(l=>l.re.test(t)) || {key:'unk', rank:7, label:'Level unknown'};
  const fn  = FUNCS.find(f=>f.re.test(t))  || {key:'unk', label:'Function unclear'};
  return {lvl, fn};
}
/* MEDDICC role is inferred, never asserted — the label carries a confidence. */
function meddicOf(c){
  const {lvl, fn} = roleOf(c);
  const d = daysAgo(c.LastActivityDate);
  const warm = d != null && d < 60;
  if(lvl.rank<=2 && /fin|comm|mktg|dig|cx/.test(fn.key))
    return {key:'eb',    label:'Economic Buyer', hint:'Seniority and function suggest budget authority — confirm.'};
  if(lvl.rank<=2)
    return {key:'eb?',   label:'Exec sponsor?',  hint:'Senior enough to sponsor; budget ownership unconfirmed.'};
  if(lvl.rank<=4 && warm && /mktg|dig|cx|comm/.test(fn.key))
    return {key:'champ', label:'Champion?',      hint:'Recent engagement in a buying function — test whether they sell internally.'};
  if(/it|data/.test(fn.key))
    return {key:'tech',  label:'Technical Buyer',hint:'Owns the architecture and security veto.'};
  if(/clin/.test(fn.key))
    return {key:'compl', label:'Clinical / Compliance', hint:'Can block on consent, PHI or MLR. Engage early, not late.'};
  if(/fin/.test(fn.key))
    return {key:'proc',  label:'Procurement',    hint:'Gate, not a sponsor. Sequence after value is agreed.'};
  return {key:'infl',    label:'Influencer',     hint:'Useful for discovery and internal wiring.'};
}
/* Coverage gaps across a family, in MEDDICC terms. */
function coverageGaps(rows){
  const g = [], roles = rows.map(meddicOf).map(r=>r.key);
  const warm = rows.filter(c=>{const d=daysAgo(c.LastActivityDate); return d!=null && d<60;});
  if(!roles.some(r=>r==='eb'||r==='eb?'))
    g.push({sev:'risk', t:'No executive sponsor mapped',
      d:'Nobody at C-suite, EVP or SVP level is on the account. MEDDICC Economic Buyer is unknown — a deal without one slips by default.'});
  if(!roles.includes('tech'))
    g.push({sev:'warm', t:'No technical buyer mapped',
      d:'No IT, Data or Security contact. In Healthcare that veto arrives late and kills timelines. Find them before the business case is signed off.'});
  if(!roles.includes('compl'))
    g.push({sev:'warm', t:'No clinical or compliance voice',
      d:'Consent, PHI and MLR review decide whether personalization ever ships. Engage this seat early.'});
  if(warm.length<=1)
    g.push({sev:'risk', t:warm.length?'Single-threaded':'No warm relationship',
      d:warm.length?'Exactly one contact has engaged in the last 60 days. If they move, the deal restarts.'
                   :'No contact has engaged in 60 days. This is a re-entry motion, not a live deal.'});
  if(!roles.includes('champ'))
    g.push({sev:'warm', t:'No champion identified',
      d:'A champion sells for you when you are not in the room. Without one you are running the deal alone.'});
  return g;
}
const OTHER = {slug:'other', disp:'Other / territory', tier:'territory', re:null};

function famOf(name){
