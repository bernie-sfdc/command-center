/* =================== ANALYTICS =================== */
/* Which fiscal quarter a date falls in, same calendar as Org62.
   Local-midnight construction, matching daysAgo and fmtDate: `new Date('2027-02-01')`
   is UTC midnight, which reads as 31 Jan in every US timezone — so a 1 Feb close
   date used to come back FY27 Q4 instead of FY28 Q1, and that fed the FY
   attainment tile, the quota gap and the forecast narrative. */
function qOf(iso){
  if(!iso) return null;
  const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(iso));
  return sfFiscal(m ? new Date(+m[1], +m[2]-1, +m[3]) : new Date(iso));
}

function renderAnalytics(){
  const all = S.sfrs || [];
  /* One early return used to cover three different situations and then skip
     loadActivity(), leaving three section headings over blank space. */
  if(S.err.sfr){
    $('anNote').innerHTML = '<div class="note err">Specialist forecast read failed: '+
      esc(plainErr(S.err.sfr))+'. Hit Reload in the header &mdash; the activity '+
      'section below still works.</div>';
    $('anKpis').innerHTML = ''; $('anQtrBody').innerHTML = '';
    loadActivity(); return;
  }
  if(!S.got.sfr){
    $('anNote').innerHTML = '<div class="note"><span class="spin"></span> '+
      'Reading your specialist forecast records…</div>';
    return;
  }
  if(!all.length){
    $('anNote').innerHTML = '<div class="note warn">You have no Marketing Cloud '+
      'specialist forecast records, so there is nothing to analyse yet. Create one '+
      'against each L1 opportunity &mdash; the Pipeline tab flags which are missing '+
      'them.</div>';
    $('anKpis').innerHTML = ''; $('anQtrBody').innerHTML = '';
    loadActivity(); return;
  }

  const won  = all.filter(sfrWon);
  const lost = all.filter(sfrLost);
  const open = all.filter(s=>!sfrWon(s) && !sfrLost(s));
  const fy   = CUR_Q.split(' ')[0];                       // e.g. FY27
  const wonFY = won.filter(inCurFY);

  $('anNote').innerHTML = truncNote() + '<div class="note">Your own numbers, computed from '+all.length+
    ' Marketing Cloud specialist forecast records and your logged Salesforce activity. '+
    '"Closed won" means the forecast judgement is Closed Won, or the specialist stage is a '+
    'closed-won stage &mdash; this is your specialist credit, not the core AE\'s booking.</div>';

  /* ---- quarter buckets: closed on close date, created on CreatedDate ---- */
  const Q = {};
  const bucket = q => (Q[q] = Q[q] || {won:0,wonAmt:0,lost:0,created:0,createdAmt:0});
  all.forEach(s=>{
    /* Both keys go through normQ, or the org's spelling and this app's own
       spelling land in disjoint buckets and every row shows wins or creations
       but never both. */
    const cq = normQ(s.FiscalQuarter__c) || qOf(s.ForecastCloseDate__c);
    if(cq){ const b = bucket(cq);
      if(sfrWon(s)){ b.won++; b.wonAmt += amt(s); }
      else if(sfrLost(s)) b.lost++;
    }
    const nq = normQ(qOf(s.CreatedDate));
    if(nq){ const b = bucket(nq); b.created++; b.createdAmt += amt(s); }
  });
  const qKeys = Object.keys(Q).sort();

  const wonTotal = won.reduce((t,s)=>t+amt(s),0);
  const fyTotal  = wonFY.reduce((t,s)=>t+amt(s),0);
  const openTot  = open.reduce((t,s)=>t+amt(s),0);
  const decided  = won.length + lost.length;
  const winRate  = decided ? Math.round(won.length/decided*100) : null;
  /* amt() returns 0 for records Salesforce excludes from the forecast, so
     dividing by won.length diluted the average with rows contributing nothing.
     Two $500K wins plus one excluded $400K win used to average $333K. */
  const wonCounted = won.filter(sfrCounts);
  const avgWon   = wonCounted.length ? wonTotal/wonCounted.length : 0;

  $('anKpis').innerHTML =
    kpi('g',fy+' closed won',money(fyTotal),wonFY.length+' SFRs booked')+
    kpi('','All-time closed won',money(wonTotal),won.length+' SFRs')+
    kpi('p','Open pipeline',money(openTot),open.length+' live SFRs')+
    kpi('t','Win rate',winRate==null?'—':winRate+'%',
        decided?won.length+' won of '+decided+' decided':'nothing decided yet')+
    kpi('o','Avg won deal',money(avgWon),
        wonCounted.length?'across '+wonCounted.length+' wins that count':'—');

  drawChart('chRev','bar',
    qKeys.map(q=>[q,Q[q].wonAmt]).filter(x=>x[1]>0),'Closed won by quarter');
  drawChart('chCreated','bar',
    qKeys.map(q=>[q,Q[q].createdAmt]).filter(x=>x[1]>0),'Pipeline created by quarter');

  $('anQtrBody').innerHTML = qKeys.length ? qKeys.map(q=>{
    const b = Q[q], dec = b.won+b.lost;
    return '<tr'+(q===CUR_Q?' style="background:var(--tint)"':'')+'>'+
      '<td><strong>'+esc(q)+'</strong>'+(q===CUR_Q?' <span class="tag active">current</span>':'')+'</td>'+
      '<td class="num">'+(b.won||'—')+'</td>'+
      '<td class="num"><strong>'+(b.wonAmt?money(b.wonAmt):'—')+'</strong></td>'+
      '<td class="num">'+(b.created||'—')+'</td>'+
      '<td class="num">'+(b.createdAmt?money(b.createdAmt):'—')+'</td>'+
      '<td class="num">'+(b.lost||'—')+'</td>'+
      '<td class="num">'+(dec?Math.round(b.won/dec*100)+'%':'—')+'</td></tr>';
  }).join('') : '<tr><td colspan="7" class="empty">No quarters with activity.</td></tr>';

  /* ---- AI fluency: sourced definition, and an honest gap ---- */
  $('anAi').innerHTML =
    '<div class="note warn"><strong>AI fluency: not available here.</strong> '+
    'The score lives in internal AI telemetry with no connector. The published '+
    'on-ramp is <strong>35+ AI interactions per week</strong> per seller; the FY27 '+
    'org target is <strong>&gt;90% of sellers clearing that bar</strong>. Two '+
    'different units &mdash; this note used to run them together.</div>'+
    '<details><summary>Where those figures come from</summary><div class="body">'+
    '<p>The 35+ weekly baseline reflects consistent engagement and is '+
    'explicitly an on-ramp, not a pass/fail threshold, and the FY27 org-wide '+
    'target is &gt;90%. Both come from internal enablement channels, and the '+
    'metric is contested internally.</p></div></details>';

  $('anEnbl').innerHTML =
    '<div class="note warn" style="margin:0"><strong>Enablement: not tracked in Org62.</strong> '+
    'Zero records exist for you, because your training lives in ACT, which has no '+
    'connector. Your morning brief finds it by searching Gmail and Slack instead.</div>';

  loadActivity();
}

/* Real activity, independent of whether anyone remembered to log it.
   Gmail is paged because the connector's resultCountEstimate is unreliable —
   it returned "20" for both a 1-row and a 50-row request. */
async function realActivity(days){
  const out = {sent:null, mtgs:null, custMtgs:0};
  try{
    const seen = new Set();
    let token = null, guard = 0;
    do{
      const args = {query:'in:sent newer_than:'+days+'d', pageSize:50,
                    view:'THREAD_VIEW_MINIMAL'};
      if(token) args.pageToken = token;
      const r = await call(GMAIL, args);
      ((r && r.threads) || []).forEach(t=>
        (t.messages||[]).forEach(m=>{
          /* Count messages HE sent, not whole threads. */
          if((m.labelIds||[]).indexOf('SENT') !== -1 &&
             addrOf(m.sender) === ME) seen.add(m.id);
        }));
      token = r && r.nextPageToken;
      /* Three pages, not eight. This paging exists to produce one integer — a
         per-week send rate — and 150 threads establishes that rate. Eight pages
         meant up to 400 full threads and eight serial round trips for it. When
         the window is truncated, out.partial says so rather than quietly
         under-reporting. */
      /* One page unless the window is long. This paging exists to produce a
         per-week send rate; 50 threads establishes that, and three pages meant
         three serial round trips for it. */
    } while(token && ++guard < (days > 90 ? 3 : 1));
    out.sent = seen.size;
    out.partial = !!token;
  }catch(e){ /* leave null — the tiles fall back to Salesforce counts */ }

  /* S.events only spans the calendar grid's window (-14 to +45 days). Counting
     a 90- or 365-day period against it silently returned a fraction of the real
     number. Fetch the period that was actually asked for, and cache it. */
  try{
    const fromD = new Date(); fromD.setDate(fromD.getDate() - days);
    const from = ymd(fromD);
    const nowD = todayStr();
    let pool = S.events || [];
    if(days > Math.abs(calLoaded.from)){
      /* Only the part not already in S.events, merged by id — this used to
         refetch the whole window including the 14 days already loaded. */
      if(!ACT_CAL[days]){
        const tail = await fetchEvents(-days, calLoaded.from);
        const byId = new Map((S.events||[]).map(e=>[e.id,e]));
        tail.forEach(e=>{ if(e && e.id) byId.set(e.id, e); });
        ACT_CAL[days] = [...byId.values()];
      }
      pool = ACT_CAL[days];
    }
    const held = pool.filter(ev=>{
      if(ev.status === 'cancelled' || isAllDay(ev)) return false;
      const d = evDayKey(ev);
      return d >= from && d <= nowD;              // past only, not scheduled
    });
    out.mtgs = held.length;
    out.custMtgs = held.filter(isCustomerMtg).length;
  }catch(e){ /* leave mtgs null so the tile falls back to the Salesforce count */ }
  return out;
}
/* Calendar pulls for the Analytics period selector, keyed by day count. */
const ACT_CAL = {};
/* And the whole activity result, keyed the same way. Analytics used to refire
   every one of these calls on every visit to the tab and every change of the
   period selector — up to 19 serial round trips at 365 days, none cached. */
const ACT_RESULT = {};

/* Activity comes from Task and Event, queried on demand for the chosen window. */
async function loadActivity(force){
  const days = +($('anPeriod') ? $('anPeriod').value : 30);
  /* Repainting the tab is free; refetching it is not. */
  if(!force && ACT_RESULT[days]){ paintActivity(days, ACT_RESULT[days]); return; }
  $('anActKpis').innerHTML = '<div class="card"><div class="empty">'+
    '<span class="spin"></span> Counting logged activity…</div></div>';
  try{
    /* realActivity is independent of the four SOQL counts, so it runs beside
       them rather than after them — it used to add its own 1-9 round trips to
       the end of the chain. */
    const [emails, tasks, events, byMonth, real] = await Promise.all([
      soql("SELECT COUNT(Id) n FROM Task WHERE OwnerId = '"+ME_ID+"' "+
           "AND TaskSubtype = 'Email' AND ActivityDate = LAST_N_DAYS:"+days),
      soql("SELECT COUNT(Id) n FROM Task WHERE OwnerId = '"+ME_ID+"' "+
           "AND TaskSubtype != 'Email' AND ActivityDate = LAST_N_DAYS:"+days),
      soql("SELECT COUNT(Id) n FROM Event WHERE OwnerId = '"+ME_ID+"' "+
           "AND ActivityDate = LAST_N_DAYS:"+days),
      /* ActivityDate is a plain Date and rejects CALENDAR_MONTH; CreatedDate is
         a DateTime and groups fine. Close enough for a trend line. */
      soql("SELECT CALENDAR_MONTH(CreatedDate) m, CALENDAR_YEAR(CreatedDate) y, "+
           "COUNT(Id) n FROM Task WHERE OwnerId = '"+ME_ID+"' "+
           "AND CreatedDate = LAST_N_DAYS:365 GROUP BY CALENDAR_YEAR(CreatedDate), "+
           "CALENDAR_MONTH(CreatedDate) ORDER BY CALENDAR_YEAR(CreatedDate), CALENDAR_MONTH(CreatedDate)"),
      realActivity(days),
    ]);
    const e = (emails[0]&&emails[0].n)||0, t = (tasks[0]&&tasks[0].n)||0,
          v = (events[0]&&events[0].n)||0;
    ACT_RESULT[days] = {e, t, v, byMonth, real};
    paintActivity(days, ACT_RESULT[days]);
  }catch(err){
    $('anActKpis').innerHTML = '<div class="note err">Activity read failed: '+
      esc(plainErr(err.message))+'</div>';
  }
}
/* Split out so a cached result repaints without refetching anything. */
function paintActivity(days, r){
  try{
    const e = r.e, t = r.t, v = r.v, byMonth = r.byMonth, real = r.real;
    const wks = Math.max(days/7, 1);
    $('anActKpis').innerHTML =
      kpi('','Emails sent',
          real.sent==null ? e : (real.sent + (real.partial?'+':'')),
          real.sent==null ? 'Salesforce-logged only'
            : (real.sent/wks).toFixed(1)+' per week from Gmail'+
              (real.partial?' · first '+real.sent+' threads only':''))+
      kpi('t','Meetings held',real.mtgs==null?v:real.mtgs,
          real.mtgs==null ? 'Salesforce-logged only'
            : real.custMtgs+' with customers · from Calendar')+
      /* Like for like. The old ratio added non-email tasks to the numerator with
         nothing matching them in the denominator, so it could pass 100% and the
         gap tile could read 0 on a book with no logging at all. Emails against
         emails, meetings against meetings, other tasks reported separately. */
      /* BOTH halves of the denominator have to exist. Testing only real.sent
         meant a failed calendar read gave (e+v)/(sent+null) — meetings logged
         over an emails-only denominator. */
      /* A truncated Gmail count makes both of these a floor, not a figure.
         The "Emails sent" tile said so; these two used it silently. */
      /* Clamped. The numerator is an uncapped SOQL COUNT and the denominator is
         a capped Gmail page count, so this could read "210% logged" beside a
         "Not in Salesforce" tile reading 0. Over 100% means the denominator was
         truncated, so say that instead of printing an impossible percentage. */
      kpi('o','Logged to Salesforce', e+v,
          (real.sent!=null && real.mtgs!=null && (real.sent+real.mtgs)>0)
            ? ((e+v) > (real.sent+real.mtgs)
                 ? 'at least 100% — more logged than Gmail and Calendar can see'+
                   (real.partial?', because the Gmail count is capped':'')
                 : Math.round((e+v)/(real.sent+real.mtgs)*100)+'% of emails and meetings'+
                   (real.partial?' (at most — Gmail count is capped)':''))
            : e+' emails · '+v+' meetings')+
      kpi('p','Not in Salesforce',
          (real.sent!=null && real.mtgs!=null)
            ? (Math.max(real.sent-e,0) + Math.max(real.mtgs-v,0)) +
              (real.partial?'+':'') : '—',
          t?'plus '+t+' other tasks logged':'emails and meetings with no record');
    $('anActMeta').textContent = real.sent==null
      ? 'Gmail unavailable — showing Salesforce-logged activity only.'
      : 'Gmail and Calendar are the real numbers; Salesforce shows only what got logged.';

    const MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    drawChart('chAct','bar',
      byMonth.map(x=>[MON[(x.m||1)-1]+' '+String(x.y||'').slice(2), x.n||0]),
      'Tasks logged per month · last 12 months');
  }catch(err){
    $('anActKpis').innerHTML = '<div class="note err">Could not draw activity: '+
      esc(plainErr(err.message))+'</div>';
  }
}

/* ═══════════════ HPF metric engine ═══════════════
   Every figure here is computed from a live read or explicitly marked as
   unavailable. Nothing is interpolated, and the two participation metrics are
   labelled proxies because the dashboard measures them differently — see the
   comments on each. */
let _hpf = null;
function hpfMetrics(){
  if(_hpf) return _hpf;
  const fy = CUR_FY_N();
  const q  = CUR_Q;                       // e.g. "FY27 Q3"
  const qn = +(String(q).match(/Q([1-4])/) || [0,0])[1] || 1;
  const won = S.won || [];
  const m = {fy, q, qn, seg: HPF_T(), self: hpfSelf(),
             fyLabel: 'FY'+String(fy),
             /* The closed-won read is a late job. Until it lands, an empty array
                and a real zero look identical, and this tab would show $0 won as
                though it were a fact. */
             wonReady: S.got.won === true || !!S.err.won};

  /* ---- the analytics row: the dashboard's own numbers ------------------
     When this is present it wins outright. The old locally-computed proxies for
     engaged ACV and PipeGen are gone: measured against the real figures they
     were not close. On live data the locally-computed ACV proxy disagreed with the dashboard
     outright, and the PipeGen proxy was off by more than 10x — different
     definitions, not rounding. A number that wrong is
     worse than a blank. */
  const R = S.hpfRow || null;
  m.row = R;
  m.rowReady = S.got.hpfRow === true || !!S.err.hpfRow;
  m.rowErr = S.err.hpfRow || null;
  const num = v => { const n2 = Number(v); return Number.isFinite(n2) ? n2 : null; };
  if(R){
    m.dsQuarter = R.FY_Q || null;
    m.dsSeg     = R.MACRO_SEGMENT || null;
    m.dsRole    = R.FORMATTED_SELLING_ROLE || null;
    m.dsMgr     = R.EMP_MGR_NM || null;
    m.dsL1      = R.L1_CLOUD || null;
    m.dsL2      = R.L2_CLOUD || null;
    m.dsGroup   = R.SELLER_GROUP || null;
    m.dsTenure  = R.TENURE_BAND || null;
    m.indicator = R.OUTPUT_KPI_PROGRESS_INDICATOR || null;
    m.insight   = R.OUTPUT_KPI_PROGRESS_INSIGHTS || null;
    m.projected = R.PROJ_OFF_TRACK || null;
    m.qap       = R.CQ_QAP_COMPLETION || null;
    /* Stored as a ratio, shown as a percentage. */
    m.dsAttain  = num(R.CQ_QUOTA_ATTAINMENT_YTD) == null ? null
                : num(R.CQ_QUOTA_ATTAINMENT_YTD) * 100;
    m.dsAcv     = num(R.CQ_ACV);
    m.dsAcvTgt  = num(R.CQ_ACV_THRESHOLD);
    m.dsAcvPart = R.CQ_ACV_PARTICIPATION || null;
    m.dsPg      = num(R.CQ_PG);
    m.dsPgTgt   = num(R.CQ_PG_THRESHOLD);
    m.dsPgPart  = R.CQ_PG_PARTICIPATION || null;
    m.dsAct     = num(R.CQ_AVG_ACTIVITIES);
    m.dsEnable  = num(R.CQ_ENABLEMENT_COMPLETION);
    m.dsEnAsg   = num(R.CQ_ENABLEMENT_ASSIGNED);
    m.dsEnDone  = num(R.CQ_ENABLEMENT_COMPLETED);
    m.dsCheckin = num(R.QTR_CHCKN_CMPLT_AE);
    m.dsOpen    = num(R.CQ_OP);
    m.dsCommit  = num(R.CQ_COMMIT_OP);
    /* Prior three quarters, newest first, for the trend row. */
    m.trend = [
      {lbl:'this qtr', att:m.dsAttain, acv:m.dsAcv, pg:m.dsPg,
       acvP:m.dsAcvPart, pgP:m.dsPgPart},
      {lbl:'−1 qtr', att:num(R.PQ_1_QUOTA_ATTAINMENT_YTD)==null?null:num(R.PQ_1_QUOTA_ATTAINMENT_YTD)*100,
       acv:num(R.PQ_1_ACV), pg:num(R.PQ_1_PG),
       acvP:R.PQ_1_ACV_PARTICIPATION, pgP:R.PQ_1_PG_PARTICIPATION},
      {lbl:'−2 qtrs', att:num(R.PQ_2_QUOTA_ATTAINMENT_YTD)==null?null:num(R.PQ_2_QUOTA_ATTAINMENT_YTD)*100,
       acv:num(R.PQ_2_ACV), pg:null, acvP:R.PQ_2_ACV_PARTICIPATION, pgP:null},
      {lbl:'−3 qtrs', att:num(R.PQ_3_QUOTA_ATTAINMENT_YTD)==null?null:num(R.PQ_3_QUOTA_ATTAINMENT_YTD)*100,
       acv:num(R.PQ_3_ACV), pg:null, acvP:R.PQ_3_ACV_PARTICIPATION, pgP:null},
    ];
  }

  /* ---- attainment ------------------------------------------------------
     Closed Won specialist ACV in the fiscal year to date, over the fiscal
     year's quota pro-rated to the quarters elapsed. Salesforce has a
     SpecialistForecastQuota__c object with monthly rows, which would give a
     real seasonality curve — but it is empty org-wide, so the denominator
     comes from the quota he enters on My SFRs. Flat quarter weighting, and the
     copy says so rather than calling it seasonality-adjusted. */
  m.wonAcv   = won.reduce((t,o)=>t + specAmt(o), 0);
  m.wonCount = won.length;
  m.quota    = getQuota();
  m.quotaYtd = m.quota ? m.quota * (qn / 4) : 0;
  m.attain   = (m.wonReady && m.quotaYtd > 0) ? (m.wonAcv / m.quotaYtd) * 100 : null;

  /* ---- engaged ACV participation --------------------------------------
     The dashboard credits Closed Won ACV in his territory where he logged an
     activity within two years of the close. LastActivityDate on the
     opportunity is the closest thing this app can see: it is the last activity
     by ANYONE, not specifically by him, and it has no two-year window. So this
     is a proxy that will read high, and the row says so. */
  m.engagedAcv = won.filter(o=>o.LastActivityDate)
                    .reduce((t,o)=>t + specAmt(o), 0);
  m.engagedN   = won.filter(o=>o.LastActivityDate).length;
  m.acvTarget  = qn === 4 ? m.seg.acvQ4 : m.seg.acv;

  /* ---- engaged pipegen participation ----------------------------------
     The dashboard measures ACV on opportunities that flipped past Stage 2 with
     his activity logged in the three months before the flip. Stage-flip dates
     live in OpportunityFieldHistory, which this app does not read. The proxy is
     open specialist pipeline currently at Stage 3 or later — a different
     measure of the same idea, and labelled as such. */
  const past2 = scoped().filter(isLive)
    .filter(o=>stageNum(o.StageName) >= 3);
  m.pipegen  = past2.reduce((t,o)=>t + specAmt(o), 0);
  m.pipegenN = past2.length;

  /* ---- timely SFR updates ---------------------------------------------
     The playbook scopes this to records with Management Forecast Judgement =
     IN and above $100K in a quarter. Weekly maintenance, so the test is
     LastModifiedDate inside 7 days. This one is exact. */
  const sfrScope = (S.sfrs || []).filter(sfrOpen)
    .filter(s2=>/^IN/i.test(String(s2.Management_Forecast_Judgement__c || ''))
                && amt(s2) > 100000);
  const sfrFresh = sfrScope.filter(s2=>{
    const d = daysAgo(s2.LastModifiedDate); return d != null && d <= 7; });
  m.sfrScope = sfrScope.length;
  m.sfrFresh = sfrFresh.length;
  m.sfrStale = sfrScope.filter(s2=>sfrFresh.indexOf(s2) < 0);
  m.sfrPct   = sfrScope.length ? (sfrFresh.length / sfrScope.length) * 100 : null;

  /* ---- timely Org62 activity updates ----------------------------------
     Weekly logging on deals above $25K. LastActivityDate again reflects
     anyone's activity, so like engaged ACV this reads generously. */
  const actScope = scoped().filter(isLive).filter(o=>specAmt(o) > 25000);
  const actFresh = actScope.filter(o=>{
    const d = daysAgo(o.LastActivityDate); return d != null && d <= 7; });
  m.actScope = actScope.length;
  m.actFresh = actFresh.length;
  m.actStale = actScope.filter(o=>actFresh.indexOf(o) < 0);
  m.actPct   = actScope.length ? (actFresh.length / actScope.length) * 100 : null;

  /* ---- customer conversations per week --------------------------------
     Completed Tasks over a 12-week window, which on this org is entirely
     logged email, plus customer meetings actually on the calendar. Both are
     real counts; neither is the dashboard's eligible-activity definition. */
  m.convTasks = S.taskCount != null ? S.taskCount : null;
  m.convMtgs  = (S.events || []).filter(e=>
      e.status !== 'cancelled' && isCustomerMtg(e) && !isAllDay(e) &&
      (()=>{ const d = daysAgo(evStart(e)); return d != null && d >= 0 && d <= 84; })()
    ).length;
  m.convWk = m.convTasks == null ? null : (m.convTasks + m.convMtgs) / 12;

  /* ---- account team collaboration meetings per month -------------------
     Internal meetings on the calendar with one of the four core AEs on the
     invite. Counted over the last 8 weeks and expressed per month. */
  const coreFirst = CORE_AES.map(a=>String(a).split(' ')[0].toLowerCase());
  m.collab = (S.events || []).filter(e=>{
    if(e.status === 'cancelled' || isAllDay(e)) return false;
    const d = daysAgo(evStart(e));
    if(d == null || d < 0 || d > 56) return false;
    const hay = (evAttendees(e).join(' ') + ' ' + (e.summary || '')).toLowerCase();
    return coreFirst.some(n=>hay.indexOf(n) >= 0);
  }).length;
  m.collabMo = m.collab / 2;               // 8 weeks ≈ 2 months

  return (_hpf = m);
}
/* Status for a number against a target: on track, within 20% below, or worse.
   Returns null when there is no target or no number, so the row can say so
   instead of showing a colour it has not earned. */
function hpfStat(actual, target, higherIsBetter){
  if(actual == null || target == null || !isFinite(actual)) return null;
  const r = target === 0 ? 1 : actual / target;
  if(higherIsBetter === false) return r <= 1 ? 'g' : r <= 1.2 ? 'o' : 'r';
  return r >= 1 ? 'g' : r >= 0.8 ? 'o' : 'r';
}
const HPF_DOT = {g:'🟢', o:'🟡', r:'🔴'};
const hpfDot = st => st ? HPF_DOT[st] : '<span class="tag grey">no target</span>';

/* ═══════════════ HPF scorecard ═══════════════ */
/* One row of a pillar table. `note` is where a proxy admits what it is. */
function hpfRow(label, actual, target, st, note){
  return '<tr>'+
    '<td><strong>'+esc(label)+'</strong>'+
      (note?'<div class="meta" style="margin-top:3px">'+note+'</div>':'')+'</td>'+
    '<td class="num">'+actual+'</td>'+
    '<td style="font-size:11.5px;color:var(--ink-3)">'+esc(target)+'</td>'+
    '<td>'+hpfDot(st)+'</td></tr>';
}
const HPF_HEAD = '<div class="tw"><table><thead><tr>'+
  '<th scope="col">Metric</th><th scope="col" class="num">Actual</th>'+
  '<th scope="col">Target</th><th scope="col">Status</th>'+
  '</tr></thead><tbody>';
const HPF_FOOT = '</tbody></table></div>';

function renderHpf(){
  if(!$('hpfBiz')) return;
  const m = hpfMetrics();
  const T = m.seg;
  const pct = v => v == null ? '—' : Math.round(v)+'%';
  const na  = why => '<span class="tag grey" title="'+esc(why)+'">not available</span>';

  /* ---- note: scope, segment, freshness, and what is NOT here ---- */
  $('hpfNote').innerHTML = truncNote() + dropNote() +
    (S.err.won ? '<div class="note err">The closed-won read failed ('+
       esc(plainErr(S.err.won))+'), so attainment and engaged ACV are missing '+
       'from this scorecard. Hit Reload in the header.</div>' : '')+
    '<div class="note"><strong>You, '+esc(m.q)+', '+esc(T.label)+' targets.</strong> '+
      'Computed from the same Org62, Gmail and Calendar reads as the rest of this '+
      'app, at '+esc(new Date().toLocaleString('en-US',
        {month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}))+'.</div>'+
    (m.rowErr
      ? '<div class="note err"><strong>The HPF dataset did not answer:</strong> '+
        esc(plainErr(m.rowErr))+'. The rows below fall back to what this app can '+
        'compute itself, which is not the same measure &mdash; treat them as '+
        'indicative only and check the dashboard.</div>'
      : m.row
      ? '<div class="note"><strong>These are the dashboard\u2019s own numbers.</strong> '+
        'Read from <span class="mono">the specialist KPI dataset</span> in '+
        'Org62 CRM Analytics &mdash; the dataset the AE &amp; FLM Performance '+
        'Dashboard is built on. Segment '+esc(m.dsSeg || '?')+', role '+
        esc(m.dsRole || '?')+', L1 cloud '+esc(m.dsL1 || '?')+
        (m.dsL2 ? ', L2 cloud '+esc(m.dsL2) : '')+', manager '+esc(m.dsMgr || '?')+
        ', quarter '+esc(m.dsQuarter || '?')+'.</div>'
      : '<div class="note"><span class="spin"></span> Reading the HPF dataset\u2026</div>');

  /* ---- headline tiles ----
     Dataset first; the locally computed figures only stand in when the read
     failed, and say so. */
  const useDs  = !!m.row;
  const attVal = useDs ? m.dsAttain : m.attain;
  const attStat = hpfStat(attVal, 100);
  const partDot = v => v === 'Y' ? 'g' : v === 'N' ? 'r' : '';
  $('hpfKpis').innerHTML =
    kpi(attStat || '', 'YTD attainment',
        attVal == null ? (m.rowReady ? '—' : '…') : pct(attVal),
        useDs ? 'the dashboard figure, against 100%'
              : m.quota ? money(m.wonAcv)+' won of '+money(m.quotaYtd)+' — my own estimate'
                        : 'enter your quota on My SFRs')+
    kpi(useDs ? partDot(m.dsAcvPart) : 't', 'Engaged ACV',
        useDs ? money(m.dsAcv) : (m.wonReady ? money(m.engagedAcv) : '…'),
        useDs ? 'of '+money(m.dsAcvTgt)+' — participating: '+esc(m.dsAcvPart || '?')
              : 'my own estimate, not the dashboard')+
    kpi(useDs ? partDot(m.dsPgPart) : 't', 'Engaged PipeGen',
        useDs ? money(m.dsPg) : '—',
        useDs ? 'of '+money(m.dsPgTgt)+' — participating: '+esc(m.dsPgPart || '?')
              : 'only the dashboard measures this')+
    kpi(useDs ? (hpfStat(m.dsAct, HPF_CONV_WK) || '') : '', 'Avg activities',
        useDs ? (m.dsAct == null ? '—' : String(m.dsAct))
              : (m.convWk == null ? '—' : m.convWk.toFixed(1)),
        useDs ? 'the dashboard\u2019s activity measure' : 'my own 12-week average')+
    kpi(hpfStat(m.sfrPct, 100)==='g'?'g':'r',
        'SFRs kept current', m.sfrPct == null ? 'n/a' : pct(m.sfrPct),
        m.sfrScope ? m.sfrFresh+' of '+m.sfrScope+' touched this week — computed here'
                   : 'no SFR is in scope for this metric');

  /* ---- summary ---- */
  /* Built from the dataset when it is there. This block used to read from the
     deleted proxies, which meant the summary could say "engaged ACV clears the
     bar" directly above a table showing $0 and not-participating. */
  const flags = [], wins = [];
  if(attStat === 'r') flags.push('YTD attainment is more than 20% below plan');
  else if(attStat === 'g') wins.push('attainment is at or above plan');

  if(useDs){
    if(m.dsAcvPart === 'Y') wins.push('you are participating on engaged ACV');
    else flags.push('engaged ACV is '+moneyFull(m.dsAcv)+' against a '+
      moneyFull(m.dsAcvTgt)+' bar — not participating');
    if(m.dsPgPart === 'Y') wins.push('you are participating on engaged PipeGen');
    else flags.push('engaged PipeGen is '+moneyFull(m.dsPg)+' against '+
      moneyFull(m.dsPgTgt)+' — not participating');
    if(/complete/i.test(m.qap || '')) wins.push('QAP is complete');
    else flags.push('QAP is not marked complete');
    if(m.dsCheckin) wins.push('the quarterly check-in is done');
    else flags.push('the quarterly check-in with '+(m.dsMgr || 'your FLM')+
      ' is not recorded');
    if(m.dsAct != null && m.dsAct >= HPF_CONV_WK)
      wins.push('activity volume is above the bar');
  }
  /* Computed locally either way — the dataset does not carry these. */
  if(m.sfrPct != null && m.sfrPct < 100 && m.sfrScope)
    flags.push((m.sfrScope - m.sfrFresh)+' committed SFR'+
      ((m.sfrScope-m.sfrFresh)===1?'':'s')+' not touched in a week');
  else if(m.sfrPct === 100 && m.sfrScope)
    wins.push('every committed SFR was touched this week');
  if(m.actPct != null && m.actPct < 80)
    flags.push('activity logging on deals over $25K is at '+pct(m.actPct));

  /* The org's own verdict when we have it, rather than one this app invented. */
  const indDot = !m.indicator ? '' : /^a\./.test(m.indicator) ? 'g'
    : /^b\./.test(m.indicator) ? 'g' : /^c\./.test(m.indicator) ? 'o' : 'r';
  const overall = m.indicator ? indDot
    : (flags.length === 0 ? 'g' : flags.length <= 2 ? 'o' : 'r');
  $('hpfSummary').innerHTML = '<div class="card">'+
    '<h3>'+(HPF_DOT[overall] || '')+' '+
      esc(m.indicator || (overall==='g'?'On track'
        : overall==='o'?'Watch two things':'Off track on several'))+'</h3>'+
    (m.insight
      ? '<div class="note" style="margin:8px 0 0"><strong>The dashboard\u2019s '+
        'read:</strong> '+esc(m.insight)+
        (m.projected ? ' &middot; '+esc(m.projected) : '')+'</div>'
      : '')+
    '<div class="meta" style="margin-top:9px;line-height:1.7">'+
      (m.indicator ? '<strong>Official KPI progress indicator, from the HPF '+
        'dataset.</strong> ' : '')+
      (wins.length?'<strong>Holding up:</strong> '+esc(wins.slice(0,4).join('; '))+'. ':'')+
