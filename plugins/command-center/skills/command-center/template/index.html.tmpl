/* host lets the Write tab render into its own panel; the Stakeholders tab keeps
   using #draftPanel. Same generation either way. */
/* Every number a source document flagged DO-NOT-USE, per account, as strings.
   The POV tab already refuses to display these; nothing stopped the model from
   reproducing one into a draft, and a draft is one click from a Gmail draft
   addressed to the customer. */
const FIG_RE = /\$[\d,.]+\s*(?:[KMB]\b)?|\b\d[\d,.]*\s*%/g;
const figsIn = m => (String((m && m.m) || '').match(FIG_RE) || [])
  .map(t=>t.trim()).filter(t=>t.length > 2);
function bannedFigures(slug){
  const a = PDget()[slug];
  /* Array.isArray and a null guard on each row: one malformed metric used to
     throw here, and both callers catch that by replacing the whole generated
     draft with an error. A data problem should not eat the output. */
  /* Throw, do not return []. A POV_DATA parse failure used to leave _pd as an
     empty object, so this reported "no banned figures" — an open failure sitting
     upstream of a guard that is supposed to fail closed. povGuard catches this
     and shows its warning. */
  if(_pdErr) throw new Error('POV data did not parse: '+_pdErr);
  if(!a || !Array.isArray(a.metrics)) return [];
  const rows = a.metrics.filter(m=>m && typeof m === 'object');
  const out = new Set();
  rows.filter(m=>m.v && m.v !== 'verified').forEach(m=>figsIn(m).forEach(t=>out.add(t)));
  /* A figure that ALSO appears in a verified metric is usable — the same number
     showing up in both places means it was confirmed somewhere. */
  rows.filter(m=>m.v === 'verified').forEach(m=>figsIn(m).forEach(t=>out.delete(t)));
  return [...out];
}
/* Whole-token match. indexOf meant a banned "10%" fired on a clean "110%" and
   a banned "$1,000" fired inside "$1,000,000" — a guard that cries wolf gets
   ignored, which is worse than not having it. */
function hasFigure(body, tok){
  const esc = tok.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  /* Reject only what could genuinely EXTEND the number: another digit, or a
     period/comma that is itself followed by a digit, or a trailing % on a token
     that does not already end in one. The old lookahead rejected any trailing
     period or comma, which killed the two commonest shapes a figure takes in
     prose — "…reached $1,000." and "10%, up from…". */
  /* A magnitude letter extends a number as surely as a digit does: a banned
     bare "$1.2" must not fire on "$1.2M". Only blocked when the token does not
     already carry one. */
  const mag  = /[KMB]$/.test(tok) ? '' : '|\\s*[KMB]\\b';
  const tail = /%$/.test(tok) ? '(?!\\d|[.,]\\d'+mag+')'
                              : '(?!\\d|[.,]\\d|%'+mag+')';
  return new RegExp('(?<![\\d.,$])' + esc + tail).test(String(body));
}
/* Prepends a warning naming every unusable figure that came back in the text.
   It does not silently edit the draft — he needs to see what to take out. */
function povGuard(slug, body){
  let hits = [];
  try{ hits = bannedFigures(slug).filter(t=>hasFigure(body, t)); }
  catch(e){
    /* Fails CLOSED. Returning '' on a crash silently removed the one warning
       standing between a flagged figure and a customer-addressed draft. */
    console.error('[povGuard] '+e.message);
    return '<div class="note warn" style="margin:0 0 9px"><strong>The '+
      'unusable-figure check could not run on this account.</strong> Verify '+
      'every number in this draft against Org62 before you use it.</div>';
  }
  if(!hits.length) return '';
  return '<div class="note err" style="margin:0 0 9px"><strong>Do not send as '+
    'written.</strong> This draft reproduces '+hits.length+' figure'+
    (hits.length===1?'':'s')+' your own source documents flagged as unusable: '+
    '<span class="mono">'+hits.map(esc).join('</span>, <span class="mono">')+
    '</span>. Take '+(hits.length===1?'it':'them')+' out or verify against '+
    'Org62 first.</div>';
}
async function draft(slug, idx, mode, host){
  const c = (S.contacts[slug]||[])[idx]; if(!c) return;
  const HOST = host || 'draftPanel';
  const M = MODES[mode] || MODES.disc;
  const f = famRoll().find(x=>x.slug===slug);
  const seg = segOf(f);
  const opps = f.opps.filter(realOpp).sort((a,b)=>specAmt(b)-specAmt(a)).slice(0,4);
  const d = daysAgo(c.LastActivityDate);
  /* Through the stamp: stakeholderDetail and draft both called these directly,
     and meddicOf re-runs roleOf internally. */
  const {lvl, fn} = c._role || (c._role = roleOf(c));
  const md = c._md || (c._md = meddicOf(c));
  const sfrs = (S.sfrs||[]).filter(s=>famOf(s.Account_Name__c).slug===slug && sfrOpen(s)).slice(0,4);

  $(HOST).style.display='block';
  $(HOST).innerHTML = '<h3>'+esc(M.name)+' &mdash; '+esc(c.Name)+'</h3>'+
    '<div class="empty"><span class="spin"></span> Drafting…</div>';
  $(HOST).scrollIntoView({behavior:'smooth',block:'nearest'});

  const ctx = UNTRUSTED_NOTE +
`RECIPIENT
Name: ${fence('NAME', c.Name)}
Title: ${c.Title ? fence('TITLE', c.Title) : 'unknown'}
Seniority: ${lvl.label}   Function: ${fn.label}
Inferred MEDDICC role: ${md.label} — ${md.hint}
Last recorded activity: ${d==null ? 'never — treat as cold outreach' : d+' days ago'}
Account: ${fence('ACCOUNT', (c.Account&&c.Account.Name) || f.disp)}
Account family: ${f.disp}

${seg.ctx}

OPEN OPPORTUNITIES ON THIS FAMILY (do not quote amounts to the customer)
${opps.length ? opps.map(o=>'- '+fence('OPP', o.Name)+' — stage '+(o.StageName||'')).join('\n') : '- none open'}

MY OPEN SPECIALIST FORECAST RECORDS ON THIS FAMILY (internal only, never mention)
${sfrs.length ? sfrs.map(s=>'- '+fence('SFR', (s.Opportunity__r&&s.Opportunity__r.Name)||s.Name)+' — '+fence('STAGE', s.ForecastStage__c)).join('\n') : '- none'}

CALIBRATE TO SENIORITY: ${lvl.rank<=2
  ? 'This is an executive. Business outcome and consequence only. No mechanics, no product names beyond one. Shortest possible.'
  : lvl.rank<=4
  ? 'This is a director or VP. They own a number and a team. Outcome first, then just enough mechanism to be credible.'
  : 'This is a practitioner or manager. Be concrete and useful about how the work actually changes. Respect their expertise.'}

TASK
${M.brief}

Output only the message. If it is an email, put "Subject: ..." on the first line.
Every unverifiable specific must be written as [CONFIRM].`;

  try{
    const out = await window.cowork.askClaude(METHOD + '\n\n' + ctx, []);
    let body = typeof out === 'string' ? out : (out && (out.text||out.content)) || String(out);
    let subj = '';
    const sm = /^\s*Subject:\s*(.+)$/im.exec(body);
    if(sm){ subj = sm[1].trim(); body = body.replace(sm[0], '').replace(/^\s+/, ''); }

    $(HOST).innerHTML =
      '<h3>'+esc(M.name)+' &mdash; '+esc(c.Name)+' <span class="tag active">'+esc(f.disp)+'</span></h3>'+
      '<div class="meta" style="margin-bottom:9px">'+esc(c.Title||'title unknown')+
        ' &middot; '+esc(lvl.label)+' &middot; '+esc(md.label)+
        (c.Email?' &middot; <span class="mono">'+esc(c.Email)+'</span>':' &middot; no email on record')+
        ' &middot; last touch '+(d==null?'never recorded':d+' days ago')+'</div>'+
      '<div class="row" style="margin-bottom:9px;flex-wrap:wrap">'+
        '<span class="chip">'+esc(M.chip)+'</span>'+
        '<span class="chip">'+esc(seg.label)+'</span>'+
        
      '</div>'+
      (M.chan==='gmail'
        ? '<label class="meta" for="draftSubj" style="display:block;margin-bottom:4px">Subject</label>'+
          '<input id="draftSubj" style="width:100%;margin-bottom:9px" value="'+esc(subj)+'">'
        : '<div class="note" style="margin-bottom:9px">LinkedIn has no API here &mdash; copy this into '+
          'the InMail box yourself.</div>')+
      povGuard(slug, body)+
      '<textarea id="draftTxt" rows="16">'+esc(body)+'</textarea>'+
      '<div class="row" style="margin-top:9px;flex-wrap:wrap">'+
        '<button class="btn" id="copyDraft">Copy</button>'+
        (M.chan==='gmail' && c.Email
          ? '<button class="btn ghost" id="gmailDraft">Save to Gmail drafts</button>' : '')+
        '<button class="btn ghost" id="redo">Regenerate</button>'+
        '<button class="btn ghost" id="closeDraft">Close</button>'+
        '<span class="sp"></span>'+
        '<span class="meta">Nothing sends. Replace every [CONFIRM] before you use it.</span>'+
      '</div><div id="draftMsg"></div>';

    $('copyDraft').onclick = ()=>copyOut('draftTxt','copyDraft');
    $('redo').onclick = ()=>draft(slug, idx, mode, host);
    $('closeDraft').onclick = ()=>{ $(HOST).style.display='none';
                                     $(HOST).innerHTML=''; };
    if($('gmailDraft')) $('gmailDraft').onclick = async()=>{
