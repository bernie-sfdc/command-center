/* ---- Quota -------------------------------------------------------------
   Your target is not in Org62 anywhere I can reach, so it is entered once and
   kept locally. Everything else here is computed from live SFRs. */
const LS_QUOTA = 'ae-cc:v2:quota';
function getQuota(){
  try{ return Number(localStorage.getItem(LS_QUOTA)) || 0; }catch(e){ return 0; }
}
function renderQuota(all){
  const box = $('quotaStrip'); if(!box) return;
  const fy = CUR_Q.split(' ')[0];
  const q  = getQuota();
  const won = all.filter(s=>sfrWon(s) && inCurFY(s)).reduce((t,s)=>t+amt(s),0);
  /* Coverage used to be (openQ + commit) / gap, which put every current-quarter
     Commit record in BOTH terms — so the ratio was overstated by the size of the
     commit book, and got worse the better the quarter looked. One union, counted
     once. */
  const covRows = all.filter(s=>sfrOpen(s) &&
    (normQ(s.FiscalQuarter__c)===CUR_Q || s.ForecastStatus__c==='Commit'));
  const covBase = covRows.reduce((t,s)=>t+amt(s),0);
  if(!q){
    box.innerHTML = '<div class="note"><strong>Set your '+fy+' target</strong> to see attainment, '+
      'gap and coverage. Stored on this device only. '+
      '<input id="quotaIn" type="number" placeholder="e.g. 1500000" '+
      'style="width:150px;margin-left:6px" aria-label="'+fy+' quota target"> '+
      '<button class="btn sm" id="quotaSet">Save</button>'+
      '<div class="meta" id="quotaMsg" style="margin-top:6px"></div></div>';
  } else {
    const pct   = Math.round(won/q*100);
    const gap   = Math.max(q-won, 0);
    const cover = gap ? covBase/gap : null;
    box.innerHTML = '<div class="card" style="margin-bottom:16px">'+
      '<div class="row" style="flex-wrap:wrap;gap:26px">'+
        /* Labelled for what it actually measures. The SFR query is
           ForecastType__c = 'Marketing Cloud', so this is the L1 line only —
           Data 360, Agentforce and Signature Success are not in it, and calling
           it "FY27 attainment" implied they were. */
        '<div><div class="kpi-lbl">'+fy+' Marketing Cloud attainment</div>'+
          '<div style="font-size:30px;font-weight:600;letter-spacing:-.04em;line-height:1">'+
          pct+'%</div><div class="meta">'+money(won)+' of '+money(q)+
          ' &middot; L1 only</div></div>'+
        /* The most important number in the app was orange on white at 2.2:1 —
           below even the large-text floor — and orange was its NORMAL state.
           The figure is now ink; the state is carried by a tag beside it. */
        '<div><div class="kpi-lbl">Gap to target</div>'+
          '<div style="font-size:30px;font-weight:600;letter-spacing:-.04em;line-height:1;'+
          'color:'+(gap?'var(--ink)':'var(--sf-green)')+'">'+
          (gap?money(gap):'Cleared')+'</div>'+
          '<div class="meta">'+(gap
            ? 'still to close <span class="tag warm">open</span>'
            : 'target met <span class="tag g">done</span>')+'</div></div>'+
        /* The gap is the remaining FISCAL YEAR; the base is this quarter plus
           commit. Different horizons, so it is not a like-for-like ratio and
           the label now says so instead of implying one. */
        '<div><div class="kpi-lbl">This quarter vs the year gap</div>'+
          '<div style="font-size:30px;font-weight:600;letter-spacing:-.04em;line-height:1">'+
          (cover==null?'—':cover.toFixed(1)+'×')+'</div>'+
          '<div class="meta">'+money(covBase)+' open in '+CUR_Q+' plus commit from '+
          'any quarter, against the whole remaining year</div></div>'+
        '<span class="sp"></span>'+
        '<button class="btn sm ghost" id="quotaEdit">Change target</button>'+
      '</div>'+
      '<div class="bar" style="margin-top:14px"><i style="width:'+Math.min(pct,100)+'%"></i></div>'+
      '</div>';
  }
  const save = v=>{ try{ localStorage.setItem(LS_QUOTA, String(v)); }catch(e){} renderQuota(all); };
  /* The only manual input in the app used to fail silently on an empty or
     non-numeric value — click Save, nothing happens, nothing said. And the edit
     path used prompt(), which some embedded contexts block outright. */
  if($('quotaSet')) $('quotaSet').onclick = ()=>{
    const raw = $('quotaIn').value.trim();
    const v = Number(raw.replace(/[$,\s]/g,''));
    if(!raw){ $('quotaMsg').textContent = 'Enter your target first.'; return; }
    if(!Number.isFinite(v) || v <= 0){
      $('quotaMsg').textContent = 'That does not read as a number. Try 1500000.';
      return; }
    save(v);
  };
  if($('quotaEdit')) $('quotaEdit').onclick = ()=>{
    box.innerHTML = '<div class="note"><strong>Change your '+fy+' target</strong> '+
      '<input id="quotaIn" type="number" value="'+(q||'')+'" '+
      'style="width:150px;margin-left:6px" aria-label="'+fy+' quota target"> '+
      '<button class="btn sm" id="quotaSet">Save</button> '+
      '<button class="btn sm ghost" id="quotaCancel">Cancel</button> '+
      '<button class="btn sm ghost" id="quotaClear">Remove target</button>'+
      '<div class="meta" id="quotaMsg" style="margin-top:6px">Stored on this '+
      'device only. It is not in Salesforce anywhere this app can read.</div></div>';
    $('quotaSet').onclick = ()=>{
      const v = Number(String($('quotaIn').value).replace(/[$,\s]/g,''));
      if(!Number.isFinite(v) || v <= 0){
        $('quotaMsg').textContent = 'That does not read as a number. Try 1500000.';
        return; }
      save(v);
    };
    $('quotaCancel').onclick = ()=>renderQuota(all);
    $('quotaClear').onclick = ()=>{
      try{ localStorage.removeItem(LS_QUOTA); }catch(e){}
      renderQuota(all);
    };
  };
}

/* KPI tile → the SFRs behind it, each linked to its record and its opportunity. */
let SFR_DRILL = null;
function sfrDrill(k, refresh){
