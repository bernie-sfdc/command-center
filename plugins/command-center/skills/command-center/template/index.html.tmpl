  {key:'d360',label:'Data 360',        bucket:'L2', field:'Data_Cloud_Amount__c',
   re:/data ?cloud|data ?360|unified profile|data bundle|marketing data/i},
  {key:'af',  label:'Agentforce',      bucket:'L2', field:'Agentforce_Amount__c',
