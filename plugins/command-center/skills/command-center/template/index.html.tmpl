<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<!-- Internal tool. noindex per the workspace posture for private tooling, and
     no-referrer so this page's URL never leaks to Google, LinkedIn or a meeting
     host.

     What the CSP below actually does, stated precisely because an earlier
     version of this comment overstated it:
       - connect-src 'none' blocks fetch, XHR, WebSocket and sendBeacon. It does
         NOT block top-level navigation or window.open, and this page uses
         window.open deliberately. So it is a partial control, not a seal.
       - script-src is pinned to ONE file path, not the whole of jsdelivr. An
         open CDN allowlist would have permitted an injected script tag pointing
         at arbitrary npm or GitHub content.
       - 'unsafe-inline' is unavoidable in a single-file artifact: all of this
         app's own script is inline. It does mean an injected inline handler
         would execute, which is why esc() coverage is the real control here and
         the CSP is defence in depth. -->
<meta name="robots" content="noindex,nofollow">
<meta name="referrer" content="no-referrer">
<meta http-equiv="Content-Security-Policy" content="default-src 'none';
  script-src 'unsafe-inline' https://cdn.jsdelivr.net/npm/chart.js@4.5.0/dist/chart.umd.js;
  style-src 'unsafe-inline'; img-src data:; font-src data:; connect-src 'none';
  base-uri 'none'; form-action 'none'">
<title>Marketing Specialist Command Center</title>
<style>
/* ═══════════════════════════════════════════════════════════════════
   Marketing Specialist Command Center — design layer
   Salesforce colour discipline, Apple restraint: one accent, hairline
   dividers instead of boxes, soft layered depth, generous whitespace,
   and type that does the hierarchy work so colour doesn't have to.
   Every class name here is load-bearing for the app logic — renaming
   one silently breaks a render.
   ═══════════════════════════════════════════════════════════════════ */
:root{
  color-scheme: light dark;

  /* Salesforce palette — accent stays singular and earned */
  --sf-blue:#0176D3; --sf-blue-dk:#032D60; --sf-blue-lt:#EAF5FE; --sf-navy:#001639;
  --sf-cloud:#0B5CAB; --sf-teal:#06A59A; --sf-orange:#FE9339; --sf-red:#EA001E;
  --sf-green:#2E844A; --sf-purple:#9050E9; --sf-pink:#FF538A;

  /* Neutrals, very slightly warm so white doesn't read clinical */
  --ink:#1A1A1C; --ink-1:#1A1A1C; --ink-2:#4A4B4F; --ink-3:#6B6C71;
  --line:rgba(0,22,57,.07); --line-2:rgba(0,22,57,.14);
  --bg:#F5F5F7;            /* the Apple grey that lets cards float */
  --card:#FFFFFF;
  --card-2:#FAFAFC;
  --tint:rgba(1,118,211,.06);

  /* Depth: two stacked shadows read as light, one reads as a border */
  --shadow:0 1px 2px rgba(0,22,57,.05), 0 4px 12px rgba(0,22,57,.045);
  --shadow-lg:0 2px 6px rgba(0,22,57,.07), 0 16px 40px rgba(0,22,57,.10);
  --shadow-in:inset 0 0 0 1px rgba(0,22,57,.05);

  --r:16px; --r-sm:11px; --r-xs:8px; --r-pill:980px;
  --ease:cubic-bezier(.32,.72,0,1);   /* Apple's spring-ish easing */
  --dur:.24s;
}
@media (prefers-color-scheme: dark){
  :root{
    --ink:#F2F2F5; --ink-1:#F2F2F5; --ink-2:#B4B5BC; --ink-3:#8A8B93;
    --line:rgba(255,255,255,.09); --line-2:rgba(255,255,255,.16);
    --bg:#0B0B0F; --card:#17181D; --card-2:#1D1E24;
    --sf-blue:#3AA0EA; --sf-blue-lt:rgba(58,160,234,.13); --sf-blue-dk:#B6DDF8;
    --tint:rgba(58,160,234,.10);
    --shadow:0 1px 2px rgba(0,0,0,.5), 0 4px 14px rgba(0,0,0,.36);
    --shadow-lg:0 2px 8px rgba(0,0,0,.55), 0 18px 44px rgba(0,0,0,.48);
    --shadow-in:inset 0 0 0 1px rgba(255,255,255,.05);
  }
}
@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}
}

*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%}
body{
  font-family:"SF Pro Text","SF Pro Display",-apple-system,BlinkMacSystemFont,
    'Salesforce Sans',"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  background:var(--bg);color:var(--ink);line-height:1.47;font-size:14px;
  letter-spacing:-.01em;
  -webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;
  font-variant-numeric:tabular-nums;
}
::selection{background:var(--sf-blue);color:#fff}
:focus-visible{outline:2.5px solid var(--sf-blue);outline-offset:2px;border-radius:4px}

/* ───────────── header ───────────── */
.top{
  background:
    radial-gradient(115% 150% at 88% -30%, rgba(58,160,234,.55) 0%, transparent 58%),
    linear-gradient(118deg, var(--sf-navy) 0%, #04305C 52%, var(--sf-cloud) 100%);
  color:#fff;padding:26px 30px 28px;position:relative;overflow:hidden;
}
.top::after{
  content:"";position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(90% 60% at 12% 120%, rgba(255,255,255,.10), transparent 62%);
}
.top-in{position:relative;z-index:1;display:flex;justify-content:space-between;
  align-items:flex-start;gap:22px;flex-wrap:wrap;max-width:1500px}
.brand{display:flex;align-items:center;gap:14px}
.cloud{width:40px;height:29px;flex:none;filter:drop-shadow(0 2px 8px rgba(0,0,0,.22))}
h1{font-size:23px;font-weight:640;letter-spacing:-.032em;line-height:1.14}
.tagline{font-size:12.5px;opacity:.72;margin-top:3px;letter-spacing:-.005em;font-weight:450}
.hdr-meta{display:flex;gap:7px;align-items:center;flex-wrap:wrap}
/* This file embeds ~220KB of confidential account strategy. Say so on screen,
   because the earlier comment in the source claimed the opposite. */
.conf{display:inline-block;vertical-align:middle;margin-left:9px;
  font-size:9.5px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;
  background:rgba(255,255,255,.16);border:.5px solid rgba(255,255,255,.34);
  color:#fff;border-radius:var(--r-pill);padding:3px 9px;cursor:help;white-space:nowrap}
.conf:focus{outline:2px solid var(--sf-blue);outline-offset:2px}

/* Connector pills — frosted, quiet until something breaks */
.pill{
  background:rgba(255,255,255,.11);border:.5px solid rgba(255,255,255,.20);
  padding:5px 11px;border-radius:var(--r-pill);font-size:11px;font-weight:550;
  letter-spacing:-.005em;display:inline-flex;align-items:center;gap:6px;
  backdrop-filter:blur(20px) saturate(180%);-webkit-backdrop-filter:blur(20px) saturate(180%);
  transition:background var(--dur) var(--ease);white-space:nowrap;
}
.pill:hover{background:rgba(255,255,255,.18)}
.dot{width:6px;height:6px;border-radius:50%;background:#32D74B;
  box-shadow:0 0 0 3px rgba(50,215,75,.22)}
.dot.warn{background:#FF9F0A;box-shadow:0 0 0 3px rgba(255,159,10,.22)}
/* Seven amber dots on load read as seven broken connectors. Amber now means
   "came back partial"; not-yet-loaded is neutral. */
.dot.idle{background:var(--line-2);box-shadow:none}
.dot.err{background:#FF453A;box-shadow:0 0 0 3px rgba(255,69,58,.22);
  animation:pulse 2s var(--ease) infinite}
@keyframes pulse{50%{box-shadow:0 0 0 6px rgba(255,69,58,.05)}}

/* ───────────── nav: segmented control ───────────── */
/* The sticky layer moved from .nav to .navbar so the search field can sit
   beside the tabs without scrolling away with them. */
.navbar{
  display:flex;align-items:center;gap:14px;padding:9px 30px;
  position:sticky;top:0;z-index:20;
  background:color-mix(in srgb, var(--bg) 78%, transparent);
  backdrop-filter:blur(24px) saturate(180%);-webkit-backdrop-filter:blur(24px) saturate(180%);
  border-bottom:.5px solid var(--line);
}
.nav{
  display:flex;gap:3px;overflow-x:auto;flex:1;min-width:0;
  scrollbar-width:none;
}
.nav::-webkit-scrollbar{display:none}

/* ───────────── omnisearch ───────────── */
.omni{position:relative;flex:none}
.omni input{
  width:250px;padding:7px 30px 7px 12px;font-size:12.5px;border-radius:var(--r-pill);
  background:var(--card);border:.5px solid var(--line);color:var(--ink);
  font-family:inherit;box-shadow:none;
}
.omni input::-webkit-search-cancel-button{-webkit-appearance:none}
.omni input:focus{outline:none;border-color:var(--sf-blue);
  box-shadow:0 0 0 3px color-mix(in srgb, var(--sf-blue) 16%, transparent)}
.omni kbd{
  position:absolute;right:9px;top:50%;transform:translateY(-50%);pointer-events:none;
  font-family:inherit;font-size:10.5px;font-weight:620;color:var(--ink-3);
  background:var(--tint);border-radius:4px;padding:1px 5px;
}
.omni input:focus + kbd{display:none}
#omniOut{
  display:none;position:absolute;right:0;top:calc(100% + 7px);width:430px;max-width:82vw;
  max-height:min(62vh,470px);overflow:auto;z-index:60;
  background:var(--card);border:.5px solid var(--line);border-radius:var(--r);
  box-shadow:0 18px 46px rgba(0,22,57,.17), 0 0 0 .5px rgba(0,22,57,.05);
  padding:6px;
}
#omniOut.on{display:block}
#omniOut .oh{font-size:10px;font-weight:680;text-transform:uppercase;letter-spacing:.04em;
  color:var(--ink-3);padding:8px 10px 4px}
#omniOut .oi{padding:8px 10px;border-radius:var(--r-xs);cursor:pointer;display:block;
  width:100%;text-align:left;background:transparent;border:none;font-family:inherit;color:var(--ink)}
#omniOut .oi:hover,#omniOut .oi.sel{background:var(--tint)}
#omniOut .oi strong{font-size:12.5px;font-weight:590;display:block;letter-spacing:-.012em}
#omniOut .oi .om{font-size:11px;color:var(--ink-3);margin-top:2px}
@media(max-width:900px){
  .navbar{flex-wrap:wrap}
  .omni{flex:1 1 100%} .omni input{width:100%}
  #omniOut{width:100%;max-width:none}
}
.nav button{
  background:transparent;border:none;padding:8px 15px;font-size:13px;font-weight:530;
  color:var(--ink-2);cursor:pointer;white-space:nowrap;font-family:inherit;
  border-radius:var(--r-pill);display:flex;align-items:center;gap:7px;
  letter-spacing:-.012em;transition:all var(--dur) var(--ease);
}
.nav button:hover{color:var(--ink);background:var(--tint)}
.nav button.on{
  color:var(--sf-blue);background:var(--card);font-weight:590;
  box-shadow:0 1px 3px rgba(0,22,57,.10), 0 0 0 .5px rgba(0,22,57,.05);
}
.nav .cnt{
  background:var(--line-2);color:var(--ink-2);border-radius:var(--r-pill);
  min-width:19px;padding:1px 6px;font-size:11px;font-weight:620;text-align:center;
  transition:all var(--dur) var(--ease);
}
.nav button.on .cnt{background:var(--sf-blue);color:#fff}

/* ───────────── subnav: views inside the active group ───────────── */
.subnav{
  display:flex;gap:2px;padding:0 30px;overflow-x:auto;scrollbar-width:none;
  /* --navh is measured from the real navbar, which wraps to two rows under
     900px. A hardcoded 47px put the second-level tabs UNDERNEATH the search
     box at every width between 561 and 900. */
  position:sticky;top:var(--navh,47px);z-index:19;
  background:color-mix(in srgb, var(--bg) 78%, transparent);
  backdrop-filter:blur(24px) saturate(180%);-webkit-backdrop-filter:blur(24px) saturate(180%);
  border-bottom:.5px solid var(--line);
}
.subnav::-webkit-scrollbar{display:none}
.subnav:empty{display:none}
.subnav button{
  background:transparent;border:none;padding:9px 2px;margin-right:20px;
  font-size:12px;font-weight:540;color:var(--ink-3);cursor:pointer;white-space:nowrap;
  font-family:inherit;letter-spacing:-.008em;display:flex;align-items:center;gap:6px;
  border-bottom:2px solid transparent;transition:all var(--dur) var(--ease);
}
.subnav button:hover{color:var(--ink)}
.subnav button.on{color:var(--sf-blue);border-bottom-color:var(--sf-blue);font-weight:600}
.subnav .cnt{
  background:var(--line-2);color:var(--ink-2);border-radius:var(--r-pill);
  min-width:18px;padding:0 5px;font-size:10.5px;font-weight:620;text-align:center;
}
.subnav button.on .cnt{background:var(--sf-blue);color:#fff}
@media(max-width:820px){ .subnav{padding:0 18px} }
@media(max-width:560px){ .subnav{padding:0 13px} .subnav button{margin-right:15px;font-size:11.5px} }

/* Search lands you on a row; flash it so you can see which one. */
tr.flash>td{animation:flash 1.4s var(--ease)}
@keyframes flash{
  0%,55%{background:color-mix(in srgb, var(--sf-blue) 15%, transparent)}
  100%{background:transparent}
}

.wrap{padding:26px 30px 80px;max-width:1500px;margin:0 auto}
.tab{display:none}
.tab.on{display:block;animation:rise var(--dur) var(--ease)}
@keyframes rise{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

/* ───────────── KPI tiles ───────────── */
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:13px;margin-bottom:28px}
.kpi{
  background:var(--card);border:none;border-radius:var(--r);padding:17px 19px 18px;
  box-shadow:var(--shadow), var(--shadow-in);position:relative;overflow:hidden;
  transition:transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
}
.kpi:hover{transform:translateY(-2px);box-shadow:var(--shadow-lg), var(--shadow-in)}
/* Accent is a soft top-corner wash, not a hard bar */
.kpi::before{content:"";position:absolute;right:-30px;top:-30px;width:96px;height:96px;
  border-radius:50%;background:var(--sf-blue);opacity:.09;transition:opacity var(--dur)}
.kpi:hover::before{opacity:.15}
.kpi.t::before{background:var(--sf-teal)} .kpi.o::before{background:var(--sf-orange)}
.kpi.r::before{background:var(--sf-red)}  .kpi.p::before{background:var(--sf-purple)}
.kpi.g::before{background:var(--sf-green)}
.kpi .lbl{font-size:11px;font-weight:560;letter-spacing:-.005em;color:var(--ink-3);
  text-transform:none;position:relative}
.kpi .val{font-size:31px;font-weight:600;letter-spacing:-.045em;margin-top:6px;
  line-height:1;position:relative;font-feature-settings:"tnum"}
.kpi-lbl{font-size:11px;font-weight:560;color:var(--ink-3);margin-bottom:6px}
.kpi .sub{font-size:11.5px;color:var(--ink-3);margin-top:5px;position:relative;font-weight:450}

/* ───────────── section headers ───────────── */
.sec{font-size:12.5px;font-weight:600;text-transform:none;letter-spacing:-.014em;
  color:var(--ink);margin:30px 0 13px;display:flex;align-items:center;gap:10px}
.sec::after{content:"";flex:1;height:.5px;background:var(--line)}
.sec .chip{font-weight:550}

/* ───────────── cards ───────────── */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:14px}
.card{
  background:var(--card);border:none;border-radius:var(--r);padding:17px 19px;
  box-shadow:var(--shadow), var(--shadow-in);
  transition:transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
}
.card.click{cursor:pointer}
.card.click:hover,.card:hover.click{transform:translateY(-2px);box-shadow:var(--shadow-lg), var(--shadow-in)}
.card h3{font-size:15.5px;font-weight:600;display:flex;align-items:center;gap:8px;
  flex-wrap:wrap;letter-spacing:-.021em;line-height:1.32}
.card .meta{font-size:12.5px;color:var(--ink-3);margin-top:4px;font-weight:450;letter-spacing:-.005em}
.stack{display:flex;flex-direction:column;gap:11px}

/* ───────────── tags: tinted, lowercase, calm ───────────── */
.tag{font-size:11px;font-weight:560;padding:3px 9px;border-radius:var(--r-pill);
  letter-spacing:-.005em;text-transform:none;white-space:nowrap;line-height:1.45}
.tag.strategic{background:rgba(144,80,233,.11);color:#7B3FD4}
.tag.active{background:var(--sf-blue-lt);color:var(--sf-blue)}
.tag.territory{background:rgba(0,22,57,.06);color:var(--ink-2)}
.tag.risk{background:rgba(234,0,30,.10);color:#D6001C}
.tag.win,.tag.g{background:rgba(46,132,74,.11);color:#1F7A3D}
.tag.warm{background:rgba(254,147,57,.14);color:#9A5300}
.tag.teal{background:rgba(6,165,154,.12);color:#05837A}
.tag.p{background:rgba(144,80,233,.11);color:#7B3FD4}
.tag.grey{background:rgba(0,22,57,.06);color:var(--ink-2)}
@media (prefers-color-scheme: dark){
  .tag.strategic,.tag.p{color:#C4A0F5} .tag.risk{color:#FF8A80}
  .tag.win,.tag.g{color:#6BCB8B} .tag.warm{color:#FFBE6E} .tag.teal{color:#4FD8CE}
  .tag.territory,.tag.grey{color:var(--ink-2)}
}

.chip{background:rgba(0,22,57,.055);border-radius:var(--r-pill);padding:3px 10px;
  font-size:11.5px;font-weight:520;color:var(--ink-2);letter-spacing:-.005em;white-space:nowrap}
@media (prefers-color-scheme: dark){.chip{background:rgba(255,255,255,.07)}}
.src{display:inline-block;background:rgba(0,22,57,.05);color:var(--ink-3);
  border-radius:var(--r-xs);padding:1px 6px;font-size:10.5px;font-weight:500;
  margin-left:5px;vertical-align:1px;letter-spacing:-.005em}
@media (prefers-color-scheme: dark){.src{background:rgba(255,255,255,.06)}}

/* ───────────── expandable rows ───────────── */
tr.ex{cursor:pointer;transition:background var(--dur) var(--ease)}
tr.ex:hover{background:var(--tint)}
.caret{color:var(--ink-3);font-size:10px;display:inline-block;width:11px;
  transition:transform var(--dur) var(--ease)}
tr.exd > td{background:var(--card-2);padding:0!important}
.exd-in{padding:16px 19px;border-left:2.5px solid var(--sf-blue)}
.kv-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:9px 22px}

/* ───────────── forms ───────────── */
.adv-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(245px,1fr));gap:13px}
.adv-grid label{display:flex;flex-direction:column;gap:6px;font-size:11.5px;font-weight:560;
  color:var(--ink-3);text-transform:none;letter-spacing:-.005em}
.adv-grid select{width:100%;text-transform:none;letter-spacing:-.01em;font-weight:480}
select,input,textarea{
  font-family:inherit;font-size:13px;padding:8px 11px;border:.5px solid var(--line-2);
  border-radius:var(--r-sm);background:var(--card);color:var(--ink);
  letter-spacing:-.01em;transition:border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  box-shadow:0 1px 1px rgba(0,22,57,.03);
}
select{appearance:none;-webkit-appearance:none;padding-right:30px;cursor:pointer;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6'><path d='M1 1l4 4 4-4' stroke='%238A8B90' stroke-width='1.6' fill='none' stroke-linecap='round'/></svg>");
  background-repeat:no-repeat;background-position:right 11px center}
select:hover,input:hover,textarea:hover{border-color:var(--ink-3)}
select:focus,input:focus,textarea:focus{outline:none;border-color:var(--sf-blue);
  box-shadow:0 0 0 3.5px var(--sf-blue-lt)}
textarea{width:100%;min-height:150px;line-height:1.6;resize:vertical;
  font-size:13px;padding:12px 14px}

/* ───────────── buttons ───────────── */
.btn{
  background:var(--sf-blue);color:#fff;border:none;padding:8px 16px;border-radius:var(--r-pill);
  font-size:12.5px;font-weight:560;cursor:pointer;font-family:inherit;letter-spacing:-.012em;
  display:inline-flex;align-items:center;gap:6px;white-space:nowrap;
  box-shadow:0 1px 2px rgba(1,118,211,.28);
  transition:transform .12s var(--ease), box-shadow var(--dur) var(--ease), background var(--dur);
}
.btn:hover{background:#0268BC;box-shadow:0 2px 8px rgba(1,118,211,.34)}
.btn:active{transform:scale(.96)}
.btn.ghost{background:var(--card);color:var(--sf-blue);
  box-shadow:0 1px 2px rgba(0,22,57,.06), inset 0 0 0 .5px var(--line-2)}
.btn.ghost:hover{background:var(--sf-blue-lt);
  box-shadow:0 1px 3px rgba(0,22,57,.08), inset 0 0 0 .5px var(--sf-blue)}
.btn.sm{padding:5px 12px;font-size:11.5px}
.btn:disabled{opacity:.4;cursor:not-allowed;transform:none;box-shadow:none}

/* ───────────── tables ───────────── */
table{width:100%;border-collapse:collapse;font-size:13px}
th{text-align:left;font-size:11px;text-transform:none;letter-spacing:-.005em;color:var(--ink-3);
  font-weight:550;padding:11px 14px;border-bottom:.5px solid var(--line-2);
  white-space:nowrap;background:transparent;position:sticky;top:0;
  backdrop-filter:blur(12px);background:color-mix(in srgb, var(--card) 88%, transparent)}
td{padding:12px 14px;border-bottom:.5px solid var(--line);vertical-align:top}
tbody tr{transition:background var(--dur) var(--ease)}
tbody tr:hover{background:var(--tint)}
tbody tr:last-child td{border-bottom:none}
.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap;font-feature-settings:"tnum"}
.tbl-wrap,.tw{background:var(--card);border:none;border-radius:var(--r);overflow:auto;
  box-shadow:var(--shadow), var(--shadow-in)}
.tw{box-shadow:none;border-radius:0}
.card .tw{margin:-2px 0}

/* ───────────── notes ───────────── */
.note{background:var(--sf-blue-lt);border:none;border-left:2.5px solid var(--sf-blue);
  border-radius:var(--r-xs);padding:13px 16px;font-size:12.5px;color:var(--ink-2);
  margin-bottom:16px;line-height:1.58;letter-spacing:-.005em}
.note strong{color:var(--ink);font-weight:600}
.note.warn{background:rgba(254,147,57,.09);border-left-color:var(--sf-orange)}
.note.err{background:rgba(234,0,30,.07);border-left-color:var(--sf-red)}
.gate{border-left:2.5px solid var(--sf-orange);background:rgba(254,147,57,.07);
  padding:13px 16px;border-radius:var(--r-xs);margin:11px 0;font-size:12.5px;line-height:1.6;
  color:var(--ink-2)}
.gate.block{border-left-color:var(--sf-red);background:rgba(234,0,30,.06)}
.gate strong{display:block;margin-bottom:4px;color:var(--ink);font-weight:600}

/* ───────────── misc ───────────── */
a{color:var(--sf-blue);text-decoration:none;transition:opacity var(--dur)}
a:hover{text-decoration:underline;text-underline-offset:2px;opacity:.82}
.mono{font-family:"SF Mono",ui-monospace,Menlo,Consolas,monospace;font-size:12px;letter-spacing:-.02em}
.empty{padding:46px 20px;text-align:center;color:var(--ink-3);font-size:13px;font-weight:450}
.spin{display:inline-block;width:14px;height:14px;border:2px solid var(--line-2);
  border-top-color:var(--sf-blue);border-radius:50%;animation:sp .7s linear infinite;vertical-align:-2px}
@keyframes sp{to{transform:rotate(360deg)}}
.skel{background:linear-gradient(90deg,var(--line) 25%,var(--card-2) 50%,var(--line) 75%);
  background-size:200% 100%;animation:sh 1.4s infinite;border-radius:var(--r-xs);height:12px}
@keyframes sh{0%{background-position:200% 0}100%{background-position:-200% 0}}
.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.sp{flex:1}
.bar{height:6px;background:var(--line);border-radius:var(--r-pill);overflow:hidden;margin-top:8px}
.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--sf-blue),var(--sf-teal));
  border-radius:var(--r-pill)}
.kv{display:flex;justify-content:space-between;gap:14px;padding:8px 0;
  border-bottom:.5px solid var(--line);font-size:12.5px}
.kv:last-child{border:none}
.kv .k{color:var(--ink-3);font-weight:480}
.kv .v{text-align:right;font-weight:540}

.split{display:grid;grid-template-columns:minmax(240px,308px) 1fr;gap:18px;align-items:start}
@media(max-width:900px){.split{grid-template-columns:1fr}}
.list-item{padding:11px 13px;border-radius:var(--r-sm);cursor:pointer;border:none;
  transition:background var(--dur) var(--ease), transform var(--dur) var(--ease)}
.list-item:hover{background:var(--tint)}
.list-item.on{background:var(--sf-blue-lt);box-shadow:inset 0 0 0 1px var(--sf-blue)}
.list-item .n{font-size:13.5px;font-weight:560;letter-spacing:-.015em;
  display:flex;align-items:center;gap:7px;flex-wrap:wrap}
.list-item .d{font-size:11.5px;color:var(--ink-3);margin-top:2px;font-weight:450}

.eng{width:8px;height:8px;border-radius:50%;display:inline-block;flex:none}
.eng.r30{background:#32D74B;box-shadow:0 0 0 2.5px rgba(50,215,75,.18)}
.eng.r90{background:var(--sf-teal);box-shadow:0 0 0 2.5px rgba(6,165,154,.16)}
.eng.old{background:#FF9F0A;box-shadow:0 0 0 2.5px rgba(255,159,10,.18)}
.eng.never{background:var(--line-2)}
.stk{border-radius:var(--r-sm);transition:background var(--dur) var(--ease)}
.stk:hover{background:var(--tint)}

.chart-box{background:var(--card);border:none;border-radius:var(--r);padding:18px;
  box-shadow:var(--shadow), var(--shadow-in);height:288px;position:relative}
.sku-row{display:flex;gap:12px;align-items:flex-start;padding:12px 0;
  border-bottom:.5px solid var(--line)}
.sku-row:last-child{border-bottom:none}
.sku-lead{border-left:2.5px solid var(--sf-green);padding-left:12px}

/* ───────────── disclosure ───────────── */
details{background:var(--card);border:none;border-radius:var(--r);padding:0;
  box-shadow:var(--shadow), var(--shadow-in);margin-bottom:11px;overflow:hidden}
summary{padding:14px 18px;cursor:pointer;font-size:14px;font-weight:560;list-style:none;
  display:flex;align-items:center;gap:10px;letter-spacing:-.016em;
  transition:background var(--dur) var(--ease)}
summary:hover{background:var(--tint)}
summary::-webkit-details-marker{display:none}
summary::before{content:"›";color:var(--sf-blue);font-size:17px;font-weight:600;
  transition:transform var(--dur) var(--ease);display:inline-block;width:10px;line-height:1}
details[open] summary::before{transform:rotate(90deg)}
details .body{padding:2px 18px 18px;font-size:13px;line-height:1.65;color:var(--ink-2)}
details .body p{margin-bottom:10px} details .body ul{margin:8px 0 10px 20px}
details .body li{margin-bottom:6px}
details .body strong{color:var(--ink);font-weight:600}

/* ───────────── calendar ───────────── */
.cal-bar{display:flex;align-items:center;gap:7px;margin:4px 0 13px;flex-wrap:wrap}
/* Clickable tiles need to look different from the ~25 that are not. */
.kpi.click{cursor:pointer;position:relative}
.kpi.click::after{content:'\203A';position:absolute;top:12px;right:14px;
  font-size:17px;line-height:1;color:var(--ink-3);transition:all var(--dur) var(--ease)}
.kpi.click:hover::after{color:var(--sf-blue);transform:translateX(2px)}
.kpi.click[aria-expanded="true"]{box-shadow:0 0 0 2px var(--sf-blue)}
.kpi.click[aria-expanded="true"]::after{content:'\2039';color:var(--sf-blue)}
/* One visible focus style for everything the keyboard can reach. */
.kpi.click:focus-visible,.list-item:focus-visible,.stk:focus-visible,
.cal-ev:focus-visible,tr.ex:focus-visible,.btn:focus-visible,
.nav button:focus-visible,.subnav button:focus-visible{
  outline:2px solid var(--sf-blue);outline-offset:2px}

.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;
  overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
.lg-dot{display:inline-block;width:8px;height:8px;border-radius:2.5px;
  vertical-align:middle;margin-right:4px}
.cal{background:var(--card);border:none;border-radius:var(--r);overflow:hidden;
  box-shadow:var(--shadow), var(--shadow-in);margin-bottom:24px}
.cal-head{display:grid;grid-template-columns:56px repeat(var(--days),1fr);
  border-bottom:.5px solid var(--line-2);position:sticky;top:0;z-index:3;
  background:color-mix(in srgb, var(--card) 90%, transparent);
  backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px)}
.cal-head > div{padding:11px 5px 9px;text-align:center;border-left:.5px solid var(--line)}
.cal-head > div:first-child{border-left:none}
.cal-dow{font-size:11px;font-weight:520;letter-spacing:-.005em;text-transform:none;color:var(--ink-3)}
.cal-dnum{font-size:20px;font-weight:520;color:var(--ink);line-height:1.3;letter-spacing:-.03em}
.cal-head .is-today .cal-dow{color:var(--sf-blue);font-weight:590}
.cal-head .is-today .cal-dnum{background:var(--sf-blue);color:#fff;border-radius:50%;
  width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center;
  font-size:17px;font-weight:560;box-shadow:0 2px 8px rgba(1,118,211,.32)}
.cal-allday{display:grid;grid-template-columns:56px repeat(var(--days),1fr);
  border-bottom:.5px solid var(--line-2);min-height:26px;background:var(--card-2)}
.cal-allday > div{border-left:.5px solid var(--line);padding:4px}
.cal-allday > div:first-child{border-left:none;font-size:10.5px;color:var(--ink-3);
  text-align:right;padding:6px 6px 0 0;text-transform:none;font-weight:480}
.cal-body{display:grid;grid-template-columns:56px repeat(var(--days),1fr);
  max-height:588px;overflow-y:auto;position:relative}
.cal-gut{border-right:.5px solid var(--line)}
.cal-gut div{height:46px;font-size:10.5px;color:var(--ink-3);text-align:right;
  padding-right:8px;position:relative;top:-7px;font-weight:450}
.cal-col{border-left:.5px solid var(--line);position:relative}
.cal-col.wknd{background:var(--card-2)}
.cal-col .hr{height:46px;border-bottom:.5px solid var(--line)}
.cal-col .hr.half{border-bottom:.5px dotted var(--line)}
.cal-ev{position:absolute;left:3px;right:3px;border-radius:var(--r-xs);padding:4px 7px;
  overflow:hidden;font-size:11.5px;line-height:1.34;cursor:pointer;
  border-left:2.5px solid var(--sf-blue);background:var(--sf-blue-lt);color:var(--sf-blue-dk);
  transition:box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease);
  letter-spacing:-.008em}
.cal-ev:hover{box-shadow:var(--shadow-lg);z-index:5;transform:translateY(-1px) scale(1.014)}
.cal-ev.internal{background:rgba(144,80,233,.11);border-left-color:var(--sf-purple);color:#6A2FBF}
.cal-ev.focus{background:rgba(0,22,57,.05);border-left-color:var(--ink-3);color:var(--ink-2)}
@media (prefers-color-scheme: dark){
  .cal-ev.internal{color:#C4A0F5} .cal-ev.focus{background:rgba(255,255,255,.06)}
}
.cal-ev .t{font-weight:570;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cal-ev .w{opacity:.74;font-size:10.5px;font-weight:450}
.cal-ev.tiny{padding:2px 7px;font-size:10.5px}
.cal-ev.tiny .w{display:none}
.cal-now{position:absolute;left:0;right:0;height:1.5px;background:#FF453A;z-index:4;pointer-events:none}
.cal-now::before{content:'';position:absolute;left:-4px;top:-3.25px;width:8px;height:8px;
  border-radius:50%;background:#FF453A;box-shadow:0 0 0 3px rgba(255,69,58,.18)}
.cal-chip{display:inline-block;background:var(--sf-blue-lt);color:var(--sf-blue);
  border-radius:var(--r-xs);padding:2px 7px;font-size:10.5px;font-weight:520;margin:1px 0}

@media(max-width:900px){
  /* The nav scrolls but hides its scrollbar, so on a narrow screen there was no
     hint that tabs continue past the edge. Give it a thin visible track. */
  .nav::-webkit-scrollbar{display:block;height:3px}
  .nav::-webkit-scrollbar-thumb{background:var(--line-2);border-radius:2px}
  .nav::-webkit-scrollbar-track{background:transparent}
}
@media(max-width:820px){
  .top{padding:20px 18px 22px} .navbar{padding:8px 18px} .wrap{padding:20px 18px 70px}
  h1{font-size:20px}
  .cal-head,.cal-allday,.cal-body{grid-template-columns:42px repeat(var(--days),1fr)}
  .cal-ev{font-size:10px} .kpi .val{font-size:27px}
  /* Nine-column tables used to crush to unreadable slivers. Hold a floor width
     and let the wrapper scroll sideways instead. */
  .tbl-wrap,.tw{-webkit-overflow-scrolling:touch}
  .tbl-wrap>table,.tw>table{min-width:660px}
  th,td{padding:9px 11px;font-size:12px}
  .kpis{grid-template-columns:repeat(auto-fit,minmax(142px,1fr));gap:10px;margin-bottom:20px}
  .grid{grid-template-columns:1fr}
  .adv-grid{grid-template-columns:1fr}
  .hdr-meta{gap:5px}
  textarea{font-size:12.5px}
}
@media(max-width:560px){
  .wrap{padding:16px 13px 64px}
  .top{padding:16px 13px 18px} .navbar{padding:7px 13px}
  h1{font-size:18px} .tagline{font-size:11px}
  .kpi .val{font-size:23px}
  .cal-head,.cal-allday,.cal-body{grid-template-columns:38px repeat(var(--days),1fr)}
  .cal-ev{font-size:11px}
  .btn{padding:8px 12px}
  select,input,textarea{max-width:100%}
}
/* Both full-width banners used to hardcode 30px side margins while .wrap drops
   to 13px under 560px, so on a phone they hung inboard of everything else. */
.edgeBanner{margin:0 30px 0}
@media (max-width:560px){ .edgeBanner{margin:0 13px 0} }
</style>
</head>
<body>

<div class="top">
  <div class="top-in">
    <div class="brand">
      <svg class="cloud" viewBox="0 0 100 70" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M40 12c4-5 10-8 17-8 9 0 17 5 21 13 3-1 6-2 9-2 12 0 22 10 22 22s-10 22-22 22H24C11 59 0 49 0 36c0-11 8-21 19-23 4-1 8 0 11 1 2-1 6-2 10-2z" fill="#fff" opacity=".95"/>
      </svg>
      <div>
        <h1>Marketing Specialist Command Center
          <span class="conf" tabindex="0" role="note" title="This file embeds named customer stakeholders, ACV and TCV figures, tenant identifiers and Drive document ids. Safe on your own machine. A leak the moment it is hosted, emailed or committed.">Confidential &mdash; do not share or publish</span>
        </h1>
        <div class="tagline" id="ccTagline"></div>
      </div>
    </div>
    <div class="hdr-meta">
      <span class="pill" id="pSf"><span class="dot idle"></span>Salesforce</span>
      <span class="pill" id="pSfr"><span class="dot idle"></span>SFRs</span>
      <span class="pill" id="pDrive"><span class="dot idle"></span>Drive</span>
      <span class="pill" id="pSlack"><span class="dot idle"></span>Slack</span>
      <span class="pill" id="pMail"><span class="dot idle"></span>Gmail</span>
      <span class="pill" id="pDM"><span class="dot idle"></span>Slack DMs</span>
      <span class="pill" id="pCal"><span class="dot idle"></span>Calendar</span>
      <span class="pill" id="pTime">&mdash;</span>
      <label class="pill" style="gap:6px;cursor:pointer">
        <span style="opacity:.7">Counting</span>
        <select id="scopeSel" aria-label="Which products this app counts"
          style="background:transparent;border:none;color:#fff;font-size:11px;padding:0;
                 box-shadow:none;font-weight:550">
          <option value="digital" style="color:#1A1A1C">My products</option>
          <option value="all" style="color:#1A1A1C">Everything on my accounts</option>
        </select>
      </label>
      <button class="pill" id="reloadBtn" title="Refetch everything from source"
        style="cursor:pointer;font-family:inherit;color:#fff">↻ Reload</button>
    </div>
  </div>
</div>

<div class="navbar">
<!-- Ten flat tabs became five groups. The leaf tabs and their renderers are
     unchanged; only the shell moved. Group buttons are built by buildNav() so
     the counts stay in one place. -->
<div class="nav" id="nav"></div>
<div class="omni">
  <!-- People only become searchable once a family has been opened, so the
       placeholder no longer promises them unconditionally. -->
  <input id="omni" type="search" placeholder="Search deals, accounts, SFRs, actions…"
    autocomplete="off" spellcheck="false" aria-label="Search everything"
    role="combobox" aria-expanded="false" aria-controls="omniOut"
    aria-autocomplete="list">
  <kbd id="omniKbd">/</kbd>
  <div id="omniOut" role="listbox" aria-label="Search results"></div>
</div>
</div>
<!-- Second level: the views inside the active group. -->
<div class="subnav" id="subnav"></div>

<!-- The count spans used to live inside the flat nav buttons, and a dozen
     renderers write to them by id. Keeping them here, hidden, means the nav
     could be rebuilt without touching any renderer. syncNavCounts() copies
     these into whichever nav button is currently showing. -->
<div hidden aria-hidden="true">
  <span id="cSfr">–</span><span id="cToday">–</span><span id="cBook">–</span>
  <span id="cPipe">–</span><span id="cInbox">–</span><span id="cSig">–</span>
  <span id="cPov">–</span><span id="cRenew">–</span>
</div>

<!-- One short announcer. aria-live on the output containers meant a screen
     reader read out an entire 500-word POV narrative on every generation. -->
<div id="srSay" class="sr-only" aria-live="polite" role="status"></div>

<div class="wrap">

<!-- ============ SFR / SAF ============ -->
<div class="tab on" id="sfr">
  <div id="sfrNote"></div>
  <div id="quotaStrip"></div>
  <!-- Skeletons live on the DEFAULT tab. They used to be on Accounts, which is
       not where the app opens, so the first screen was a blank body for a
       second or two while three SOQL queries resolved. -->
  <div class="kpis" id="sfrKpis">
    <div class="kpi"><div class="lbl">Commit</div><div class="val"><span class="skel" style="width:86px;display:block"></span></div></div>
    <div class="kpi t"><div class="lbl">Best case</div><div class="val"><span class="skel" style="width:86px;display:block"></span></div></div>
    <div class="kpi p"><div class="lbl">This quarter</div><div class="val"><span class="skel" style="width:86px;display:block"></span></div></div>
    <div class="kpi o"><div class="lbl">Open pipeline</div><div class="val"><span class="skel" style="width:86px;display:block"></span></div></div>
    <div class="kpi g"><div class="lbl">Closed won</div><div class="val"><span class="skel" style="width:86px;display:block"></span></div></div>
  </div>

  <div class="row" style="margin-bottom:10px">
    <select id="sAcct" aria-label="Account"><option value="">All accounts</option></select>
    <select id="sQtr" aria-label="Fiscal quarter"><option value="">All quarters</option></select>
    <select id="sStat" aria-label="Forecast judgement"><option value="">All judgements</option></select>
    <label class="row" style="gap:5px;font-size:11.5px;font-weight:600;color:var(--ink-2)">
      <input type="checkbox" id="sOpen" style="width:auto" checked> Hide dead &amp; closed
    </label>
    <span class="sp"></span>
    <button class="btn sm ghost" id="sClear" style="display:none">Clear filters</button>
    <span class="sp"></span>
    <span class="chip" id="sfrCount" aria-live="polite"></span>
    <span class="chip" id="sfrSum"></span>
  </div>

  <div id="sfrDrillPanel" style="display:none"></div>

  <div class="sec">Needs your attention</div>
  <!-- Seeded, so the heading is not a promise over blank space while three
       queries resolve. -->
  <div class="stack" id="sfrFlags"><div class="card"><div class="empty">
    <span class="spin"></span> Checking your forecast records…</div></div></div>

  <div class="sec">Forecast roll-up by quarter
    <button class="btn sm ghost" id="cpRoll" data-copytable="#sfrRollup"
      style="float:right;font-weight:500">Copy</button></div>
  <div class="card"><div class="tw"><table id="sfrRollup"></table></div></div>

  <div class="sec">All SFRs</div>
  <div class="card"><div class="tw"><table>
    <thead><tr><th scope="col">SFR</th><th scope="col">Account</th>
      <th scope="col">Next step</th><th scope="col">Specialist stage</th>
      <th scope="col">Judgement</th><th scope="col" class="num">Amount</th>
      <th scope="col">Close</th><th scope="col">Qtr</th><th scope="col">Opp stage</th></tr></thead>
    <tbody id="sfrBody">
      <tr><td colspan="9" class="empty"><span class="spin"></span>
        Loading your specialist forecast records…</td></tr>
    </tbody>
  </table></div></div>
</div>

<!-- ============ TODAY ============ -->
<div class="tab" id="today">
  <div id="todayNote"></div>
  <div class="kpis" id="todayKpis"></div>

  <!-- The ranked list FIRST. It used to sit under the note, three tiles and a
       588px calendar grid — i.e. below the fold on a laptop, on the one tab
       whose entire job is answering "what do I do today". -->
  <div class="sec">What to do today &mdash;
    <span id="todayDate" style="text-transform:none;letter-spacing:0"></span></div>
  <!-- One ranked list. "What do I do today" used to mean checking four separate
       views: meetings here, replies on Inbox, risks on Signals, hygiene on
       My SFRs. -->
  <div id="todayDo"></div>

  <div class="cal-bar">
    <button class="btn sm ghost" id="calPrev">&lsaquo;</button>
    <button class="btn sm ghost" id="calToday">Today</button>
    <button class="btn sm ghost" id="calNext">&rsaquo;</button>
    <strong id="calRange" style="font-size:13.5px;margin-left:6px"></strong>
    <span class="sp"></span>
    <span class="chip" id="calLegend">
      <span class="lg-dot" style="background:var(--sf-blue)"></span> customer
      <span class="lg-dot" style="background:#9050E9;margin-left:9px"></span> internal
      <span class="lg-dot" style="background:var(--ink-3);margin-left:9px"></span> focus / personal
    </span>
  </div>
  <div class="cal" id="calGrid"></div>

  <div class="sec">Today's schedule</div>
  <div class="stack" id="todayList"></div>
</div>

<!-- ============ HPF ============ -->
<div class="tab" id="hpf">
  <div id="hpfNote"></div>
  <div class="kpis" id="hpfKpis"></div>
  <div class="sec">Performance summary</div>
  <div id="hpfSummary"></div>
  <div class="sec">Business Owner</div>
  <div id="hpfBiz"></div>
  <div class="sec">Trusted Partner</div>
  <div id="hpfTp"></div>
  <div class="sec">Team Seller</div>
  <div id="hpfTeam"></div>
  <div class="sec">This quarter's SFRs, by forecast judgement</div>
  <div id="hpfDeals"></div>
  <div class="sec">What only you can confirm</div>
  <div id="hpfSelf"></div>
  <div class="sec">Where the numbers came from</div>
  <div id="hpfSrc"></div>
</div>

<!-- ============ BOOK ============ -->
<div class="tab" id="book">
  <div id="bookNote"></div>
  <div class="kpis" id="bookKpis"></div>
  <div class="sec">Account families</div>
  <div class="grid" id="famGrid"></div>
  <div id="famDetail"></div>
</div>

<!-- ============ PIPELINE ============ -->
<div class="tab" id="pipeline">
  <div id="pipelineNote"></div>
  <div class="kpis" id="pipeKpis"></div>
  <div id="pipeDrillNote"></div>
  <div id="pipeBucket"></div>
  <div class="row" style="margin-bottom:11px">
    <span class="chip" style="font-weight:560">View pipeline by</span>
    <select id="fView" aria-label="Group pipeline by">
      <option value="stage">Stage</option>
      <option value="product">Product line</option>
      <option value="cat">Forecast category</option>
      <option value="acct">Account</option>
    </select>
    <span class="meta">Click any bar to see just those opportunities.</span>
    <span class="sp"></span>
    <span id="drillBox"></span>
  </div>
  <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(340px,1fr));margin-bottom:6px">
    <div class="chart-box"><canvas id="chStage"></canvas></div>
    <div class="chart-box"><canvas id="chFam"></canvas></div>
  </div>
  <div class="sec">All open opportunities <span class="chip" id="pipeCount" aria-live="polite"></span></div>
  <!-- The L1/L2 rule used to exist only as a hover tooltip on a 2-char tag,
