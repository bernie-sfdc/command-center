      (qSfrs.length > 25 ? '<div class="meta" style="margin-top:7px">Largest 25 of '+
        qSfrs.length+'. My SFRs has all of them, with filters.</div>' : '')+
      '<div class="note" style="margin-top:9px">Manager Commit, Deal Type, '+
