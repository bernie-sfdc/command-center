      '<div class="card"><h3>Stage spread</h3><div style="margin-top:9px">'+
        (Object.entries(stages).sort((a,b)=>b[1]-a[1]).map(([s,n])=>kv(s,n)).join('')||'<div class="empty">No open opps.</div>')+
      '</div></div>'+
      '<div class="card"><h3>Deal team</h3><div style="margin-top:9px">'+
        (Object.entries(owners).sort((a,b)=>b[1]-a[1]).map(([s,n])=>kv(s,n+' opp'+(n===1?'':'s'))).join('')||'<div class="empty">—</div>')+
      '</div></div>'+
    '</div>'+
    '<div class="tbl-wrap" style="margin-bottom:14px"><table><thead><tr>'+
      '<th>Opportunity</th><th>Stage</th><th>Forecast</th><th class="num">Amount</th><th>Close</th><th>Owner</th><th>Last activity</th>'+
    '</tr></thead><tbody>'+
      (opps.map(oppRow).join('')||'<tr><td colspan="7" class="empty">No live opportunities.</td></tr>')+
    '</tbody></table></div>'+
    (f.zombies.length?'<details style="margin-bottom:14px"><summary>'+f.zombies.length+
      ' zombie opportunit'+(f.zombies.length===1?'y':'ies')+' &mdash; excluded from pipeline '+
      '<span class="chip">'+moneyFull(f.zombies.reduce((s,o)=>s+specAmt(o),0))+' phantom</span></summary>'+
      '<div class="body"><div class="tbl-wrap" style="box-shadow:none"><table><thead><tr>'+
      '<th>Opportunity</th><th>Stage</th><th class="num">Amount</th><th>Close date</th><th>Owner</th>'+
      '</tr></thead><tbody>'+
      f.zombies.slice().sort((a,b)=>(a.CloseDate||'').localeCompare(b.CloseDate||'')).map(o=>
        '<tr><td>'+esc(o.Name)+'</td><td style="font-size:11px">'+esc(o.StageName)+'</td>'+
        '<td class="num">'+(specAmt(o)?moneyFull(specAmt(o)):'—')+'</td>'+
        '<td style="color:var(--sf-red);font-weight:600">'+fmtDate(o.CloseDate)+'</td>'+
        '<td style="font-size:11px">'+esc(o.Owner&&o.Owner.Name||'—')+'</td></tr>').join('')+
      '</tbody></table></div></div></details>':'')+
    (docs.length?'<div class="sec">Drive material</div><div class="tbl-wrap"><table><thead><tr>'+
      '<th>Document</th><th>Type</th><th>Modified</th></tr></thead><tbody>'+
      docs.map(d=>'<tr><td><a href="'+esc(safeUrl(d.viewUrl))+'" target="_blank" rel="noopener noreferrer">'+esc(d.title)+'</a></td>'+
        '<td><span class="chip">'+esc(mime(d.mimeType))+'</span></td>'+
        '<td>'+fmtDate((d.modifiedTime||'').slice(0,10))+'</td></tr>').join('')+
      '</tbody></table></div>':'');

  if(!keepScroll) $('famDetail').scrollIntoView({behavior:'smooth',block:'start'});
}
/* k is escaped (two callers pass raw Salesforce text); v is treated as
   pre-built HTML because most callers legitimately pass markup — escaping it
   was rendering "<span class=mono>006…</span>" as visible text in the most-used
   drill-down in the app. Callers passing raw text must esc() it themselves. */
/* One copy path for every Copy button. document.execCommand('copy') is
   deprecated and silently does nothing in some embedded contexts, which meant
   the button said "Copied ✓" while the clipboard was untouched. The async
   Clipboard API is the real one; execCommand stays only as a fallback, and the
   label now tells the truth when both fail. */
/* Announce a result in one line instead of letting a live region read the
   whole document out loud. */
function say(msg){ const el = $('srSay'); if(el) el.textContent = String(msg||''); }
/* Nothing in the app produced a table he could paste into Slack or a deck.
   Tab-separated, so it lands as columns in Slack, Excel and Google Docs. */
async function copyTable(sel, btnId){
  const t = document.querySelector(sel);
  const b = btnId && $(btnId);
  if(!t){ if(b) b.textContent = 'nothing to copy'; return; }
  const rows = [...t.querySelectorAll('tr')].map(tr=>
    [...tr.querySelectorAll('th,td')]
      .map(c=>c.textContent.replace(/\s+/g,' ').trim())
      .join('\t')).filter(Boolean);
  const txt = rows.join('\n');
  const was = b ? b.textContent : '';
  try{
    if(navigator.clipboard && navigator.clipboard.writeText){
      await navigator.clipboard.writeText(txt);
      if(b){ b.textContent = 'Copied ✓'; setTimeout(()=>b.textContent = was, 1500); }
      say(rows.length+' rows copied.');
      return;
    }
    throw new Error('no clipboard api');
  }catch(e){
    if(b){ b.textContent = 'Ctrl+C the table'; setTimeout(()=>b.textContent = was, 2600); }
  }
}
document.addEventListener('click', e=>{
  const b = e.target.closest('[data-copytable]');
  if(!b) return;
  e.stopPropagation();
  copyTable(b.dataset.copytable, b.id);
});
async function copyOut(taId, btnId){
  const ta = $(taId), b = $(btnId);
  if(!ta || !b) return;
  const was = b.textContent;
  const say = (t, ms)=>{ b.textContent = t; setTimeout(()=>{ b.textContent = was; }, ms||1500); };
  const txt = ta.value;
  try{
    if(navigator.clipboard && navigator.clipboard.writeText){
      await navigator.clipboard.writeText(txt);
      return say('Copied ✓');
    }
    throw new Error('no clipboard api');
  }catch(e){
    try{
      ta.focus(); ta.select();
      if(document.execCommand && document.execCommand('copy')) return say('Copied ✓');
      throw new Error('execCommand refused');
    }catch(e2){
      ta.focus(); ta.select();
      say('Press Ctrl+C', 2600);
    }
  }
}
/* Dropdowns used to be populated exactly once, guarded by
   `if(sel.options.length<=1)`. After a partial first load a successful Retry
   never added the missing options, and after a scope switch the account and
   family lists never widened — so the header banner could promise deals the
   filter beneath it could not reach. Rebuild every render, preserving the
   current selection when it is still valid. */
function fillSelect(id, values, placeholder){
  const sel = $(id); if(!sel) return;
  const was = sel.value;
  sel.innerHTML = '<option value="">'+esc(placeholder)+'</option>'+
    values.map(v=>{
      const val = typeof v === 'string' ? v : v.v;
      const lbl = typeof v === 'string' ? v : v.l;
      return '<option value="'+esc(val)+'">'+esc(lbl)+'</option>';
    }).join('');
  /* Keep his choice if it survived the rebuild; otherwise fall back to All
     rather than silently filtering on something no longer in the list. */
  sel.value = [...sel.options].some(o=>o.value===was) ? was : '';
}
function kv(k,v){ return '<div class="kv"><span class="k">'+esc(k)+'</span>'+
  '<span class="v">'+(v==null?'—':v)+'</span></div>'; }
function mime(m){
  if(!m) return 'file';
  if(m.includes('spreadsheet')) return 'Sheet';
  if(m.includes('presentation')) return 'Slides';
  if(m.includes('document')) return 'Doc';
  if(m.includes('folder')) return 'Folder';
  if(m.includes('pdf')) return 'PDF';
  return 'File';
}
function fcTag(c){
  return '<span class="tag '+fcColour(c)+'">'+esc(c||'—')+'</span>';
}
function oppRow(o){
  const overdue = o.CloseDate && o.CloseDate < today;
  const stale = daysAgo(o.LastActivityDate);
  return '<tr>'+
    '<td><strong>'+esc(o.Name)+'</strong><div class="meta">'+esc(o.Account&&o.Account.Name||'')+'</div></td>'+
    '<td style="font-size:11px">'+esc(o.StageName)+'</td>'+
    '<td>'+fcTag(o.ForecastCategoryName)+'</td>'+
    '<td class="num"><strong>'+(specAmt(o)?moneyFull(specAmt(o)):'—')+'</strong></td>'+
    '<td'+(overdue?' style="color:var(--sf-red);font-weight:650"':'')+'>'+fmtDate(o.CloseDate)+
      (overdue?' ⚠':'')+'</td>'+
    '<td style="font-size:11px">'+esc(o.Owner&&o.Owner.Name||'—')+'</td>'+
    '<td style="font-size:11px">'+(stale==null?'<span style="color:var(--sf-red)">never</span>':stale+'d ago')+'</td>'+
  '</tr>';
}

/* =================== RENDER: PIPELINE =================== */
let charts = {};
function renderPipeline(){
  const fams = famRoll().filter(f=>f.opps.length);
  fillSelect('fFam', fams.map(f=>({v:f.slug, l:f.disp})), 'All families');
  fillSelect('fCat', [...new Set(scoped().map(o=>o.ForecastCategoryName).filter(Boolean))].sort(),
             'All forecast categories');
  fillSelect('fAcct',
             [...new Set(scoped().map(o=>o.Account&&o.Account.Name).filter(Boolean))].sort(),
             'All accounts');

  /* scoped(), not a hardcoded isDigital: the header switch changed Today and
     Accounts but left this whole tab byte-identical, under a banner asserting it
     now included other specialists' deals. */
  const live = scoped().filter(isLive);
  /* Every figure on this tab is now the SPECIALIST amount, so the slices and
     the headline reconcile exactly and there is no remainder to explain. */
  const byPort = {};
  /* Only the product roll-up counts toward a product line. Falling back to the
     whole opp Amount for a name-only match double-counted every mixed deal —
     a $1M opp matching two lines added $1M to each, so the slices could sum
     above the Digital Pipeline total printed right next to them. Name-only
     matches are reported separately instead of being silently attributed. */
  /* No remainder any more: digTotal is the sum of specialist amounts, so the
     slices add up to the headline exactly. */
  PORT.forEach(p=>{
    const hits = live.filter(o=>portOf(o).some(x=>x.key===p.key && x.src==='product'));
    byPort[p.label] = {
      key: p.key,
      amt: hits.reduce((t,o)=>t + (p.field ? (Number(o[p.field])||0)
                                           : (Number(o.Amount)||0)), 0),
      n: hits.length,
      rows: hits,
    };
  });
  /* digTotal is the sum of specialist amounts and the slices are the same
     amounts split by product line, so the slices add to the total by
     construction. The "Not yet attributed" remainder is gone because the thing
     it represented — another specialist's share of a shared deal — is no longer
     in his total at all. A dead `sliceTotal` used to assert this and was never
     compared to anything. */
  const digTotal = live.reduce((t,o)=>t+specAmt(o),0);
  /* He is measured on FY27, but the view runs to the April horizon. Split the
     headline so the number he is carried against is the one he reads first. */
  const fyTotal   = live.filter(inThisFY).reduce((t,o)=>t+specAmt(o),0);
  const pastFY    = live.filter(beyondFY);
  const pastFYAmt = pastFY.reduce((t,o)=>t+specAmt(o),0);
  const otherTotal = live.reduce((t,o)=>t+otherAmt(o),0);
  const nonDig = S.opps.filter(isLive).length - live.length;
  const fixQueue = S.opps.filter(isLive).filter(needsProducts);
  /* Clickable: he asked to be able to open each bucket and decide what belongs.
     ptile mirrors the SFR tab's drill tiles, including the chevron and keyboard
     affordance. */
  const ptile = (cls,key,lbl,val,sub)=>
    '<div class="kpi '+cls+' click" data-p="'+key+'" tabindex="0" role="button" '+
    'aria-expanded="'+(PIPE_DRILL===key)+'" title="Open the opportunities in '+
    esc(lbl)+'">'+
    '<div class="lbl">'+esc(lbl)+'</div><div class="val">'+val+'</div>'+
    '<div class="sub">'+esc(sub)+'</div></div>';

  $('pipeKpis').innerHTML =
    /* In the open scope the label says "all specialists", so the number has to
       be the whole deal. It used to sum specAmt under that label, i.e. print his
       own figure twice with two different headings. */
    /* A direct Amount sum, not specAmt + clamp(Amount - specAmt): otherAmt is
       floored at zero, so on a record whose specialist fields exceed Amount the
       two-part sum came out above the real whole-deal figure. */
    ptile('p','all', SCOPE==='digital'?'My pipeline':'All pipeline, all specialists',
        money(SCOPE==='digital' ? digTotal
                                : live.reduce((t,o)=>t+(Number(o.Amount)||0), 0)),
        live.length+' opportunities'+
          (SCOPE==='digital' ? (nonDig?' · '+nonDig+' not mine':'')
                             : ' · '+money(digTotal)+' of it mine'))+
    ptile('g','fy','In FY27', money(fyTotal),
        'closing by '+fmtDate(FY_END)+
        (pastFYAmt ? ' · '+money(pastFYAmt)+' lands FY28' : ' · all of it'))+
    PORT.map((p,i)=>{ const b = byPort[p.label];
      return ptile(portTag(p.key)==='active'?'':portTag(p.key)==='teal'?'t':
                   portTag(p.key)==='g'?'g':'p', p.key, p.label, money(b.amt),
        b.n+' opportunit'+(b.n===1?'y':'ies')); }).join('');
  $('pipeDrillNote').innerHTML = truncNote() + dropNote() +
    /* The tiles are built from `live`; the table below is built from the filter
       row. Filter to one family and the two disagree, and nothing on screen used
       to say why. */
    '<div class="note">The tiles above cover your whole in-scope book. The filters '+
      'below only narrow the table and the chart &mdash; the tiles do not change.</div>'+
    '<div class="note">These are <strong>your</strong> amounts, not the whole deal. '+
    'Marketing Cloud, Data 360 and Agentforce come from the specialist fields on '+
    'each opportunity; Signature Success is the full plan value. '+
    (otherTotal>0
      ? 'A further <strong>'+money(otherTotal)+'</strong> across the same deals is '+
        'Sales, Service, Platform or industry cloud &mdash; that belongs to the core AE '+
        'and is deliberately not counted here.'
      : '')+
    ' Closing after '+fmtDate(HORIZON)+' is out of view.'+
    (fixQueue.length
      ? ' <strong>'+fixQueue.length+' opportunit'+(fixQueue.length===1?'y':'ies')+
        '</strong> read as yours by name but carry no specialist amount &mdash; '+
        'listed at the bottom, not counted.'
      : '')+'</div>';

  /* The primary chart's dimension is whatever you picked. Each slice keeps its
     raw label so clicking it can filter the table exactly. */
  /* Falls back to 'stage'. A browser restoring a stale select value across a
     soft reload — or a new option added without a DIMS entry — used to make
     DIMS[dim].f throw and blank the entire Pipeline tab. */
  const DIMS = {
    stage:   {t:'My pipeline by stage',            f:o=>o.StageName||'—'},
    product: {t:'My pipeline by product line',     f:null},
    cat:     {t:'My pipeline by forecast category',f:o=>o.ForecastCategoryName||'—'},
    acct:    {t:'My pipeline by account',          f:o=>(o.Account&&o.Account.Name)||'—'},
  };
  const rawDim = $('fView') ? $('fView').value : 'stage';
  const dim = Object.prototype.hasOwnProperty.call(DIMS, rawDim) ? rawDim : 'stage';
  if(dim !== rawDim && $('fView')) $('fView').value = dim;
  let pairs;
  if(dim === 'product'){
    pairs = PORT.map(p=>[p.label, byPort[p.label].amt]).filter(x=>x[1]>0);
  } else {
    const agg = {};
    live.forEach(o=>{ const k = DIMS[dim].f(o);
      agg[k] = (agg[k]||0) + specAmt(o); });
    pairs = Object.entries(agg).sort((a,b)=>b[1]-a[1]).slice(0,10);
  }
  drawChart('chStage','bar',pairs,DIMS[dim].t,dim);
  /* "Not yet attributed" is digTotal minus the sum of the slices, so the
     doughnut always adds up to the Digital Pipeline tile beside it — including
     the non-Digital portion of a mixed deal, which the old version dropped. */
  /* Keyed by label via drawChart's colourFor, so filtering a zero line out no
     longer shifts every remaining slice to a different colour. */
  drawChart('chFam','doughnut',
    PORT.map(p=>[p.label,byPort[p.label].amt])
        .filter(x=>x[1]>0),
    'Share of my pipeline by product line','product');
  /* count owned by navCounts() */
  renderBucket(live, byPort);
  renderFixQueue(fixQueue);
  renderDrill();
  applyFilters();
}

/* ── Bucket drill-down ───────────────────────────────────────────────────
   He asked to click a tile and see exactly which opportunities are inside it,
   so he can decide whether each one belongs. Every row shows his amount, the
   core AE's share, and a link to the record. */
let PIPE_DRILL = null;
function renderBucket(live, byPort){
  const box = $('pipeBucket'); if(!box) return;
  if(!PIPE_DRILL){ box.innerHTML = ''; return; }
  const p = PORT.find(x=>x.key===PIPE_DRILL);
  /* Fail shut, not throw. A drill key with no matching PORT entry — a stale
     value, or a tile added without a port — used to read p.label off undefined
     and take the whole Pipeline tab down with it. */
  if(PIPE_DRILL !== 'all' && PIPE_DRILL !== 'fy' && !p){
    PIPE_DRILL = null; box.innerHTML = ''; return;
  }
  const rows = PIPE_DRILL === 'all' ? live.slice()
    : PIPE_DRILL === 'fy'            ? live.filter(inThisFY)
    : byPort[p.label]                ? byPort[p.label].rows.slice() : [];
  const label = PIPE_DRILL === 'all' ? 'My pipeline'
              : PIPE_DRILL === 'fy'  ? 'Closing inside FY27' : p.label;
  const amtFor = o => (PIPE_DRILL === 'all' || PIPE_DRILL === 'fy') ? specAmt(o)
    : (p.field ? (Number(o[p.field])||0) : (Number(o.Amount)||0));
  rows.sort((a,b)=>amtFor(b)-amtFor(a));
  const BCAP = 60;

  box.innerHTML =
    '<div class="card" style="margin-bottom:14px">'+
      '<h3>'+esc(label)+' &mdash; '+rows.length+' opportunit'+(rows.length===1?'y':'ies')+
        (rows.length > BCAP ? ' <span class="chip">largest '+BCAP+' listed</span>' : '')+
        ' <span class="chip">'+money(rows.reduce((t,o)=>t+amtFor(o),0))+' total</span>'+
        '<button class="btn sm ghost" id="pbClose" style="float:right">Close</button></h3>'+
      '<div class="meta" style="margin:5px 0 10px">Everything counted in this tile. '+
        'If something here is not yours, the fix is on the record: clear the '+
        'specialist amount in Salesforce and it leaves this view.</div>'+
      (rows.length
        ? '<div class="tw"><table><thead><tr>'+
            '<th>Opportunity</th><th>Account</th><th>Stage</th>'+
            '<th class="num">My amount</th><th class="num">Core AE share</th>'+
            '<th>Close</th><th>Owner</th>'+
          '</tr></thead><tbody>'+
          rows.slice(0,BCAP).map(o=>'<tr>'+
            '<td><a href="'+SF_URL+'Opportunity/'+idAttr(o.Id)+'/view" target="_blank" '+
              'rel="noopener noreferrer">'+esc(o.Name)+' ↗</a>'+
              (isSuccessPlan(o)?' <span class="tag g">Signature Success</span>':'')+
              '<div style="margin-top:4px">'+portOf(o).filter(x=>x.src==='product')
                .map(x=>'<span class="tag '+portTag(x.key)+'">'+esc(x.label)+'</span>').join(' ')+'</div></td>'+
            '<td style="font-size:11.5px">'+esc((o.Account&&o.Account.Name)||'—')+'</td>'+
            '<td style="font-size:11px">'+esc(o.StageName||'')+'</td>'+
            /* Table cells use moneyFull: these are rows a reader adds up. */
            '<td class="num"><strong>'+moneyFull(amtFor(o))+'</strong></td>'+
            '<td class="num" style="color:var(--ink-3)">'+
              (otherAmt(o)>0?moneyFull(otherAmt(o)):'—')+'</td>'+
            '<td style="font-size:11.5px">'+fmtDate(o.CloseDate)+
              (beyondFY(o)?'<div class="meta">past FY27</div>':'')+'</td>'+
            '<td style="font-size:11px">'+esc((o.Owner&&o.Owner.Name)||'—')+
              (isCoreAE(o.Owner&&o.Owner.Name)?'':' <span class="tag grey">not a core AE</span>')+
            '</td></tr>').join('')+
          '</tbody></table></div>'
        : '<div class="empty">Nothing in this bucket.</div>')+
    '</div>';
  const c = $('pbClose');
  if(c) c.onclick = ()=>{ PIPE_DRILL = null; renderPipeline(); };
  box.scrollIntoView({behavior:'smooth', block:'nearest'});
}
/* Delegated once. */
(function(){
  const k = $('pipeKpis'); if(!k) return;
  const hit = e=>{
    const t = e.target.closest('[data-p]'); if(!t) return;
    PIPE_DRILL = (PIPE_DRILL === t.dataset.p) ? null : t.dataset.p;
    renderPipeline();
  };
  k.addEventListener('click', hit);
  k.addEventListener('keydown', e=>{
    if(e.key==='Enter'||e.key===' '){ e.preventDefault(); hit(e); }
  });
})();

/* ── The fix queue ───────────────────────────────────────────────────────
   Opportunities whose NAME reads as Marketing Cloud, Data 360 or Agentforce but
   which carry no specialist amount. They are not pipeline — they are a
   data-quality problem, and the reason they used to inflate his number. */
function renderFixQueue(rows){
  const box = $('fixQueueBox'); if(!box) return;
  if($('fixCount')) $('fixCount').textContent = rows.length || '';
  if(!rows.length){
    box.innerHTML = '<div class="card"><div class="empty">Every opportunity that '+
      'reads as yours carries a specialist amount. Nothing to fix.</div></div>';
    return;
  }
  box.innerHTML =
    '<div class="note warn">These read as yours by name but have <strong>no '+
      'specialist amount</strong> on the record, so they are excluded from every '+
      'figure above. Either attach the products, or they are not yours. Until one '+
      'of those happens they do not roll up for you or for anyone.</div>'+
    '<div class="tbl-wrap"><table><thead><tr>'+
      '<th>Opportunity</th><th>Account</th><th>Reads as</th>'+
      '<th class="num">Whole deal</th><th>Close</th><th>Owner</th>'+
    '</tr></thead><tbody>'+
    rows.slice(0,25).map(o=>'<tr>'+
      '<td><a href="'+SF_URL+'Opportunity/'+idAttr(o.Id)+'/view" target="_blank" '+
        'rel="noopener noreferrer">'+esc(o.Name)+' ↗</a></td>'+
      '<td style="font-size:11.5px">'+esc((o.Account&&o.Account.Name)||'—')+'</td>'+
      /* Grey, not purple: purple is Agentforce in PORT_TAG, and the whole point
         of this table is that the product line is UNCONFIRMED. */
      '<td>'+portOf(o).filter(x=>x.src==='name')
        .map(x=>'<span class="tag grey">'+esc(x.label)+' ?</span>').join(' ')+'</td>'+
      '<td class="num" style="color:var(--ink-3)">'+
        (Number(o.Amount)?money(o.Amount):'—')+'</td>'+
      '<td style="font-size:11.5px">'+fmtDate(o.CloseDate)+'</td>'+
      '<td style="font-size:11px">'+esc((o.Owner&&o.Owner.Name)||'—')+'</td>'+
    '</tr>').join('')+
    '</tbody></table></div>'+
    (rows.length>25?'<div class="meta" style="margin-top:7px">Showing 25 of '+
      rows.length+'.</div>':'');
}

/* ---- Chart drill-down -------------------------------------------------
   Clicking a bar or slice filters the table below to just that group. */
let DRILL = null;                        // {dim, val}
function renderDrill(){
  const box = $('drillBox'); if(!box) return;
  box.innerHTML = DRILL
    ? '<span class="row" style="gap:7px"><span class="tag active">Showing only: '+
      esc(DRILL.val)+'</span><button class="btn sm ghost" id="drillClear">Reset to all</button></span>'
    : '';
  if($('drillClear')) $('drillClear').onclick = ()=>{ DRILL = null; renderPipeline(); };
}
function matchDrill(o){
  if(!DRILL) return true;
  switch(DRILL.dim){
    case 'stage':   return (o.StageName||'—') === DRILL.val;
    case 'cat':     return (o.ForecastCategoryName||'—') === DRILL.val;
    case 'acct':    return ((o.Account&&o.Account.Name)||'—') === DRILL.val;
    case 'product': return portOf(o).some(p=>p.label === DRILL.val);
  }
  return true;
}
function drawChart(id,type,pairs,title,dim){
  const cv = $(id); if(!cv) return;
  /* Chart.js comes from a CDN. Without this guard a blocked/offline/SRI-drifted
     load threw here, which aborted the rest of renderPipeline() and left the
     opportunity table permanently empty with no error on screen. */
  if(typeof Chart === 'undefined'){
    /* A sibling, NOT parentNode.innerHTML — overwriting the parent removed the
       <canvas>, so when the async CDN script finally landed and chartReady
       repainted, $(id) was null and no chart ever appeared until a manual
       Reload. Chart.js is loaded `async`, so this branch is hit on a normal
       fast load, not only when the CDN is blocked. */
    if(cv.parentNode && !cv.parentNode.querySelector('.chartWait')){
      const w = document.createElement('div');
      w.className = 'note warn chartWait';
      w.style.margin = '0';
      w.textContent = 'Charts still loading — every number and table on this '+
        'page already works without them.';
      cv.parentNode.insertBefore(w, cv);
    }
    return;
  }
  const wait = cv.parentNode && cv.parentNode.querySelector('.chartWait');
  if(wait) wait.remove();
  if(charts[id]){ try{ charts[id].destroy(); }catch(e){} }
  const dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
  const PAL  = ['#0176D3','#06A59A','#9050E9','#FE9339','#2E844A','#FF538A','#0B5CAB','#EA001E','#8A8B90'];
  /* Product lines get a fixed colour keyed by NAME, so filtering out a zero
     line no longer shifts every other slice to a different colour between
     loads. Everything else falls back to positional. */
  const FIXED = {'Marketing Cloud':'#0176D3','Data 360':'#06A59A',
                 'Agentforce':'#9050E9','Signature Success':'#2E844A'};
  const colourFor = (lbl,i)=>FIXED[lbl] || PAL[i%PAL.length];
  const ink3 = dark ? '#8A8B93' : '#8A8B90';
  const grid = dark ? 'rgba(255,255,255,.07)' : 'rgba(0,22,57,.06)';
  const raw  = pairs.map(p=>p[0]);            // untruncated, for drill-down

  /* Selected group stays saturated; the rest fade back. */
  const colour = (i)=>{
    const base = type==='bar' ? '#0176D3' : colourFor(pairs[i] && pairs[i][0], i);
    if(DRILL && DRILL.dim===dim && raw[i]!==DRILL.val) return base+'33';
    return base;
  };

  charts[id] = new Chart(cv,{
    type,
    data:{
      labels: raw.map(l=>l.length>22 ? l.slice(0,21)+'…' : l),
      datasets:[{
        data: pairs.map(p=>p[1]),
        backgroundColor: pairs.map((_,i)=>colour(i)),
        hoverBackgroundColor: pairs.map((_,i)=>type==='bar'?'#0268BC':PAL[i%PAL.length]),
        borderRadius: type==='bar' ? 7 : 0,
        borderWidth: type==='bar' ? 0 : 2.5,
        borderColor: dark ? '#17181D' : '#fff',
        maxBarThickness: 64,
      }]},
    options:{
      responsive:true, maintainAspectRatio:false,
      animation:{duration:420, easing:'easeOutQuart'},
      onHover:(e,els)=>{ e.native.target.style.cursor = els.length ? 'pointer' : 'default'; },
      onClick:(e,els)=>{
        if(!dim || !els.length) return;
        const val = raw[els[0].index];
        DRILL = (DRILL && DRILL.dim===dim && DRILL.val===val) ? null : {dim, val};
        renderPipeline();                     // redraw both charts + table
      },
      plugins:{
        legend:{display:type!=='bar',position:'right',
          labels:{boxWidth:10,boxHeight:10,usePointStyle:true,pointStyle:'circle',
            color:ink3,font:{size:11.5,family:'-apple-system,system-ui,sans-serif'}}},
        title:{display:true,text:title,align:'start',
          font:{size:13,weight:'600',family:'-apple-system,system-ui,sans-serif'},
          color:dark?'#F2F2F5':'#1A1A1C',padding:{bottom:14}},
        tooltip:{
          backgroundColor:dark?'rgba(40,41,48,.96)':'rgba(26,26,28,.94)',
          padding:11,cornerRadius:10,displayColors:false,
          titleFont:{size:12.5,weight:'600'},bodyFont:{size:12.5},
          callbacks:{
            title:c=>raw[c[0].dataIndex],
            label:c=>money(c.raw)+(dim?'  ·  click to filter':''),
          }},
      },
      scales: type==='bar' ? {
        y:{ticks:{callback:v=>money(v),font:{size:11},color:ink3,padding:6},
           grid:{color:grid,drawTicks:false},border:{display:false}},
        x:{ticks:{font:{size:11},color:ink3,maxRotation:36,minRotation:0,autoSkip:false},
           grid:{display:false},border:{display:false}},
      } : {}
    }
  });
}
/* Four dropdowns, two checkboxes and a chart drill can all be narrowing the
   table at once. Without this it was possible to stare at an empty table and
   not know which of seven controls was responsible. */
const PIPE_DEFAULTS = {fDig:'digital', fFam:'', fAcct:'', fCat:''};
function pipeFilterCount(){
  let n = 0;
  for(const id in PIPE_DEFAULTS){ const el=$(id); if(el && el.value !== PIPE_DEFAULTS[id]) n++; }
  if($('fReal') && $('fReal').checked) n++;
  if($('fZomb') && $('fZomb').checked) n++;
  if(DRILL) n++;
  return n;
}
function clearPipeFilters(){
  for(const id in PIPE_DEFAULTS){ const el=$(id); if(el) el.value = PIPE_DEFAULTS[id]; }
  if($('fReal')) $('fReal').checked = false;
  if($('fZomb')) $('fZomb').checked = false;
  DRILL = null;
  renderPipeline();
}
function applyFilters(){
  const fam=$('fFam').value, cat=$('fCat').value, real=$('fReal').checked;
  const showZ = $('fZomb').checked;
  const dig = $('fDig') ? $('fDig').value : 'all';
  let rows = showZ ? S.opps.slice() : S.opps.filter(isLive);
  const acct = $('fAcct') ? $('fAcct').value : '';
  const nFilt = pipeFilterCount();
  if($('fClear')){
    $('fClear').style.display = nFilt ? 'inline-flex' : 'none';
    $('fClear').textContent = 'Clear '+nFilt+' filter'+(nFilt===1?'':'s');
  }
  if(dig==='digital')      rows = rows.filter(isDigital);
  else if(dig==='product') rows = rows.filter(digitalByProduct);
  /* src==='product': a name-only match has no amount, so including it put rows
     in the table that the KPI tile above counted as $0. */
  else if(dig!=='all')     rows = rows.filter(o=>
    portOf(o).some(p=>p.key===dig && p.src==='product'));
  if(fam) rows = rows.filter(o=>famOfOpp(o).slug===fam);
  if(acct) rows = rows.filter(o=>(o.Account&&o.Account.Name)===acct);
  if(cat) rows = rows.filter(o=>o.ForecastCategoryName===cat);
  if(real) rows = rows.filter(realOpp);
  rows = rows.filter(matchDrill);          // chart click narrows the table
  rows.sort((a,b)=>specAmt(b)-specAmt(a));
  /* Every other list in this app caps at 40; this one rendered all of them —
     up to 400 rows, ~460KB of innerHTML, ~9,200 nodes and 800 handler closures,
     reparsed on every filter change and chart click. */
  const CAP = 60;
  const shown = rows.slice(0, CAP);
  $('pipeBody').innerHTML = shown.map(o=>{
    const f = famOfOpp(o);
    const overdue = o.CloseDate && o.CloseDate<today;
    const stale = daysAgo(o.LastActivityDate);
    const ports = portOf(o);
    const sfr = SFR_BY_OPP().get(o.Id);
    /* No role="button" on a <tr> — it overrides role="row" and detaches the
       eight cells from their headers in the accessibility tree, on the widest
       table in the app. tabindex + aria-expanded give the keyboard behaviour
       without lying about what the element is. */
    return '<tr class="ex" data-o="'+idAttr(o.Id)+'" tabindex="0" '+
      'aria-expanded="false"'+(isZombie(o)?' style="opacity:.55"':'')+'>'+
      '<td><span class="caret">▸</span> <strong>'+esc(o.Name)+'</strong>'+
      (bucketOf(o)?' <span class="tag '+(isL1(o)?'active':'grey')+'" '+
        'title="'+(isL1(o)?'Bucket L1 — Marketing Cloud, your primary line. Needs an SFR.'
                          :'Bucket L2 — Data 360 / Agentforce. No SFR required.')+'">'+
        bucketOf(o)+'</span>':'')+
      (isZombie(o)?' <span class="tag risk">zombie</span>':'')+
      (isL1(o)&&!sfr&&realOpp(o)?(SFR_KNOWN()
        ? ' <span class="tag risk">no SFR</span>'
        : ' <span class="tag grey" title="SFR data did not load — cannot verify">SFR unknown</span>'):'')+
      '<div class="meta">'+esc(o.Account&&o.Account.Name||'')+'</div>'+
      (ports.length?'<div style="margin-top:5px">'+ports.map(p=>
        '<span class="tag '+portTag(p.key)+'" '+
        'title="'+(p.src!=='product' ? 'Name match only — no products attached'
                   : p.key==='sig' ? 'The full plan value from the opportunity: '+money(p.amt)
                   : 'From the specialist product roll-up: '+money(p.amt))+'">'+
        esc(p.label)+(p.src==='name'?' ?':'')+'</span>').join(' ')+'</div>':'')+
      '</td>'+
      '<td><span class="tag '+f.tier+'">'+esc(f.disp)+'</span></td>'+
      '<td style="font-size:11px">'+esc(o.StageName)+'</td>'+
      '<td>'+fcTag(o.ForecastCategoryName)+'</td>'+
      /* His amount is the headline; the core AE's share is shown underneath as
         context so a shared deal reads honestly instead of looking small. */
      '<td class="num"><strong>'+(specAmt(o)?moneyFull(specAmt(o)):'—')+'</strong>'+
        (otherAmt(o)>0?'<div class="meta">+'+money(otherAmt(o))+' core</div>':'')+'</td>'+
      '<td'+(overdue?' style="color:var(--sf-red);font-weight:650"':'')+'>'+fmtDate(o.CloseDate)+(overdue?' ⚠':'')+'</td>'+
      '<td style="font-size:11px">'+esc(o.Owner&&o.Owner.Name||'—')+'</td>'+
      '<td style="font-size:11px">'+(stale==null?'<span style="color:var(--sf-red)">never</span>':stale+'d')+'</td></tr>'+
      /* Detail row is EMPTY until clicked — building it eagerly for every row
         put 351KB of display:none HTML and ~9,200 invisible DOM nodes into the
         page. Populated by oppDetail() on expand, same pattern as the
         stakeholder panel. */
      '<tr class="exd" id="d-'+idAttr(o.Id)+'" style="display:none"><td colspan="8"></td></tr>';
  }).join('') +
    (rows.length > CAP
      ? '<tr><td colspan="8" class="meta" style="padding:11px 14px">Showing the '+
        CAP+' largest of '+rows.length+'. Narrow the filters to see the rest.</td></tr>'
      : '') ||
    '<tr><td colspan="8" class="empty">Nothing matches '+
      (nFilt ? 'the '+nFilt+' filter'+(nFilt===1?'':'s')+' you have on. '+
               'Use <strong>Clear '+nFilt+' filter'+(nFilt===1?'':'s')+'</strong> above to see everything.'
             : 'this view.')+'</td></tr>';

  $('pipeCount').textContent = rows.length > CAP
    ? CAP+' of '+rows.length : rows.length+' shown';
  /* When the drill is a product line, sum THAT line rather than each deal's full
     amount — otherwise clicking a $200K slice printed "Sum: $1,000,000". */
  /* Sum the line actually being looked at — whether it was chosen by clicking
     a chart slice or by the product dropdown. */
  const drillPort = (DRILL && DRILL.dim==='product'
      ? PORT.find(p=>p.label===DRILL.val) : null)
    || (dig && dig!=='all' && dig!=='digital' && dig!=='product'
      ? PORT.find(p=>p.key===dig) : null);
  /* textContent, so no escaping — esc() here would render &amp; literally. */
  /* The tiles above are computed over live opps only, so say when the table
     below includes zombies. */
  const zombIn = $('fZomb') && $('fZomb').checked;
  $('pipeSum').textContent = (drillPort ? drillPort.label+': '
                              : zombIn ? 'Total incl. zombies: ' : 'My total: ')+
    money(rows.reduce((s,o)=>s+(drillPort
      ? (drillPort.field ? (Number(o[drillPort.field])||0) : (Number(o.Amount)||0))
      : specAmt(o)),0));
  S.pipeRows = rows;
}
/* One delegated listener instead of two closures per row. Registered once, at
   parse time, so repaints do not stack handlers. */
function togglePipeRow(tr){
  if(!tr) return;
  const d = $('d-'+tr.dataset.o); if(!d) return;
  const isOpen = d.style.display !== 'none';
  if(!isOpen && !d.dataset.built){
    d.firstChild.innerHTML = oppDetail((S.pipeRows||[]).find(x=>x.Id===tr.dataset.o));
    d.dataset.built = '1';
  }
  d.style.display = isOpen ? 'none' : 'table-row';
  tr.setAttribute('aria-expanded', String(!isOpen));
  const c = tr.querySelector('.caret'); if(c) c.textContent = isOpen ? '▸' : '▾';
}
(function(){
  const body = $('pipeBody'); if(!body) return;
  body.addEventListener('click', e=>{
    if(e.target.closest('a') || e.target.closest('button')) return;
    togglePipeRow(e.target.closest('tr.ex'));
  });
  body.addEventListener('keydown', e=>{
    if(e.key!=='Enter' && e.key!==' ') return;
    const tr = e.target.closest('tr.ex'); if(!tr) return;
    e.preventDefault(); togglePipeRow(tr);
  });
})();

