    '<div class="adv-grid">'+
      HPF_MANUAL.map(x=>{
        const cur = M[x.k];
        if(x.kind === 'pct')
          return '<label for="hpf-'+esc(x.k)+'">'+esc(x.label)+
            '<input id="hpf-'+esc(x.k)+'" type="number" min="0" max="100" '+
