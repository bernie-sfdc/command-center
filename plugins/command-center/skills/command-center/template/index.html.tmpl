/* =================== MARKETING POV =================== */
/* Content comes from POV_DATA, condensed from the operator's Drive docs, Slack
   channels and canvases. Every item carries its source. Nothing is invented
   here, and figures marked DO-NOT-USE are never shown as usable. */
/* POV_DATA is ~200KB — 36% of this file. As an object literal the JS parser
   had to walk all of it before a single line of the app ran, and only two
   small fields (_meta.caveats and coreAE) are read at load. It is now a string
   parsed on first use, which moves the cost off first paint. */
let _pd = null, _pdErr = null;
/* Declared here, beside _pd, because PDget's catch writes them — they used to
   live ~700 lines further down, which is only safe because nothing touches PD
   during script evaluation. Not a live bug; a trap for the next edit. */
let _povK = null, _povN = null;
function PDget(){
  if(_pd) return _pd;
  try{
    _pd = (typeof POV_DATA === 'string') ? JSON.parse(POV_DATA)
        : (typeof POV_DATA !== 'undefined' && POV_DATA) ? POV_DATA : {};
  }catch(e){ _pd = {}; _povK = null; _povN = 0; _pdErr = e.message;
             console.error('[pov] could not parse: '+e.message); }
  return _pd;
}
const PD = new Proxy({}, {
  get:(_,k)=>PDget()[k],
  has:(_,k)=>k in PDget(),
  ownKeys:()=>Reflect.ownKeys(PDget()),
  getOwnPropertyDescriptor:(_,k)=>
    Object.getOwnPropertyDescriptor(PDget(), k) ||
    {configurable:true, enumerable:true, value:PDget()[k]},
});

/* the operator is the Digital specialist ON someone else's accounts, so "whose
   account is this" is a question he asks constantly. It was buried in the POV
   tab; surface it wherever an account appears. */
function coreAeOf(slug){ return (PD[slug] && PD[slug].coreAE) || null; }
function coreAeTag(slug){
  const n = coreAeOf(slug);
  return n ? ' <span class="tag grey" title="Core AE on this account — agree any '+
    'opportunity change with them first">Core: '+esc(n)+'</span>' : '';
}

let POV_BUILT = false;
/* Lazy. This used to run at top level and call Object.keys(PD) twice, each of
   which trips the Proxy's ownKeys trap and forces the whole ~200KB parse before
   the first network call. It now runs on the first paint of the POV tab. Note
   that coreAeOf() also touches PD, so opening Accounts forces the parse anyway
   — the deferral only helps a session that never goes near either. */
function buildPov(){
  if(POV_BUILT) return;
  POV_BUILT = true;
  const keys = povKeys();
  fillSelect('pvAcct', keys.map(k=>({v:k, l:PDget()[k].disp || k})),
             '— pick an account —');
  /* Wrapped: a throw in here used to be console-only, because this handler is
     outside the paint path that safely() guards. */
  if($('pvGo')) $('pvGo').onclick = ()=>safely('pov', renderPov);
  /* A parse failure used to render an empty picker with no explanation — the
     embedded data is the whole point of this tab, so say it plainly. */
  if(_pdErr){
    if($('pvGo')) $('pvGo').disabled = true;
    if($('povNote')) $('povNote').innerHTML = '<div class="note err">'+
      '<strong>The embedded strategy data did not parse.</strong> '+esc(_pdErr)+
      ' &mdash; this tab and the unusable-figure check on every draft are both '+
      'unavailable until that is fixed in the file. Verify any number you use '+
      'against Org62 directly.</div>';
    return;
  }
  const n = keys.length;
  /* count owned by navCounts() */
  if($('povNote')){
    const cav = (PD._meta && PD._meta.caveats) || [];
    $('povNote').innerHTML = n
      ? '<div class="note">Built from '+n+' accounts of your own strategy work &mdash; Drive documents, '+
        'Slack channels and canvases, cross-checked against Org62. Every claim shows its source. '+
        'Figures the source documents themselves flagged as unreliable are marked and never reused.</div>'+
        /* This used to render cav.slice(0,5) under a heading promising "read
           once before you use any of this" — and the hidden ones included the
           rule that commercial figures must never reach a customer-facing deck.
           A banner that promises completeness and delivers a third of it is
           worse than no banner. All of them, with a truthful count. */
        (cav.length?'<div class="note warn"><strong>Read these '+cav.length+
          ' cautions before any of this goes near a customer.</strong>'+
          '<ul style="margin:6px 0 0;padding-left:18px;line-height:1.6">'+
          cav.slice(0,5).map(c=>'<li>'+esc(c)+'</li>').join('')+'</ul>'+
          (cav.length>5
            ? '<details style="margin-top:7px"><summary style="cursor:pointer;'+
              'font-weight:600;font-size:12px">The other '+(cav.length-5)+
              ' &mdash; open before a customer call</summary>'+
              '<ul style="margin:7px 0 0;padding-left:18px;line-height:1.6">'+
              cav.slice(5).map(c=>'<li>'+esc(c)+'</li>').join('')+'</ul></details>'
            : '')+
          '</div>':'')
      : '<div class="note err">No POV data is embedded. The research file did not load.</div>';
  }
}

function srcChip(s){ return s ? '<span class="src">'+esc(String(s).slice(0,80))+'</span>' : ''; }

function renderPov(){
  const k = $('pvAcct').value;
  const a = PD[k];
  if(!a){ $('povBody').innerHTML = '<div class="card"><div class="empty">Pick an account.</div></div>'; return; }
  const aud = $('pvAud').value, goal = $('pvGoal').value;

  const f = famRoll().find(x=>x.slug===k);
  const opps = f ? f.opps.filter(realOpp).sort((x,y)=>specAmt(y)-specAmt(x)).slice(0,6) : [];
  const sfrs = (S.sfrs||[]).filter(s=>famOf(s.Account_Name__c).slug===k && sfrOpen(s));

  const bad = (a.metrics||[]).filter(m=>m.v==='DO-NOT-USE');
  const good = (a.metrics||[]).filter(m=>m.v==='verified');
  const soft = (a.metrics||[]).filter(m=>m.v==='unverified');

  $('pvSrc').textContent = (a.sources||[]).length+' sources · '+
    good.length+' verified figures · '+bad.length+' unusable';

  const sec = (t,body,open)=>'<details'+(open?' open':'')+'><summary>'+t+'</summary>'+
    '<div class="body">'+body+'</div></details>';
  const list = (arr,fn)=>arr.length
    ? '<ul style="margin:0;padding-left:17px;line-height:1.7;font-size:12px">'+
      arr.map(fn).join('')+'</ul>'
    : '<div class="meta">Nothing sourced yet — this is a discovery gap.</div>';

  $('povBody').innerHTML =
    '<div class="card"><div class="row" style="flex-wrap:wrap;margin-bottom:4px">'+
      '<h3 style="margin:0">'+esc(a.disp)+'</h3>'+
      '<span class="tag active">'+esc(segFor(a.seg).label||'')+'</span>'+
      (a.coreAE?'<span class="tag grey">Core AE: '+esc(a.coreAE)+'</span>':'')+
      '<span class="sp"></span>'+
      '<button class="btn sm" id="pvWrite">Write the POV narrative</button>'+
    '</div>'+
    (a.state?'<div class="meta" style="margin-top:6px">'+esc(a.state)+'</div>':'')+
    '</div>'+

    /* Retired figures are kept out of the way, not deleted — you still need to
       recognise one if a colleague repeats it. Collapsed by default. */
    (bad.length?'<details style="margin-top:11px"><summary style="color:var(--sf-red)">'+
      'Retired &mdash; do not use with the customer <span class="chip">'+bad.length+'</span></summary>'+
      '<div class="body"><ul style="margin:0;padding-left:18px;line-height:1.7;font-size:12px">'+
      bad.map(m=>'<li><strong>'+esc(m.m)+'</strong> — '+esc(m.note||'flagged unreliable at source')+
        ' '+srcChip(m.src)+'</li>').join('')+'</ul></div></details>':'')+

    '<div class="sec">What we know</div>'+
    sec('Their priorities <span class="chip">'+(a.priorities||[]).length+'</span>',
      list(a.priorities||[], p=>'<li>'+esc(p)+'</li>'), true)+
    sec('Problems, in their language <span class="chip">'+(a.problems||[]).length+'</span>',
      list(a.problems||[], p=>'<li><strong>'+esc(p.t)+'</strong> — '+esc(p.d)+' '+srcChip(p.src)+'</li>'), true)+
    sec('What happens if nothing changes',
      a.consequence ? '<p style="font-size:12.5px;line-height:1.7">'+esc(a.consequence)+'</p>'
        : '<div class="meta">Not yet written for this account. This is the part that moves budget — '+
          'draft it before the next conversation.</div>', true)+
    sec('Market shifts working in your favour <span class="chip">'+(a.trends||[]).length+'</span>',
      list(a.trends||[], t=>'<li>'+esc(t)+'</li>'))+
    sec('Objections already raised <span class="chip">'+(a.objections||[]).length+'</span>',
      list(a.objections||[], o=>'<li>“'+esc(o.o)+'” '+srcChip(o.src)+'</li>'))+
    sec('Incumbent stack',
      (a.incumbents||[]).length
        ? '<div class="row" style="flex-wrap:wrap">'+(a.incumbents||[]).map(i=>
            '<span class="tag grey">'+esc(i)+'</span>').join('')+'</div>'+
          '<div class="meta" style="margin-top:7px">Position on top of these, never against them.</div>'
        : '<div class="meta">Unknown — worth asking.</div>')+

    '<div class="sec">What to sell</div>'+
    sec('Products that fit <span class="chip">'+(a.products||[]).length+'</span>',
      list(a.products||[], p=>'<li><strong>'+esc(p.n)+'</strong> — '+esc(p.why)+' '+srcChip(p.src)+'</li>'), true)+
    sec('Use cases <span class="chip">'+(a.usecases||[]).length+'</span>',
      list(a.usecases||[], u=>'<li><strong>'+esc(u.n)+'</strong> — '+esc(u.d)+' '+srcChip(u.src)+'</li>'))+
    sec('Figures you can actually use <span class="chip">'+good.length+'</span>',
      good.length
        ? list(good, m=>'<li><strong>'+esc(m.m)+'</strong> '+srcChip(m.src)+'</li>')+
          (soft.length?'<div class="meta" style="margin-top:8px"><strong>'+soft.length+
            ' more are unverified</strong> — usable internally, not with the customer: '+
            soft.slice(0,6).map(m=>esc(m.m)).join(' · ')+'</div>':'')
        : '<div class="note warn">No verified figures on this account. Do not put a number in front '+
          'of this customer until one is sourced.</div>')+

    '<div class="sec">Who</div>'+
    sec('Stakeholders on record <span class="chip">'+(a.stakeholders||[]).length+'</span>',
      list(a.stakeholders||[], s=>'<li><strong>'+esc(s.n)+'</strong>'+
        (s.t?' — '+esc(s.t):'')+(s.role?' <span class="tag grey">'+esc(s.role)+'</span>':'')+
        ' '+srcChip(s.src)+'</li>'), true)+

    '<div class="sec">Live in Org62</div>'+
    '<div class="card">'+
      (opps.length?'<div class="tw"><table><thead><tr><th>Opportunity</th><th>Stage</th>'+
        '<th class="num">Amount</th><th>Close</th><th>Owner</th></tr></thead><tbody>'+
        opps.map(o=>'<tr><td><a href="'+SF_URL+'Opportunity/'+idAttr(o.Id)+'/view" target="_blank" '+
          'rel="noopener noreferrer">'+esc(o.Name.slice(0,62))+' ↗</a></td>'+
          '<td style="font-size:11px">'+esc(o.StageName)+'</td>'+
          '<td class="num">'+moneyFull(specAmt(o))+'</td><td>'+fmtDate(o.CloseDate)+'</td>'+
          '<td style="font-size:11px">'+esc(o.Owner&&o.Owner.Name||'')+'</td></tr>').join('')+
        '</tbody></table></div>':'<div class="empty">No open Digital opportunities.</div>')+
      (sfrs.length?'<div class="meta" style="margin-top:9px"><strong>Your open SFRs:</strong> '+
        sfrs.map(s=>'<a href="'+SF_URL+'SpecialistForecast__c/'+idAttr(s.Id)+'/view" target="_blank" '+
        'rel="noopener noreferrer">'+esc(s.Name)+'</a> ('+money(s.ForecastAmount__c)+')').join(' · ')+'</div>':'')+
    '</div>'+

    '<div class="sec">Open questions to close</div>'+
    '<div class="card">'+list(a.gaps||[], g=>'<li>'+esc(g)+'</li>')+'</div>'+

    '<div class="sec">Sources</div>'+
    '<div class="card">'+((a.sources||[]).length
      ? '<div style="font-size:11.5px;line-height:1.8">'+(a.sources||[]).map(s=>
          '<div>'+(s.u?'<a href="'+esc(safeUrl(s.u))+'" target="_blank" rel="noopener noreferrer">'+esc(s.t)+' ↗</a>'
                     :esc(s.t))+
          ' <span class="tag grey">'+esc(s.k||'')+'</span>'+
          (s.d?' <span class="meta">'+esc(s.d)+'</span>':'')+'</div>').join('')+'</div>'
      : '<div class="empty">No sources recorded.</div>')+'</div>'+

    '<div id="pvOut"></div>';

  $('pvWrite').onclick = ()=>writePov(k, aud, goal);
}

/* Turns the sourced material into a narrative. The methodology shapes the
   output; it is never named in it. */
async function writePov(k, aud, goal){
  const a = PD[k]; if(!a) return;
  const out = $('pvOut');
  out.innerHTML = '<div class="sec">Narrative</div><div class="card"><div class="empty">'+
    '<span class="spin"></span> Writing from the sourced material…</div></div>';

  const f = famRoll().find(x=>x.slug===k);
  const opps = f ? f.opps.filter(realOpp).slice(0,5)
    .map(o=>'- '+fence('OPP', o.Name)+' (stage '+(o.StageName||'')+')').join('\n') : '';
  const usable = (a.metrics||[]).filter(m=>m.v==='verified').map(m=>'- '+m.m+' [src: '+m.src+']').join('\n');
  const banned = (a.metrics||[]).filter(m=>m.v!=='verified').map(m=>'- '+m.m).join('\n');

  const brief = UNTRUSTED_NOTE +
`ACCOUNT: ${a.disp}   SEGMENT: ${segFor(a.seg).label}   CORE AE: ${a.coreAE||'unknown'}

=== WHAT MATTERS IN THIS SEGMENT ===
${segFor(a.seg).ctx || ''}
AUDIENCE: ${aud==='cmo'?'CMO / marketing leadership':aud==='cio'?'CIO / CDO / IT leadership':
  aud==='ops'?'Marketing operations practitioner':'CEO / commercial executive'}
GOAL: ${goal==='firstmtg'?'open a first conversation':goal==='advance'?'advance a live deal':
  goal==='expand'?'expand an existing footprint':'defend a renewal'}

CURRENT STATE: ${a.state||'unknown'}

THEIR STATED PRIORITIES:
${(a.priorities||[]).map(p=>'- '+p).join('\n') || '- none sourced'}

PROBLEMS IN THEIR LANGUAGE:
${(a.problems||[]).map(p=>'- '+p.t+': '+p.d).join('\n') || '- none sourced'}

MARKET SHIFTS:
${(a.trends||[]).map(t=>'- '+t).join('\n') || '- none sourced'}

CONSEQUENCE OF STANDING STILL (use and sharpen this, do not soften it):
${a.consequence || 'NOT YET WRITTEN — you must construct it from the problems above.'}

PRODUCTS THAT FIT:
${(a.products||[]).map(p=>'- '+p.n+': '+p.why).join('\n') || '- none sourced'}

USE CASES:
${(a.usecases||[]).map(u=>'- '+u.n+': '+u.d).join('\n') || '- none sourced'}

OBJECTIONS ALREADY RAISED:
${(a.objections||[]).map(o=>'- "'+o.o+'"').join('\n') || '- none recorded'}

INCUMBENT STACK (position on top of, never against): ${(a.incumbents||[]).join(', ')||'unknown'}

STAKEHOLDERS: ${(a.stakeholders||[]).map(s=>s.n+' ('+(s.t||'title unknown')+')').join('; ')||'none'}

OPEN OPPORTUNITIES:
${opps || '- none'}

FIGURES YOU MAY USE (these only):
${usable || '- NONE. Do not put any number in this document.'}

FIGURES THAT ARE FORBIDDEN — never state these, they are unverified or fabricated:
${banned || '- none'}

OPEN QUESTIONS: ${(a.gaps||[]).join(' · ')||'none recorded'}

=== WRITE THE POV ===
Produce a customer-ready point of view, roughly 500-700 words, in this shape:

**Where you are** — their situation and momentum, in their language. Open on a win, not a crisis.
**What's getting in the way** — the structural problem, not a people problem.
**What's changing around you** — the outside-in shift, independent of Salesforce.
**Where this leads** — the consequence of standing still over the next 18-36 months. Concrete and
  unflinching. This is the most important section.
**What becomes possible** — the capability, as a business outcome.
**Why this window** — tie to a dated event in their world; write [CONFIRM] if you don't have one.
**Where we'd start** — one specific first step, small enough to say yes to.
**What we'd need from you** — the honest ask, including who needs to be in the room.

Then a short closing block titled **Three questions we'd want to explore with you** — three
questions that make them think about consequence and value, not questions whose answers are
already above.

ABSOLUTE RULES:
- Never name a sales methodology, framework, or technique. No "why change", no "MEDDICC", no "SPIN",
  no "status quo bias", no stage names. The customer must never see the scaffolding.
- Use only the permitted figures. Any other specific must be written as [CONFIRM].
- Write for the named audience: an executive gets outcome and consequence; a practitioner gets
  concrete mechanism.
- Warm, direct, plain. No hype adjectives, no "unlock", no "leverage", no "transform".
- Output only the document.`;

  try{
    const r = await window.cowork.askClaude(METHOD + '\n\n' + brief, []);
    const body = typeof r === 'string' ? r : (r && (r.text||r.content)) || String(r);
    out.innerHTML = '<div class="sec">Narrative</div><div class="card">'+
      povGuard(k, body)+
      '<textarea id="pvTxt" rows="26">'+esc(body)+'</textarea>'+
      '<div class="row" style="margin-top:9px">'+
        '<button class="btn" id="pvCopy">Copy</button>'+
        '<button class="btn ghost" id="pvRedo">Rewrite</button>'+
        '<span class="sp"></span>'+
        '<span class="meta">Replace every [CONFIRM] before this leaves the building.</span>'+
      '</div></div>';
    $('pvCopy').onclick = ()=>copyOut('pvTxt','pvCopy');
    $('pvRedo').onclick = ()=>writePov(k, aud, goal);
  }catch(e){
    out.innerHTML = '<div class="note err">Could not write it: '+esc(e.message)+'</div>';
  }
}

/* =================== DEAL ADVISOR =================== */
/* Search terms per answer. These pick WHICH products to look up in Org62;
   the product facts themselves always come from Product2, never from here. */
const SKU_MAP = {
  b2c:           ['Marketing Cloud Engagement', 'Marketing Cloud Growth', 'Marketing Cloud Advanced'],
  b2b:           ['Marketing Cloud Account Engagement', 'Marketing Cloud Advanced'],
  unified:       ['Data Cloud', 'Data 360'],
  agent:         ['Agentforce'],
  personalization:['Personalization', 'Marketing Cloud Personalization'],
  analytics:     ['Marketing Cloud Intelligence', 'Tableau'],
};
const STATE_NOTE = {
  new:        'Greenfield. Lead with the data layer, then activation — sequencing the other way produces a fast API to bad data.',
  mce:        'They run MCE. MC Engagement+ is the upgrade target and it is ADDITIVE — nothing running today has to stop. Never frame it as a migration.',
  mceplus:    'Already on MC Engagement+. The expansion path is Data 360 depth and Agentforce, not another engagement SKU.',
  mcae:       'They run MCAE / Pardot. Pardot → MCA is the standard consolidation framing. MCAE+ is additive, never a new SKU or a forced migration.',
  mci:        'They run MC Intelligence. Attribution is landed; the gap is usually activation on what the measurement reveals.',
  mcp:        'They run MC Personalization. Check whether the profile feeding it is governed — that is the Data 360 conversation.',
  competitor: 'Incumbent in place. Data 360 is the activation layer ON TOP of it, not a replacement. Do not attack the purchase.',
};
const DATA_NOTE = {
  none:      {sev:'warn', t:'No CDP — Data 360 is a prerequisite, not an upsell',
              d:'Any activation or agent use case sold without the data layer will underdeliver in deployment. Sequence Data 360 first and say so plainly.'},
  warehouse: {sev:'ok',   t:'Warehouse present — position Data 360 as the activation layer',
              d:'Zero-copy to the warehouse is the story. Data 360 sits on top of Snowflake/Databricks rather than replacing it. This is a strength, not an objection.'},
  dc:        {sev:'ok',   t:'Already owns Data 360 — activation is the play',
              d:'The foundation is there. Go straight at activation and agents, and check Data Space design before anything else.'},
  unknown:   {sev:'warn', t:'Data readiness unknown — this is a discovery gap',
              d:'You cannot dimension or sequence this deal without it. Ask before quoting anything.'},
};

function buildAdvisor(){
  fillSelect('qFam', famRoll().filter(f=>f.accts.size).map(f=>({v:f.slug, l:f.disp})),
             '— pick one —');
  if($('advGo')) $('advGo').onclick = runAdvisor;
}

async function runAdvisor(){
  const slug = $('qFam').value, state = $('qState').value, use = $('qUse').value;
  const dataR = $('qData').value, shape = $('qShape').value, coterm = $('qCoterm').value;
  const f = slug ? famRoll().find(x=>x.slug===slug) : null;
  const out = $('advOut');
  out.innerHTML = '<div class="empty" style="margin-top:12px"><span class="spin"></span> '+
    'Querying Product2 and PricebookEntry in Org62…</div>';

  /* Live product lookup. Terms choose what to look up; Org62 supplies the truth. */
  const terms = (SKU_MAP[use]||[]).concat(dataR==='none'||dataR==='unknown' ? ['Data Cloud'] : []);
  const where = terms.map(t=>"Name LIKE '%"+soqlLit(t)+"%'").join(' OR ');
  /* Two dependent chains — products→prices and won opps→line items — that are
     independent OF EACH OTHER. They used to run one after the other: four
     serial round trips per press of Go. Now the chains run side by side, so it
     is two. */
  let prods = [], prices = [], perr = null;
  let footprint = [], ferr = null;

  const priceChain = (async()=>{
    prods = await soql(
      "SELECT Id, Name, ProductCode, Family, Description FROM Product2 "+
      "WHERE IsActive = true AND ("+where+") ORDER BY Family, Name LIMIT 25");
    const ids = sfIdList(prods.map(p=>p.Id)).map(i=>"'"+i+"'").join(',');
    if(ids) prices = await soql(
      "SELECT Product2Id, UnitPrice, CurrencyIsoCode, Pricebook2.Name FROM PricebookEntry "+
      "WHERE IsActive = true AND CurrencyIsoCode = 'USD' AND Product2Id IN ("+ids+") "+
      "AND Pricebook2.Name LIKE '%Direct%Commercial%' LIMIT 60");
  })().catch(e=>{ perr = e.message; });

  const footChain = (async()=>{
    if(!(f && f.accts.size)) return;
    const oppIds = await soql(
      "SELECT Id FROM Opportunity WHERE AccountId IN ("+
      sfIdList(f.accts).slice(0,40).map(i=>"'"+i+"'").join(',')+") AND IsWon = true "+
      "AND CloseDate = LAST_N_DAYS:730 LIMIT 120");
    if(oppIds.length) footprint = await soql(
      "SELECT Product2.Name, Product2.Family, Quantity, UnitPrice, TotalPrice, "+
      "Opportunity.Name, Opportunity.CloseDate FROM OpportunityLineItem "+
      "WHERE OpportunityId IN ("+sfIdList(oppIds.map(o=>o.Id)).map(i=>"'"+i+"'").join(',')+") "+
      "ORDER BY TotalPrice DESC LIMIT 40");
  })().catch(e=>{ ferr = e.message; });

  await Promise.all([priceChain, footChain]);

  const pByProd = {};
  prices.forEach(p=>{ (pByProd[p.Product2Id] = pByProd[p.Product2Id] || []).push(p); });
  /* Sorted once here, not inside the map callback that renders each row. */
  Object.keys(pByProd).forEach(k=>pByProd[k].sort((a,b)=>
    (Number(a.UnitPrice)||0)-(Number(b.UnitPrice)||0)));

  const dn = DATA_NOTE[dataR];
  const lead = prods.filter(p=>/Engagement|Account Engagement|Data Cloud|Data 360|Agentforce/i.test(p.Name))
                    .slice(0,8);
  const rest = prods.filter(p=>!lead.includes(p)).slice(0,14);

  const priceCell = p=>{
    const rows = pByProd[p.Id]||[];
    if(!rows.length) return '<span style="color:var(--ink-3)">no USD Direct-Commercial entry</span>';
    /* Already sorted where the map was built — this used to sort in place from
       inside a map callback, mutating shared state during a render. */
    const r = rows[0];
    return '<strong>'+moneyFull(r.UnitPrice)+'</strong> <span class="meta">list · '+
      esc(r.Pricebook2 && r.Pricebook2.Name || 'pricebook unnamed')+'</span>';
  };
  const prodRow = p=>'<div class="sku-row"><div style="flex:1">'+
    '<strong style="font-size:12.5px">'+esc(p.Name)+'</strong>'+
    ' <span class="tag grey">'+esc(p.Family||'—')+'</span>'+
    '<div class="meta mono" style="margin-top:2px">'+esc(p.ProductCode||'no code')+'</div>'+
    (p.Description?'<div class="meta" style="margin-top:4px">'+
      esc(p.Description.slice(0,210))+(p.Description.length>210?'…':'')+'</div>':'')+
    '</div><div style="min-width:190px;text-align:right;font-size:11.5px">'+priceCell(p)+'</div></div>';

  out.innerHTML =
    '<div style="margin-top:13px;padding-top:13px;border-top:1px solid var(--line-2)">'+

    (f?'<div class="row" style="margin-bottom:10px;flex-wrap:wrap">'+
      '<span class="chip">'+esc(f.disp)+'</span>'+
      '<span class="chip">'+esc(segOf(f).label)+'</span>'+
      '<span class="chip">'+f.accts.size+' account records</span></div>':'')+

    '<div class="note"><strong>Positioning for this state.</strong> '+esc(STATE_NOTE[state])+'</div>'+
    /* SKU[state] was orphaned when the teaching accordions were removed — 23
       lines of real packaging guidance sitting unread. It is better than the
       one-line note above it, so it is back. */
    (SKU[state]?'<div class="card" style="margin-bottom:14px">'+
      '<h3>'+esc(SKU[state].h)+' <span class="tag '+esc(SKU[state].t)+'">recommended</span></h3>'+
      '<div class="meta" style="margin-top:6px;line-height:1.65">'+esc(SKU[state].b)+'</div>'+
      '<div class="note" style="margin-top:9px"><strong>Say it like this.</strong> '+
        esc(SKU[state].say)+'</div></div>':'')+

    '<div class="gate'+(dn.sev==='warn'?'':' ')+'" style="'+(dn.sev==='ok'?
      'border-left-color:var(--sf-green);background:rgba(46,132,74,.08)':'')+'">'+
      '<strong>'+esc(dn.t)+'</strong>'+esc(dn.d)+'</div>'+

    '<div class="sec">Candidate SKUs &mdash; live from Product2</div>'+
    (perr
      ? '<div class="note err">Product lookup failed: '+esc(perr)+'</div>'
      : prods.length
        ? '<div class="card" style="box-shadow:none;border:1px solid var(--line-2)">'+
          (lead.length?'<div class="meta" style="margin-bottom:5px;font-weight:650">Lead with</div>'+
            '<div class="sku-lead">'+lead.map(prodRow).join('')+'</div>':'')+
          (rest.length?'<div class="meta" style="margin:11px 0 5px;font-weight:650">Also matched</div>'+
            rest.map(prodRow).join(''):'')+
          '</div>'+
          '<div class="meta" style="margin-top:7px">List prices are USD from the Direct&nbsp;Commercial '+
          'pricebook only. Other pricebooks (Reseller, Agency, Nonprofit) and other currencies carry '+
          'different list prices &mdash; confirm the right one for this deal in CPQ.</div>'
        : '<div class="note">No active products matched those terms. Widen the use case or check the '+
          'product naming in Org62.</div>')+

    '<div class="sec">What they already own &mdash; closed-won, last 24 months</div>'+
    (ferr ? '<div class="note err">Footprint lookup failed: '+esc(ferr)+'</div>'
      : footprint.length
        ? '<div class="card" style="box-shadow:none;border:1px solid var(--line-2)"><div class="tw"><table>'+
          '<thead><tr><th>Product</th><th>Family</th><th class="num">Qty</th>'+
          '<th class="num">Unit</th><th class="num">Total</th><th>Won</th></tr></thead><tbody>'+
          footprint.slice(0,18).map(l=>'<tr><td style="font-size:11.5px">'+
            esc(l.Product2&&l.Product2.Name||'—')+'</td>'+
            '<td style="font-size:11px">'+esc(l.Product2&&l.Product2.Family||'—')+'</td>'+
            '<td class="num">'+(l.Quantity!=null?l.Quantity:'—')+'</td>'+
            '<td class="num">'+(l.UnitPrice!=null?money(l.UnitPrice):'—')+'</td>'+
            '<td class="num"><strong>'+(l.TotalPrice!=null?money(l.TotalPrice):'—')+'</strong></td>'+
            '<td style="font-size:11px">'+fmtDate(l.Opportunity&&l.Opportunity.CloseDate)+'</td></tr>').join('')+
          '</tbody></table></div>'+
          '<div class="meta" style="margin-top:8px">This is your best dimensioning evidence &mdash; real '+
          'quantities at prices that were actually approved on this account. Use it to sanity-check what '+
          'you are about to quote.</div></div>'
        : '<div class="note">No closed-won line items on this family in the last 24 months. '+
          'Nothing to anchor quantities against &mdash; dimension from discovery, not from precedent.</div>')+

    '<div class="sec">Contract shape</div>'+
    '<div class="note">'+
      (shape==='ao' ? 'Add-on. Additive positioning is the whole argument — they keep what they run and gain capability. '
       : shape==='nb' ? 'New business. The term and ramp decide whether the first-year number is credible. '
       : shape==='renewal' ? 'Renewal or uplift. Anchor on delivered value before any uplift conversation. '
       : 'Consolidation. Multiple contracts collapsing into one — co-term and true-up are the whole negotiation. ')+
      (coterm==='yes' ? 'They must co-term, so the end date is fixed and the lever is the ramp, not the term length.'
       : coterm==='no' ? 'Standalone term, so term length is negotiable.'
       : 'Co-term status is unknown — find out before you shape anything, it changes the available levers.')+
    '</div>'+

    '<div class="gate block"><strong>Policy check — not verified here</strong>'+
      'Whether this shape is <em>allowed</em> — discount thresholds, approval routing, permitted ramp and '+
      'multi-year structures, true-up treatment, and current Flex Credits rules — is not in the Salesforce '+
      'schema, so this tool will not assert it. Two rules that are safe to state: <strong>MCAE+ is additive, '+
      'never a new SKU or forced migration</strong>, and <strong>Flex Credits Pre-commit (100K) must not be '+
      'quoted in Dynamic Bundles after Q1 FY27</strong>. Everything else goes to Deal Desk.'+
      '<div style="margin-top:7px">Ask them, specifically: <em>“For '+
      esc(f?f.disp:'this account')+', on a '+esc(shape==='ao'?'add-on':shape==='nb'?'new business':shape==='renewal'?'renewal':'consolidation')+
      ' with '+esc(coterm==='yes'?'a required co-term':coterm==='no'?'a standalone term':'co-term status TBC')+
      ', what discount level can I approve myself, what needs escalation, and is a ramp permitted on this SKU '+
      'this quarter?”</em></div>'+
      '<div style="margin-top:7px" class="meta">The sources for these answers are your own '+
      'channels: '+ ((CC.slackChannels||[]).map(esc).join(', ') || 'your team\'s pricing and contract-shape channels') +', and the '+
      'Marketing Cloud Enablement Hub canvas for SKU rules. Size quantities with the Credit '+
      'Estimator, not with a figure from here.</div>'+
    '</div>'+

    '<div class="sec">MEDDICC — what this deal still needs</div>'+
    '<div class="note">Metrics: quantify the outcome in their language before quoting. '+
      'Economic Buyer: '+(f?'check the Stakeholders tab — coverage gaps are listed there for '+esc(f.disp):'unknown')+'. '+
      'Decision Process: get the dated steps to signature, including procurement and legal. '+
      'Competition: the status quo is the one that wins most often.</div>'+
    '</div>';

  out.scrollIntoView({behavior:'smooth', block:'nearest'});
}

/* =================== SHELL =================== */
/* Renderers keyed by tab so only the visible one paints — painting all ten
   wrote ~84KB of HTML to tabs the user cannot see, on every load. */
let RENDER_ERR = {};
function safely(name, fn){
  /* One throwing renderer used to abort every renderer queued after it. */
  try{ fn(); }
  catch(e){
    console.error('render '+name+' failed', e);
    RENDER_ERR[name] = e.message;
    /* Every tab has a <tab>Note div now. Four of them used to resolve to null
       or to the Accounts note, so a throw inside renderPipeline left an empty
       table and no message anywhere on screen. */
    /* Two tabs use historic ids (sigNote, anNote); everything else follows the
       <tab>Note convention. */
    const ALIAS = {signals:'sigNote', analytics:'anNote'};
    const host = $(ALIAS[name] || (name+'Note')) || $('bookNote');
    if(host) host.innerHTML = '<div class="note err">This section could not be '+
      'drawn: '+esc(plainErr(e.message))+'. Everything else still works — hit '+
      'Reload in the header if it persists.</div>';
  }
}
const RENDER = {
  sfr:       ()=>renderSfr(),
  today:     ()=>renderToday(),
  book:      ()=>renderBook(),
  inbox:     ()=>renderInbox(),
  people:    ()=>renderPeople(),
  signals:   ()=>renderSignals(),
  pipeline:  ()=>renderPipeline(),
  analytics: ()=>renderAnalytics(),
  /* pov and advisor were listed as repaint targets for late data but had no
     entry here, so paint() returned immediately and they silently never
     refreshed when Drive or Salesforce landed. */
  hpf:       ()=>renderHpf(),
  pov:       ()=>{ buildPov();
                   /* paint() no-ops before S.loaded, so opening this tab from
                      omnisearch during load used to show an empty picker with
                      nothing said. The strategy itself is embedded and needs no
                      network — only the live Org62 cross-check does. */
                   if($('povWait')) $('povWait').innerHTML =
                     (S.loaded && !S.err.sf) ? ''
                     : S.err.sf
                       /* A hard core-load failure means S.loaded never flips, so
                          this used to spin forever while loadFailed wrote the
                          real error to the Accounts note. */
                       ? '<div class="note err">Salesforce did not answer, so the '+
                         'live pipeline and open opportunities on this tab are '+
                         'missing. The embedded strategy below is unaffected. '+
                         'Hit Reload in the header.</div>'
                       : '<div class="note"><span class="spin"></span> The embedded '+
                         'strategy is ready now. Live Org62 pipeline and open '+
                         'opportunities are still loading, so those sections will '+
                         'fill in shortly.</div>';
                   if($('pvAcct') && $('pvAcct').value) renderPov(); },
  advisor:   ()=>buildAdvisor(),
  write:     ()=>renderWrite(),
  renewals:  ()=>renderRenewals(),
  byae:      ()=>renderByAe(),
};
const PAINTED = new Set();
/* Most tables are built as HTML strings at render time, so scope="col" can't be
   maintained by hand across ~14 call sites. Stamp it after every paint instead. */
function stampScope(tab){
  try{
    const root = (tab && $(tab)) || document;
    root.querySelectorAll('thead th:not([scope])')
        .forEach(th=>th.setAttribute('scope','col'));
  }catch(e){}
}
function paint(tab, force){
  if(!RENDER[tab]) return;
  if(PAINTED.has(tab) && !force) return;
  PAINTED.add(tab);
  safely(tab, RENDER[tab]);
  stampScope(tab);
  syncNavCounts();          /* renderers write counts by id; mirror into the nav */
}
function renderAll(){
  invalidateDerived();
  RENDER_ERR = {};
  PAINTED.clear();
  buildAdvisor();                       // static shell, cheap
  if($('povWait') && S.loaded) $('povWait').innerHTML = '';
  /* buildPov is NOT called here: it forces the 200KB POV parse. RENDER.pov
     calls it on the first paint of that tab. */
  paint(cur, true);                      // only what he can actually see
  connBanner();                          // say plainly if a source did not answer
  syncNavCounts();
}
let cur = 'sfr';

/* ── Navigation: five groups over the existing leaf views ─────────────
   Ten peer tabs made the app read as ten unrelated reports. These four are
   the questions actually being asked: what is my number, what do I do today,
   what is going on at this account, and what do I sell them. Nothing was
   deleted — every view and every renderer is intact, one level down. */
const GROUPS = [
  {k:'forecast', label:'Forecast', views:[
    {t:'sfr',       label:'My SFRs',     cnt:'cSfr'},
    {t:'pipeline',  label:'Pipeline',    cnt:'cPipe'},
    {t:'renewals',  label:'Renewals',    cnt:'cRenew'},
    {t:'byae',      label:'By core AE'},
    {t:'analytics', label:'Analytics'},
    {t:'hpf',       label:'HPF scorecard'},
  ]},
  {k:'day', label:'My Day', views:[
    {t:'today',   label:'Today & calendar', cnt:'cToday'},
    {t:'inbox',   label:'Inbox',            cnt:'cInbox'},
    {t:'signals', label:'Signals',          cnt:'cSig'},
  ]},
  {k:'accounts', label:'Accounts', views:[
    {t:'book',   label:'Account families', cnt:'cBook'},
    {t:'people', label:'Stakeholders'},
    {t:'pov',    label:'Marketing POV',    cnt:'cPov'},
  ]},
  {k:'write', label:'Write', views:[
    {t:'write', label:'Narrative, drafts & objections'},
  ]},
  {k:'sell', label:'Deal Advisor', views:[
    {t:'advisor', label:'SKU & contract shape'},
  ]},
];
const VIEW_GROUP = {};
GROUPS.forEach(g=>g.views.forEach(v=>{ VIEW_GROUP[v.t] = g.k; }));
/* Which view he was last on inside each group, so switching back returns him
   where he left rather than to the first item. */
const GROUP_LAST = {};
GROUPS.forEach(g=>{ GROUP_LAST[g.k] = g.views[0].t; });
let curGroup = VIEW_GROUP[cur] || 'forecast';

/* The counts live on the leaf views; the group button shows their sum so a
   collapsed group still tells you there is something in it. */
/* The badge used to SUM the views inside a group — open SFRs plus open opps for
   Forecast, meetings plus threads plus signals for My Day. "My Day 61" told him
   nothing. It now shows the first view's count, which is the one the group
   opens on, and the tooltip spells out the rest. */
/* The FIRST view's count used to be the whole badge, so a failed Calendar read
   blanked "My Day" to "–" while Inbox had real waiting mail underneath. Use the
   first view that actually has a number, and only fall back to "–" when none of
   them do. The tooltip still spells out every view. */
/* Views whose read failed. A failed read prints 0, which is a perfectly finite
   number, so without this the group badge said "My Day 0" whenever Calendar was
   down — reading as "nothing to do" while the inbox had mail waiting. */
const COUNT_FAILED = new Set();
/* Counts that are real but incomplete — "at least this many". Distinct from
   COUNT_FAILED: a floor is still worth showing in the group badge, a failure
   is not. Keeping the two in one set meant a Gmail outage hid an honest
   "12 waiting" behind "read failed".
   Read by the Inbox tooltip; groupCount reads the "+" off the badge text
   instead, so this stays the single place that decides what a floor IS. */
const COUNT_FLOOR = new Set();
function groupCount(g){
  const cnts = g.views.filter(v=>v.cnt);
  if(!cnts.length) return '';
  /* A floor is usable; a failure is not. */
  const usable = cnts.filter(v=>!COUNT_FAILED.has(v.cnt)).map(v=>{
    const el = $(v.cnt);
    const t = el ? String(el.textContent) : '';
    const n = el ? parseInt(t.replace(/[^0-9]/g,''), 10) : NaN;
    /* Both markers, read off the badge itself: "+" = a floor, "*" = narrowed by
       the Inbox family filter. parseInt stripped them, so a group badge read as
       an exact, unfiltered number while only the tooltip told the truth. */
    return {n, mark: (t.indexOf('+') >= 0 ? '+' : '') + (t.indexOf('*') >= 0 ? '*' : '')};
  }).filter(x=>Number.isFinite(x.n));
  if(usable.length) return String(usable[0].n) + usable[0].mark;
  /* Every view in the group failed — say so rather than printing a zero. */
  return cnts.some(v=>COUNT_FAILED.has(v.cnt)) ? '!' : '–';
}
function groupTitle(g){
  return g.views.map(v=>{
    if(v.cnt && COUNT_FAILED.has(v.cnt)) return v.label + ': read failed';
    const el = v.cnt && $(v.cnt);
    const x = el ? String(el.textContent).trim() : null;
    /* No "(at least)" — the "+" in the number already says it, and printing
       both read as "12+ (at least)". */
    return v.label + (x && x!=='–' ? ': '+x : '');
  }).join(' · ');
}
function buildNav(){
  const nav = $('nav'); if(!nav) return;
  nav.innerHTML = GROUPS.map(g=>
    '<button data-g="'+g.k+'"'+(g.k===curGroup?' class="on"':'')+
      ' aria-current="'+(g.k===curGroup?'page':'false')+'">'+esc(g.label)+
      (g.views.some(v=>v.cnt)?'<span class="cnt" id="gc-'+g.k+'">–</span>':'')+
      '</button>').join('');
}
function paintSubnav(){
  const sub = $('subnav'); if(!sub) return;
  const g = GROUPS.find(x=>x.k===curGroup);
  /* One view in a group needs no second row of navigation. */
  if(!g || g.views.length < 2){ sub.innerHTML = ''; return; }
  sub.innerHTML = g.views.map(v=>
    '<button data-t="'+v.t+'"'+(v.t===cur?' class="on"':'')+'>'+esc(v.label)+
      (v.cnt?'<span class="cnt" id="sc-'+v.t+'">'+
        (($(v.cnt)&&$(v.cnt).textContent)||'–')+'</span>':'')+'</button>').join('');
}
/* The eight nav badges, computed from S rather than read back out of spans a
   renderer may not have run yet. paint() only paints the visible tab, so the
   badges for every other group used to read "–" on open — the opposite of what
   a triage nav is for. Cheap: no HTML is built, and every input is either a
   length or an already-cached derived value. */
/* Counted once, cached, and never derived from PD's Proxy on the hot path —
   Object.keys(PD) triggers the ownKeys trap, which forces the ~200KB JSON.parse
   the lazy Proxy exists to defer. */
const povKeys  = () => _povK || (_povK = Object.keys(PDget()).filter(k=>k!=='_meta'));
/* Counted off the RAW string when POV_DATA has not been parsed yet, so the nav
   badge does not itself force the ~200KB parse the lazy Proxy defers. Verified
   against the parsed object: both give 8. Falls back to the real key list the
   moment anything else has triggered a parse, and is cached either way. */
const povCount = () => {
  if(_povN != null) return _povN;
  if(_pd) return (_povN = povKeys().length);
  const raw = (typeof POV_DATA === 'string') ? POV_DATA : '';
  const n = (raw.match(/"[a-z0-9_-]+":\{"disp"/g) || []).length;
  return n ? (_povN = n) : (_povN = povKeys().length);
};
/* ONE owner per badge. The renderers used to write these spans too, and
   paint() runs syncNavCounts AFTER the renderer — so whichever ran last won,
   and the Accounts badge disagreed with its own tab. Renderers no longer touch
   them; every count is computed here, from the same predicates the tabs use. */
function navCounts(){
  /* Clears the failure marker on every successful write — it used to persist
     through a good reload, so a working badge kept saying "this read failed". */
  const set = (id, v)=>{ const el = $(id); if(!el) return;
    el.textContent = v; el.title = '';
    COUNT_FAILED.delete(id); COUNT_FLOOR.delete(id); };
  /* A read that FAILED and a read that has not arrived used to share the "–"
     glyph. Failed reads get a 0, a tooltip and a place in COUNT_FAILED, so a
     blank badge means "still loading" and nothing else. */
  const failed = (id, err)=>{ const el = $(id);
    if(el && err){ el.textContent = '0'; el.title = 'this read failed';
                   COUNT_FAILED.add(id); } };
  failed('cSfr', S.err.sfr);
  ['cPipe','cBook','cRenew','cSig'].forEach(id=>failed(id, S.err.sf));
  failed('cToday', S.err.cal);
  /* Only a TOTAL inbox failure is a failure; one source down is a floor, and
     that is handled below where the number is actually computed. */
  failed('cInbox', S.err.mail && S.err.dm);
  if(!S.err.sfr && S.got.sfr) set('cSfr', (S.sfrs||[]).filter(sfrOpen).length);
  if(!S.err.sf && S.got.sf){
    set('cPipe',  scoped().filter(isLive).length);
    /* famRoll() always contains every FAMILY plus OTHER, so its raw length is
       the constant 10. The tab shows only families with something in them. */
    set('cBook',  famRoll().filter(f=>f.opps.length||f.accts.size).length);
    set('cRenew', (S.opps||[]).filter(o=>RENEW_RE.test(o.Type||'')).filter(isLive)
                    .filter(o=>famOfOpp(o).slug !== 'other').length);
    set('cSig',   signalList().filter(x=>!isDone(x.key)).length);
  }
  if(!S.err.cal && S.got.cal)
    set('cToday', (S.events||[]).filter(e=>e.status!=='cancelled' && evDayKey(e)===todayStr()).length);
  if(S.got.mail || S.got.dm){
    /* Same family narrowing the Inbox tab applies, so the badge and the tab
       cannot print different numbers depending on which painted last. */
    const famF = $('iFam') ? $('iFam').value : '';
    const inFam = t => !famF || (threadFam(t) && threadFam(t).slug === famF);
    const n = waitingThreads().filter(t=>!isDone('mail:'+t.id)).filter(inFam).length +
              (S.slackDM||[]).filter(m=>!isDone(dmKey(m))).length;
    /* Partial failure is the interesting case: one source down makes this a
       floor, not a count. set() clears the failure marker, so the marker has to
       be applied AFTER the write, not before it. */
  /* Pending counts as incomplete too, not just failed: between the DM read
     landing and the Gmail read landing this printed an unmarked undercount. */
    const half = !!(S.err.mail || S.err.dm || !S.got.mail || !S.got.dm);
    /* '*' = narrowed by the Inbox family filter. '+' = at least this many, one
       source did not answer. */
    set('cInbox', n + (half ? '+' : '') + (famF ? '*' : ''));
    const ie = $('cInbox');
    if(ie){
      const why = [];
      if(half){
        const down = [];
        if(S.err.mail) down.push('Gmail failed');
        else if(!S.got.mail) down.push('Gmail still loading');
        if(S.err.dm) down.push('Slack failed');
        else if(!S.got.dm) down.push('Slack still loading');
        why.push(down.join(' and ')+' — this is a floor, not a count');
      }
      if(famF) why.push('narrowed to one account family on the Inbox tab');
      ie.title = why.join(' · ');
      if(half) COUNT_FLOOR.add('cInbox');
    }
  }
  set('cPov', povCount());
}
function syncNavCounts(){
  navCounts();
  GROUPS.forEach(g=>{
    const el = $('gc-'+g.k); if(el) el.textContent = groupCount(g);
    const btn = document.querySelector('.nav button[data-g="'+g.k+'"]');
    if(btn) btn.title = groupTitle(g);
  });
  GROUPS.forEach(g=>g.views.forEach(v=>{
    if(!v.cnt) return;
    const src = $(v.cnt), dst = $('sc-'+v.t);
    if(src && dst) dst.textContent = src.textContent;
  }));
}

/* Any renderer a click can invoke directly has to refresh the badges too —
   marking a signal resolved used to update its own tile and leave the group
   badge on the pre-resolution count. */
/* Coalesced: renderInbox calls renderDMs and paint() calls syncNavCounts on top,
   so an Inbox paint used to run the whole count pass three times. One per
   microtask instead of one per wrapped call. */
let countsQueued = false;
function queueCounts(){
  if(countsQueued) return;
  countsQueued = true;
  Promise.resolve().then(()=>{ countsQueued = false;
    try{ syncNavCounts(); }catch(e){} });
}
function repaintCounts(fn){ return function(){ const r = fn.apply(null, arguments);
  queueCounts(); return r; }; }
/* renderUsage is left out: its only caller that matters is renderSignals,
   which is wrapped, and wrapping both meant three navCounts per Signals paint. */
['renderSignals','renderInbox','renderDMs'].forEach(n=>{
  if(typeof window[n] === 'function') window[n] = repaintCounts(window[n]);
});

/* One place that switches views, so search results and nav clicks agree. */
function goTab(tab, force){
  if(!VIEW_GROUP[tab]) return;
  cur = tab;
  curGroup = VIEW_GROUP[tab];
  GROUP_LAST[curGroup] = tab;
  document.querySelectorAll('.nav button').forEach(x=>
    x.classList.toggle('on', x.dataset.g === curGroup));
  document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('on',t.id===cur));
  paintSubnav();
  scopeBanner();          /* its wording depends on which tab is showing */
  /* Paint on first visit; Pipeline and Analytics re-paint because their charts
     need a laid-out canvas and their filters may have changed. */
  if(S.loaded) paint(cur, force || cur==='pipeline' ||
                          (cur==='today' && calDirty));
  /* The POV tab is the one view whose content is embedded, not fetched, so it is
     usable before the load settles — and it was the one showing an unexplained
     empty picker, because paint() is gated on S.loaded. Build it and say what is
     still missing. */
  else if(cur==='pov' && !PAINTED.has('pov')){
    PAINTED.add('pov'); safely('pov', RENDER.pov);
  }
  if(cur==='today') calDirty = false;
  syncNavCounts();
}
buildNav();
paintSubnav();
$('nav').addEventListener('click',e=>{
  const b = e.target.closest('button[data-g]'); if(!b) return;
  goTab(GROUP_LAST[b.dataset.g] || (GROUPS.find(g=>g.k===b.dataset.g)||{views:[{}]}).views[0].t);
});
$('subnav').addEventListener('click',e=>{
  const b = e.target.closest('button[data-t]'); if(!b) return;
  goTab(b.dataset.t);
});

/* ───────────── Omnisearch ─────────────
   Ten tabs and four filter dropdowns meant that finding one named deal took
   several guesses. This searches what is already in memory — no extra calls —
   and lands you on the record with the right filters already set. */
const OMNI = {rows:[], sel:-1};
function omniMatch(q){
  const t = q.trim().toLowerCase();
  if(t.length < 2) return [];
  const hit = v => String(v||'').toLowerCase().includes(t);
  const out = [];

  (S.sfrs||[]).filter(sfrOpen).forEach(r=>{
    if(hit(r.Name) || hit(r.Account_Name__c) || hit(r.Opportunity__r && r.Opportunity__r.Name))
      out.push({g:'SFRs', t:r.Name||'SFR',
        m:[r.Account_Name__c, r.ForecastStage__c, money(amtRaw(r))].filter(Boolean).join(' · '),
        go:()=>{ goTab('sfr', true);
                 const el=$('sAcct');
                 if(el && [...el.options].some(o=>o.value===r.Account_Name__c)){
                   el.value = r.Account_Name__c; applySfr();
                 }
                 openInOrg('SpecialistForecast__c', r.Id); }});
  });

  (S.opps||[]).forEach(o=>{
    if(hit(o.Name) || hit(o.Account && o.Account.Name))
      out.push({g:'Opportunities', t:o.Name,
        m:[(o.Account&&o.Account.Name), o.StageName,
           specAmt(o)?money(specAmt(o)):'no specialist amount', fmtDate(o.CloseDate)]
          .filter(Boolean).join(' · '),
        go:()=>omniOpenOpp(o.Id)});
  });

  FAMILIES.forEach(f=>{
    if(hit(f.disp))
      out.push({g:'Accounts', t:f.disp, m:'Open the account deep dive',
        go:()=>{ goTab('book', true); showFam(f.slug); }});
  });

  Object.keys(S.contacts||{}).forEach(slug=>{
    (S.contacts[slug]||[]).forEach((c,i)=>{
      if(hit(c.Name) || hit(c.Title))
        out.push({g:'People', t:c.Name,
          m:[c.Title, c.Account && c.Account.Name].filter(Boolean).join(' · '),
          /* Await the load rather than guessing 500ms: if the Contact query
             took longer, stakeholderDetail found no host div and no-oped. */
          go:async()=>{ goTab('people', true);
                   const pick = document.querySelector('#peopleFams [data-f="'+slug+'"]');
                   if(pick) pick.classList.add('on');
                   await loadContacts(slug);
                   stakeholderDetail(slug, i); }});
    });
  });

  /* The drafting tools were unreachable by search, which is most of why they
     were hard to find. Typing "objection" or "inmail" now lands on them. */
  const ACTIONS = [
    {n:'Forecast narrative', m:'Commit, best case, at risk — for a forecast call',
     kw:'forecast narrative commit best case risk call mike prose',
     go:()=>{ goTab('write', true); setTimeout(()=>$('fnGo').focus(), 60); }},
    {n:'LinkedIn InMail', m:'Open a conversation with a stakeholder',
     kw:'linkedin inmail connect outreach draft message',
     go:()=>{ goTab('write', true); if($('wKind')) $('wKind').value='li'; }},
    {n:'Discovery meeting email', m:'Book 30 minutes to learn their initiatives',
     kw:'discovery meeting email book 30 minutes draft outreach',
     go:()=>{ goTab('write', true); if($('wKind')) $('wKind').value='disc'; }},
    {n:'Live agent build email', m:'Book a sandbox session they can test after',
     kw:'agent build sandbox demo session email draft agentforce',
     go:()=>{ goTab('write', true); if($('wKind')) $('wKind').value='agent'; }},
    {n:'Objection handler', m:'Work through what they actually said',
     kw:'objection pushback price expensive competitor adobe braze marketo handle',
     go:()=>{ goTab('write', true); setTimeout(()=>$('wObjIn').focus(), 60); }},
    {n:'What changed since last visit', m:'Slips, cuts and stage reversals',
     kw:'changed change delta slipped moved since last week signals',
     go:()=>goTab('signals', true)},
    {n:'Usage and overage', m:'Who is over, and the upsell quantity',
     kw:'usage overage upsell consumption entitlement allowance super messages',
     go:()=>goTab('signals', true)},
    {n:'Marketing POV', m:'The account point of view, from your own strategy',
     kw:'pov point of view narrative account strategy',
     go:()=>goTab('pov', true)},
    {n:'Deal Advisor', m:'SKU choice and contract shape, priced from Org62',
     kw:'sku advisor price pricing contract shape deal desk discount',
     go:()=>goTab('advisor', true)},
    {n:'Renewals', m:'What renews when, and what is at risk',
     kw:'renewal runway uplift renew expiring contract',
     go:()=>goTab('renewals', true)},
  ];
  ACTIONS.forEach(a=>{
    if(hit(a.n) || hit(a.kw))
      out.push({g:'Do this', t:a.n, m:a.m, go:a.go});
  });

  /* Group order is deliberate: an action he can take beats a record to read,
     and the specialist forecast is his number. */
  const order = {'Do this':0,'SFRs':1,'Opportunities':2,'Accounts':3,'People':4};
  return out.sort((a,b)=>(order[a.g]||9)-(order[b.g]||9)).slice(0,24);
}
function openInOrg(obj, id){
  const u = sfId(id); if(!u) return;
  window.open(SF_URL+obj+'/'+u+'/view', '_blank', 'noopener,noreferrer');
}
function omniOpenOpp(id){
  const o = (S.opps||[]).find(x=>x.Id===id); if(!o) return;
  goTab('pipeline', true);
  /* Widen the filters enough that the deal cannot be hidden by one of them. */
  if($('fDig'))  $('fDig').value  = isDigital(o) ? 'digital' : 'all';
  if($('fFam'))  $('fFam').value  = '';
  if($('fCat'))  $('fCat').value  = '';
  if($('fReal')) $('fReal').checked = false;
  if($('fZomb')) $('fZomb').checked = true;
  DRILL = null;
  const nm = o.Account && o.Account.Name;
  if($('fAcct'))
    $('fAcct').value = (nm && [...$('fAcct').options].some(x=>x.value===nm)) ? nm : '';
  renderPipeline();
  setTimeout(()=>{
    const tr = document.querySelector('#pipeBody tr.ex[data-o="'+id+'"]');
    if(!tr) return;
    tr.click();
    tr.scrollIntoView({behavior:'smooth', block:'center'});
    tr.classList.add('flash');
    setTimeout(()=>tr.classList.remove('flash'), 1400);
  }, 70);
}
function omniRender(){
  const box = $('omniOut'); if(!box) return;
  if(!OMNI.rows.length){ box.classList.remove('on'); box.innerHTML='';
    if($('omni')) $('omni').setAttribute('aria-expanded','false');
    return; }
  let last = null, h = '';
  OMNI.rows.forEach((r,i)=>{
    if(r.g !== last){ h += '<div class="oh">'+esc(r.g)+'</div>'; last = r.g; }
    h += '<button class="oi'+(i===OMNI.sel?' sel':'')+'" data-i="'+i+'" '+
      'id="omni-opt-'+i+'" role="option" aria-selected="'+(i===OMNI.sel)+'">'+
      '<strong>'+esc(r.t)+'</strong><div class="om">'+esc(r.m)+'</div></button>';
  });
  box.innerHTML = h;
  box.classList.add('on');
  const inp = $('omni');
  if(inp){
    inp.setAttribute('aria-expanded','true');
    const sel = box.querySelector('.oi.sel');
    if(sel) inp.setAttribute('aria-activedescendant', sel.id || '');
  }
  box.querySelectorAll('.oi').forEach(b=>
    b.onclick = ()=>{ omniPick(+b.dataset.i); });
}
function omniPick(i){
  const r = OMNI.rows[i]; if(!r) return;
  omniClose();
  try{ r.go(); }catch(e){}
  /* omniClose() blurs the input, so a keyboard user was left on <body> with no
     focus at all. Land them on the view they just chose. */
  try{
    const t = $(cur);
    if(t){ t.setAttribute('tabindex','-1'); t.focus({preventScroll:true}); }
    say('Opened '+r.t);
  }catch(e){}
}
function omniClose(){
  const box = $('omniOut'); if(box){ box.classList.remove('on'); box.innerHTML=''; }
  if($('omni')) $('omni').setAttribute('aria-expanded','false');
  OMNI.rows = []; OMNI.sel = -1;
  if($('omni')) $('omni').blur();
}
if($('omni')){
  let deb = null;
  $('omni').addEventListener('input', e=>{
    clearTimeout(deb);
    const q = e.target.value;
    deb = setTimeout(()=>{
      OMNI.rows = S.loaded ? omniMatch(q) : [];
      OMNI.sel = OMNI.rows.length ? 0 : -1;
      if(q.trim().length >= 2 && !OMNI.rows.length){
        const box = $('omniOut');
        box.innerHTML = '<div class="oh">No match</div><div class="oi" style="cursor:default">'+
          '<strong>Nothing in memory matches that</strong><div class="om">'+
          (S.loaded
            ? 'Try an account, a deal, or what you want to do &mdash; "objection", '+
              '"forecast", "usage". People are only searchable after you have opened '+
              'that family on Stakeholders.'
            : 'Still loading from Salesforce &mdash; try again in a moment.')+
          '</div></div>';
        box.classList.add('on');
        return;
      }
      omniRender();
    }, 130);
  });
  $('omni').addEventListener('keydown', e=>{
    if(e.key === 'Escape'){ e.target.value=''; omniClose(); return; }
    if(!OMNI.rows.length) return;
    if(e.key === 'ArrowDown'){ e.preventDefault(); OMNI.sel = (OMNI.sel+1) % OMNI.rows.length; omniRender(); }
    else if(e.key === 'ArrowUp'){ e.preventDefault(); OMNI.sel = (OMNI.sel-1+OMNI.rows.length) % OMNI.rows.length; omniRender(); }
    else if(e.key === 'Enter'){ e.preventDefault(); omniPick(OMNI.sel < 0 ? 0 : OMNI.sel); }
  });
  document.addEventListener('click', e=>{
    if(!e.target.closest('.omni')) omniClose();
  });
  /* "/" focuses search the way it does in Salesforce and GitHub. */
  document.addEventListener('keydown', e=>{
    const tag = (e.target.tagName||'').toLowerCase();
    if(e.key === '/' && tag !== 'input' && tag !== 'textarea' && tag !== 'select'){
      e.preventDefault(); $('omni').focus();
    }
  });
}
if($('anPeriod')) $('anPeriod').addEventListener('change', ()=>loadActivity());
if($('fClear'))   $('fClear').onclick = clearPipeFilters;
if($('sClear'))   $('sClear').onclick = clearSfrFilters;
['fFam','fAcct','fCat','fReal','fZomb','fDig','fView'].forEach(id=>{
  const el=$(id); if(el) el.addEventListener('change',
    (id==='fDig'||id==='fView')
      ? ()=>{ if(id==='fView') DRILL = null;   // dimension changed, drill is stale
              renderPipeline(); }
      : applyFilters);
});
/* Charts carry their own colours for light and dark; redraw on scheme change. */
if(window.matchMedia) window.matchMedia('(prefers-color-scheme: dark)')
  .addEventListener('change', ()=>{ if(S.loaded && cur==='pipeline') renderPipeline(); });
['sAcct'].forEach(id=>{ const el=$(id); if(el) el.addEventListener('change',applySfr); });
/* safely(), like pvGo: a throw in here used to be console-only. */
['pvAcct','pvAud','pvGoal'].forEach(id=>{
  const el=$(id); if(el) el.addEventListener('change',()=>{
    if($('pvAcct').value) safely('pov', renderPov); });
});
/* renderInbox, not applyInbox: the tiles read iFam and iExt now, so filtering
   has to repaint them or they describe the unfiltered set. */
['iFam','iWait','iExt'].forEach(id=>{
  const el=$(id); if(el) el.addEventListener('change',()=>renderInbox());
});
if($('iDone')) $('iDone').addEventListener('change',()=>renderInbox());
if($('iRestore')) $('iRestore').onclick = ()=>{
  /* Only clears inbox and Slack dismissals — resolved Signals stay resolved. */
  Object.keys(DONE).forEach(k=>{ if(k.startsWith('mail:')||k.startsWith('dm:')) delete DONE[k]; });
  /* renderToday() calls renderCal(), which rebuilds ~180 elements and ~8KB of
     innerHTML. Doing that from the Inbox tab meant every dismissal paid for a
     calendar the user could not see. calDirty already exists for this. */
  saveDone(); renderInbox();
  if(cur === 'today') renderToday(); else calDirty = true;
};
['sQtr','sStat','sOpen'].forEach(id=>{
  const el=$(id); if(el) el.addEventListener('change',applySfr);
});

/* Global product scope. Re-renders everything; no refetch needed. */
if($('scopeSel')){
  $('scopeSel').value = SCOPE;
  $('scopeSel').addEventListener('change', e=>{
    SCOPE = e.target.value;
    try{ localStorage.setItem(LS.scope, SCOPE); }catch(err){}
    /* The Pipeline tab has its own product select. It was never synced, so
       switching the header to All products changed the tiles and left the table
       filtered to Digital — two numbers, no explanation. */
    if($('fDig')) $('fDig').value = (SCOPE === 'all') ? 'all' : 'digital';
    /* renderAll() already paints the current tab — the extra renderPipeline()
       that used to live here parsed another 493KB of HTML for nothing. */
    if(S.loaded) renderAll();
    scopeBanner();
  });
}

/* Calendar navigation. Steps by however many days are on screen, and fetches
   more calendar if you page outside what is loaded. */
async function gotoWeek(off){
  weekOff = off;
  const need = off*calSpan();
  if(need < calLoaded.from + 7 || need > calLoaded.to - 7){
    const from = Math.min(calLoaded.from, need - 14);
    const to   = Math.max(calLoaded.to,   need + 21);
    $('calRange').textContent = 'loading…';
    try{
      /* Fetch only the part that is missing and merge by event id. This used to
         refetch the WHOLE window to extend it, so each forward page
         re-downloaded everything already in memory — by the fourth step it was
         re-pulling ~100 days to add 21. */
      const adds = [];
      if(from < calLoaded.from) adds.push(fetchEvents(from, calLoaded.from));
      if(to   > calLoaded.to)   adds.push(fetchEvents(calLoaded.to, to));
      const got = await Promise.all(adds);
      const byId = new Map((S.events||[]).map(e=>[e.id, e]));
      got.forEach(list=>list.forEach(e=>{ if(e && e.id) byId.set(e.id, e); }));
      S.events = [...byId.values()];
      /* Only widen the recorded window if nothing was truncated, or the guard
         above would think a partial window was complete. */
      if(!fetchEvents.partial) calLoaded = {from, to};
      setPill('pCal', fetchEvents.partial?'warn':'ok',
              'Calendar · '+S.events.length+(fetchEvents.partial?' (partial)':''));
    }catch(e){ setPill('pCal','err','Calendar failed'); }
  }
  renderCal();
}
if($('calPrev'))  $('calPrev').onclick  = ()=>gotoWeek(weekOff-1);
if($('calNext'))  $('calNext').onclick  = ()=>gotoWeek(weekOff+1);
if($('calToday')) $('calToday').onclick = ()=>gotoWeek(0);

/* The day span depends on viewport width, so a resize past a breakpoint has to
   redraw the grid or the columns stop matching the header. Debounced. */
/* The subnav sticks below the navbar, which wraps to two rows on a narrow
   screen. Measure it instead of guessing. */
function setNavHeight(){
  const bar = document.querySelector('.navbar');
  if(bar) document.documentElement.style.setProperty('--navh', bar.offsetHeight+'px');
}
setNavHeight();
window.addEventListener('resize', setNavHeight);
window.addEventListener('load', setNavHeight);

let _calRz = null, _calSpanWas = calSpan();
let calDirty = false;
window.addEventListener('resize', ()=>{
  clearTimeout(_calRz);
  _calRz = setTimeout(()=>{
    const now = calSpan();
    if(now === _calSpanWas) return;
    _calSpanWas = now; weekOff = 0;
    /* Resizing while on another tab used to leave the grid permanently stale:
       the span was recorded as up to date, but the redraw never happened and
       paint() skips an already-painted tab. Remember it needs one. */
    if(cur === 'today' && S.loaded) renderCal();
    else calDirty = true;
  }, 220);
});

/* Chart.js is async now so it no longer blocks the 11 connector calls. When it
   lands, repaint whichever chart-bearing tab is open. If it never lands,
   drawChart's guard keeps every table and number working. */
(function chartReady(){
  const s = document.querySelector('script[src*="chart.js"]');
  if(!s) return;
  s.addEventListener('load', ()=>{
    if(S.loaded && (cur==='pipeline' || cur==='analytics')) paint(cur, true);
  });
  s.addEventListener('error', ()=>{
    console.warn('Chart.js failed to load — tables and figures still work.');
  });
})();

/* Keyboard parity for every div/card/row that behaves like a button. None of
   these were reachable without a mouse. */
document.addEventListener('keydown', e=>{
  if(e.key !== 'Enter' && e.key !== ' ') return;
  const t = e.target;
  if(!t || !t.matches) return;
  if(t.matches('.kpi.click, #famGrid .card, #peopleFams .list-item, .stk')){
    e.preventDefault(); t.click();
  }
});

/* The global scope persists across sessions, so it needs to be visible on
   every tab — not just as a warning on one. */
/* Every connector failure, on every tab, in one place. S.err.sf used to appear
   only inside the Accounts note — so when Salesforce stopped answering, the
   default tab showed empty numbers and an amber pill and said nothing. */
const CONN = [
  {k:'sf',    n:'Salesforce (opportunities)'},
  {k:'sfr',   n:'Salesforce (specialist forecasts)'},
  {k:'team',  n:'Salesforce (account team)'},
  {k:'drive', n:'Google Drive'},
  {k:'slack', n:'Slack'},
  {k:'mail',  n:'Gmail'},
  {k:'dm',    n:'Slack DMs'},
  {k:'cal',   n:'Google Calendar'},
  {k:'ent',   n:'Salesforce (usage & entitlements)'},
  {k:'won',   n:'Salesforce (closed won, for HPF attainment)'},
  {k:'hpfRow',n:'Salesforce CRM Analytics (the real HPF KPIs)'},
];
/* Connector errors arrive as host or API strings. Say what they mean. */
function plainErr(m){
  const t = String(m||'');
  if(/not currently shown/i.test(t))
    return 'the window was in the background when this loaded, so the read was refused — hit Retry';
  if(/INVALID_SESSION|session.*expir|40[13]/i.test(t))
    return 'your Org62 session looks expired — sign in to Org62 in another tab, then Retry';
  if(/not permitted|bridge is not available/i.test(t))
    return 'this app was refused permission to call that connector (a wiring problem, not a login one)';
  if(/is not a function|is not defined|before initialization/i.test(t))
    return 'a bug in this build: '+t;
  return t;
}
function connBanner(){
  const bad = CONN.filter(c=>S.err[c.k]);
  /* RENDER_ERR was recorded on every caught render throw and never read here, so
     a tab that failed to paint said so only in its own note div — invisible from
     any other tab. */
  const broke = Object.keys(RENDER_ERR||{});
  const FAULTS = buildFaults();
  let el = $('connBanner');
  if(!bad.length && !FAULTS.length && !broke.length){ if(el) el.remove(); return; }
  if(!el){
    el = document.createElement('div');
    el.id = 'connBanner';
    el.className = 'note err';
    el.className += ' edgeBanner';
    el.style.cssText = 'border-radius:0 0 var(--r-xs) var(--r-xs)';
    /* After the subnav, not the navbar — otherwise the banner wedges between
       the two sticky rows and pushes the subnav off the top. */
    const anchor = document.querySelector('#subnav') || document.querySelector('.navbar');
    anchor.parentNode.insertBefore(el, anchor.nextSibling);
  }
  /* Salesforce feeds most of the app, so name the consequence rather than
     leaving him to work out why the numbers look wrong. */
  const sfDown = !!(S.err.sf || S.err.sfr);
  el.innerHTML =
    (FAULTS.length
      ? '<strong>This build is misconfigured.</strong><ul style="margin:6px 0 0;padding-left:18px">'+
        FAULTS.map(m=>'<li>'+esc(m)+'</li>').join('')+'</ul>'+
        '<div style="margin:6px 0">Nothing below will be right until that is fixed. '+
        'This is a code problem, not a login problem.</div>'
      : '')+
    (broke.length
      ? '<strong>'+broke.length+' view'+(broke.length===1?'':'s')+' failed to render.</strong> '+
        '<ul style="margin:6px 0 8px;padding-left:18px;line-height:1.65">'+
          broke.map(k=>'<li><strong>'+esc(k)+':</strong> '+esc(plainErr(RENDER_ERR[k]))+'</li>').join('')+
        '</ul>'
      : '')+
    (bad.length
      ? '<strong>'+bad.length+' data source'+(bad.length===1?'':'s')+' did not answer.</strong> '+
        (sfDown ? 'Salesforce is one of them, so pipeline, forecast, accounts, stakeholders and '+
                  'analytics are all incomplete or empty on this load. ' : '')+
        '<ul style="margin:6px 0 0;padding-left:18px;line-height:1.65">'+
          bad.map(c=>'<li><strong>'+esc(c.n)+':</strong> '+esc(plainErr(S.err[c.k]))+'</li>').join('')+
        '</ul>'
      : '')+
    '<div style="margin-top:8px">'+
      (sfDown && /not permitted|bridge is not available/i.test(String(S.err.sf||S.err.sfr))
        ? 'This one is a wiring problem, not an expired session: the page was refused permission '+
          'to call the Salesforce connector. Re-publishing the app with the Salesforce tool in its '+
          'allowed list is the fix. '
        : sfDown && /40[13]|session|expired|INVALID_SESSION/i.test(String(S.err.sf||S.err.sfr))
          ? 'That reads like an expired Org62 session. Sign in to Org62 in another tab, then Reload. '
          : '')+
      '<button class="btn sm ghost" id="connRetry">Retry all sources</button>'+
    '</div>';
  const r = $('connRetry');
  if(r) r.onclick = ()=>{ r.disabled = true; r.textContent = 'Retrying…'; reloadAll(); };
}

function scopeBanner(){
  let el = $('scopeBanner');
  if(SCOPE === 'digital'){ if(el) el.remove(); return; }
  if(!el){
    el = document.createElement('div');
    el.id = 'scopeBanner';
    el.className = 'note warn';
    el.className += ' edgeBanner';
    el.style.cssText = 'border-radius:0 0 var(--r-xs) var(--r-xs)';
    /* .navbar, not .nav — .nav is now a flex child of .navbar, and inserting a
       full-width banner inside a flex row squashed it into a column. */
    /* After the subnav, not the navbar — otherwise the banner wedges between
       the two sticky rows and pushes the subnav off the top. */
    const anchor = document.querySelector('#subnav') || document.querySelector('.navbar');
    anchor.parentNode.insertBefore(el, anchor.nextSibling);
  }
  /* SCOPE only reaches scoped(), which feeds five tabs. The banner used to say
     "these figures" on every tab, including four where nothing changes — which
     is a false warning exactly where he reads his own number. */
  el.innerHTML = '<strong>Scope: everything on your accounts.</strong> '+
    (['pipeline','book','byae','today','signals'].indexOf(cur) >= 0
      ? 'The figures on this tab include Sales, Service and Platform deals owned by '+
        'other specialists — not just your Digital number. '
      : 'This affects Pipeline, Account families, By core AE, Today and Signals. '+
        'Nothing on this tab changes with it. ')+
    '<button class="btn sm ghost" id="scopeReset">Back to Digital only</button>';
  const b = $('scopeReset');
  if(b) b.onclick = ()=>{
    SCOPE = 'digital';
    try{ localStorage.setItem(LS.scope,'digital'); }catch(err){}
    if($('scopeSel')) $('scopeSel').value = 'digital';
    if(S.loaded) renderAll();
    scopeBanner();
  };
}
scopeBanner();

/* Errors go to the tab he is actually looking at, not always to Accounts. */
function loadFailed(e){
  /* The POV tab renders a "still loading" note while S.loaded is false, and a
     hard failure means it never flips — so that note has to be resolved here or
     it spins forever for anyone already sitting on the tab. */
  if(cur === 'pov'){
    try{ safely('pov', RENDER.pov); }catch(err){}
    /* And write the error somewhere of its own. povNote carries the "read these
       cautions before this goes near a customer" block; a transient network
       failure must not delete it. */
    const pw = $('povWait');
    /* Before the return: only the success path rewrites this, so an early exit
       here left the header pill reading "loading…" forever. */
    if($('pTime')) $('pTime').textContent = 'load failed';
    connBanner();
    if(pw){ pw.innerHTML = '<div class="note err">'+esc(plainErr(e.message))+
      ' &mdash; the embedded strategy below is unaffected. Hit Reload in the '+
      'header for the live Org62 figures.</div>'; return; }
  }
  const host = $(cur==='sfr'?'sfrNote':cur==='today'?'todayNote':cur==='inbox'?'inboxNote':
                 cur==='signals'?'sigNote':cur==='analytics'?'anNote':
                 cur==='pov'?'povNote':cur==='renewals'?'renewalsNote':
                 cur==='byae'?'byaeNote':cur==='hpf'?'hpfNote':'bookNote');
  const msg = /40[13]/.test(e.message||'') ? 'Your Org62 session looks expired — sign in to '+
                'Salesforce, then press Reload.'
            : /timeout|timed out/i.test(e.message||'') ? 'Salesforce timed out. Press Reload.'
            : esc(e.message||'unknown error');
  if(host) host.innerHTML = '<div class="note err"><strong>Could not load.</strong> '+msg+'</div>';
  $('pTime').textContent = 'failed';
}

/* The app used to tell the user to "hit Reload in the header" — there was no
   Reload in the header. Now there is. */
function reloadAll(){
  const b = $('reloadBtn');
  if(b){ b.disabled = true; b.textContent = '↻ Reloading…'; }
  invalidateDerived();
  S.loaded = false;
  S.err = {};                 /* clear stale failures or the banner never leaves */
  COUNT_FAILED.clear(); COUNT_FLOOR.clear();  /* and the nav badges' copies */
  S.got = {};
  /* These survived a reload and served pre-reload numbers with no indication.
     calLoaded was the worst: loadAll replaces S.events with a -14..+45 window
     but left calLoaded widened, so paging forward again skipped the fetch and
     rendered an empty week. */
  Object.keys(ACT_RESULT).forEach(k=>delete ACT_RESULT[k]);
  Object.keys(charts).forEach(k=>{ try{ charts[k].destroy(); }catch(e){}
                                   delete charts[k]; });
  Object.keys(ACT_CAL).forEach(k=>delete ACT_CAL[k]);
  Object.keys(S.contacts).forEach(k=>delete S.contacts[k]);
  calLoaded = {from:-14, to:45};
  weekOff = 0;
  PILLS.forEach(([id,label])=>setPill(id,'idle',label));
  return loadAll().catch(loadFailed).finally(()=>{
    if(b){ b.disabled = false; b.textContent = '↻ Reload'; }
  });
}
if($('reloadBtn')) $('reloadBtn').onclick = reloadAll;

renderAdvisor();
loadAll().catch(loadFailed);
</script>
</body>
