const PORT_TAG = {mc:'active', d360:'teal', af:'p', sig:'g'};
const portTag = k => PORT_TAG[k] || 'grey';

const SS_TYPE = 'Success Plan';
const isSuccessPlan = o => String(o.Type||'') === SS_TYPE;

/* ── The specialist amount ───────────────────────────────────────────────
   THIS is his number, and using Opportunity.Amount instead was the single
   biggest distortion in the app.

   Worked example. A deal carries Amount = $1,000,000, of which Data 360 is
   $90,000 and Agentforce $90,000. Specialist credit is $180,000; the other
   $820,000 is Sales, Service, Platform and industry cloud — the core AE's
   number, not yours. Summing Amount inflates that one deal 5.5x, and the
   difference shows up as a large "Not yet attributed" slice.

