function renderRenewals(){
  const box = $('renewBox'); if(!box) return;
  /* Renewals are deliberately NOT run through the specialist scope. A renewal
     is the whole contract coming up for renegotiation — it has no specialist
     product split, so requiring one would hide every single record. They are
     context for his accounts, not his pipeline, and they are counted and
     displayed at full contract value with that said plainly. */
  const rows = S.opps
    .filter(o=>RENEW_RE.test(o.Type||''))
    .filter(isLive)
    .filter(o=>famOfOpp(o).slug !== 'other')
    .sort((a,b)=>String(a.CloseDate||'').localeCompare(String(b.CloseDate||'')));

  /* count owned by navCounts() */

  if(!rows.length){
    $('renewalsNote').innerHTML = '';
    $('renewKpis').innerHTML = '';
    box.innerHTML = '<div class="card"><div class="empty">'+
      (S.err.sf
        ? 'Salesforce read failed &mdash; cannot see renewals. Hit Reload in the header.'
