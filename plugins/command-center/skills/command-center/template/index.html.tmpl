  $('driveBody').innerHTML = docs.length ? docs.map(d=>
    '<tr><td><a href="'+esc(safeUrl(d.viewUrl))+'" target="_blank" rel="noopener noreferrer">'+esc(d.title)+'</a></td>'+
    '<td><span class="tag '+famFor(d).tier+'">'+esc(famFor(d).disp)+'</span></td>'+
    '<td><span class="chip">'+esc(mime(d.mimeType))+'</span></td>'+
    '<td>'+fmtDate((d.modifiedTime||'').slice(0,10))+'</td></tr>').join('')
    : '<tr><td colspan="4" class="empty">'+(S.err.drive?'Drive read failed: '+esc(S.err.drive):'No documents found.')+'</td></tr>';

  $('slackBox').innerHTML = S.slack
