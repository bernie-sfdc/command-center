          fmtDate(RENEW_END)+'. Anything landing in FY28 is deliberately out of '+
          'scope &mdash; territory changes with the fiscal year.')+
      '</div></div>';
    return;
  }

  /* Bands, not a flat list: what he does about a renewal 30 days out is not
     what he does about one 9 months out. */
  const BANDS = [
    /* A past-due renewal used to land in "Inside 30 days" because the first band
       had no lower bound — so a row reading "18d overdue" sat under a heading
       saying it was still ahead. */
    {k:'late', lbl:'Past due',         max:-1,  cls:'r',
     act:'The close date has already passed. Re-date it or close it — it is '+
         'distorting the forecast either way.'},
    {k:'now',  lbl:'Inside 30 days',   max:30,  cls:'r',
     act:'Paper should already be moving. If it is not, escalate today.'},
    {k:'q',    lbl:'30 – 90 days',     max:90,  cls:'o',
     act:'Uplift case and the expansion ask land now, before procurement locks the number.'},
    {k:'half', lbl:'90 – 180 days',    max:180, cls:'t',
     act:'Value review window. This is where an MCE+ or Data 360 attach gets agreed.'},
    {k:'far',  lbl:'180 days and out', max:1e9, cls:'p',
     act:'Watch only, and capped at '+fmtDate(RENEW_END)+' — the fiscal year end. '+
         'A renewal beyond it is not shown anywhere in this app, because '+
         'territory and account assignments change on 1 February and it may not '+
         'be yours to work.'},
  ];
  const put = {};
  rows.forEach(o=>{
    /* Local-midnight arithmetic, same as daysAgo — and no sentinel: a renewal
       with no close date used to print "in 900000d". */
    const d = o.CloseDate ? -daysAgo(o.CloseDate) : null;
    const b = d==null ? BANDS[BANDS.length-1]
                      : (BANDS.find(x=>d <= x.max) || BANDS[BANDS.length-1]);
    (put[b.k] = put[b.k] || []).push({o, d});
  });

  $('renewalsNote').innerHTML = truncNote() + dropNote() +
    '<div class="note"><strong>'+rows.length+' open renewal opportunit'+
      (rows.length===1?'y':'ies')+'</strong> '+
      'across your accounts closing on or before '+fmtDate(RENEW_END)+
      ', at full contract value. Most carry no product split, '+
      'so most are not part of your specialist pipeline &mdash; but a Marketing '+
      'Cloud renewal does carry a Marketing amount, and those <strong>are</strong> '+
      'also counted on Pipeline. The "mine" column tells you which. A renewal '+
      'window is the cheapest moment to attach Marketing Cloud, Data 360 or '+
      'Agentforce, which is why they are here. Salesforce contract records are '+
      'deliberately not used: on these accounts they are mostly auto-generated '+
      'AppExchange licence rows rather than subscription terms. Renewals on '+
      'accounts outside your mapped families are not shown &mdash; there are '+
      esc(String(S.opps.filter(o=>RENEW_RE.test(o.Type||'')).filter(isLive)
        .filter(o=>famOfOpp(o).slug === 'other').length))+
      ' of those.</div>';
  $('renewKpis').innerHTML =
      BANDS.map(b=>{ const g = put[b.k]||[];
        return kpi(b.cls, b.lbl, g.length,
          g.length ? money(g.reduce((t,x)=>t+(Number(x.o.Amount)||0),0))+
                     ' contract value' : 'nothing here');
      }).join('');
  box.innerHTML =
    BANDS.filter(b=>(put[b.k]||[]).length).map(b=>
      '<div class="card" style="margin-bottom:12px">'+
        '<h3>'+esc(b.lbl)+' <span class="tag '+(b.k==='now'?'risk':'grey')+'">'+
          (put[b.k].length)+'</span></h3>'+
        '<div class="meta" style="margin:5px 0 10px">'+esc(b.act)+'</div>'+
        '<div class="tw"><table><thead><tr><th>Renewal</th><th>Account</th>'+
          '<th>Stage</th><th class="num">Amount</th><th>Closes</th><th>Owner</th>'+
          '<th>Last touch</th></tr></thead><tbody>'+
        put[b.k].map(({o,d})=>{
          const st = daysAgo(o.LastActivityDate);
          return '<tr>'+
            '<td><a href="'+SF_URL+'Opportunity/'+idAttr(o.Id)+'/view" target="_blank" '+
              'rel="noopener noreferrer">'+esc(o.Name)+' ↗</a>'+
              (/uplift/i.test(o.Type||'')?' <span class="tag g">uplift</span>':'')+
              (portOf(o).length?' '+portOf(o).map(x=>
                '<span class="tag '+portTag(x.key)+'">'+
                esc(x.label)+'</span>').join(' '):'')+'</td>'+
            '<td style="font-size:11.5px">'+esc(o.Account&&o.Account.Name||'—')+'</td>'+
            '<td style="font-size:11px">'+esc(o.StageName)+'</td>'+
            '<td class="num"><strong>'+(Number(o.Amount)?moneyFull(o.Amount):'—')+'</strong>'+
              (specAmt(o)>0?'<div class="meta">'+money(specAmt(o))+' mine</div>':'')+'</td>'+
            '<td style="font-size:11.5px">'+fmtDate(o.CloseDate)+
              '<div class="meta">'+(d==null?'date not set'
                :d<0?Math.abs(d)+'d overdue':d===0?'today':'in '+d+'d')+'</div></td>'+
            '<td style="font-size:11px">'+esc(o.Owner&&o.Owner.Name||'—')+'</td>'+
            '<td style="font-size:11px">'+(st==null
              ? '<span style="color:var(--sf-red)">never</span>'
              : (st>60?'<span style="color:var(--sf-red)">'+st+'d</span>':st+'d'))+'</td></tr>';
        }).join('')+
        '</tbody></table></div>'+
      '</div>').join('');
