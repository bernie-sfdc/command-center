}

/* Mutual action plan. Dated, two-sided, and grounded in the record rather than
   a template — the gaps it names come from what the fields do not say. */
async function buildMap(id){
  const o = (S.opps||[]).find(x=>x.Id===id); if(!o) return;
  const box = $('map-'+id); if(!box) return;
  if(box.dataset.open === '1'){ box.innerHTML=''; box.dataset.open='0'; return; }
  box.dataset.open = '1';
  box.innerHTML = '<div class="empty" style="padding:11px"><span class="spin"></span> '+
    'Working back from the close date…</div>';

  const f = famOfOpp(o);
  const sfr = SFR_BY_OPP().get(o.Id);
  const days = o.CloseDate ? Math.round((Date.parse(o.CloseDate) - Date.now())/864e5) : null;
  const seg = segOf(f);
  const pd = PD[f.slug] || {};

  const facts = UNTRUSTED_NOTE +
    'DEAL: '+fence('DEAL', o.Name)+'\n'+
    'ACCOUNT: '+fence('ACCOUNT', (o.Account&&o.Account.Name)||'')+
      '   SEGMENT: '+((seg&&seg.label)||'')+'\n'+
    'CORE AE / OWNER: '+((o.Owner&&o.Owner.Name)||'unknown')+
      (coreAeOf(f.slug)?'   CORE AE ON ACCOUNT: '+coreAeOf(f.slug):'')+'\n'+
    'STAGE: '+(o.StageName||'')+'   FORECAST CATEGORY: '+(o.ForecastCategoryName||'not set')+'\n'+
    'TYPE: '+(o.Type||'not set')+'\n'+
    'CLOSE DATE: '+(o.CloseDate||'not set')+
      (days==null?'':'   ('+(days<0?Math.abs(days)+' days OVERDUE':days+' days out')+')')+'\n'+
    'MY SPECIALIST AMOUNT: '+(specAmt(o)?moneyFull(specAmt(o)):'none on the record')+
      '   WHOLE DEAL: '+(Number(o.Amount)?moneyFull(o.Amount):'no amount')+
      ' (the difference belongs to the core AE)\n'+
    'PRODUCT LINES: '+(portOf(o).map(p=>p.label+(p.src==='name'?' (name match only)':'')).join(', ')||'none identified')+'\n'+
    'LAST LOGGED ACTIVITY: '+(o.LastActivityDate?daysAgo(o.LastActivityDate)+' days ago':'never logged')+'\n'+
    'SPECIALIST FORECAST: '+(sfr
      ? (sfr.ForecastStatus__c||'no judgement')+' / '+(sfr.ForecastStage__c||'no stage')+
        ' / next steps: '+(String(sfr.Next_Steps__c||'').trim()
            ? fence('NEXT', sfr.Next_Steps__c) : 'blank')
      : (isL1(o)?'NONE — this is bucket L1 and needs one':'none required, bucket L2'))+'\n'+
    /* Whatever his own strategy work already established, so the plan does not
       restate what is known or ask for something already answered. */
    (pd.state?'WHERE THE ACCOUNT ACTUALLY STANDS: '+String(pd.state).slice(0,1100)+'\n':'')+
    (Array.isArray(pd.nextsteps)&&pd.nextsteps.length
      ?'NEXT STEPS ALREADY IN FLIGHT:\n- '+pd.nextsteps.slice(0,6).join('\n- ')+'\n':'')+
    (Array.isArray(pd.gaps)&&pd.gaps.length
      ?'KNOWN OPEN QUESTIONS ON THIS ACCOUNT:\n- '+pd.gaps.slice(0,6).join('\n- ')+'\n':'');

  const prompt = METHOD+'\n\n'+
    '=== THE RECORD ===\n'+facts+'\n'+
    'Write a MUTUAL ACTION PLAN: the dated path from today ('+today+') to a signed deal.\n\n'+
    'Rules:\n'+
    '- Work BACKWARDS from the close date. If the close date is in the past or leaves too little '+
    'time for the steps that remain, say so as the first line and propose a realistic date.\n'+
    '- Every step gets: a date, an owner (name a real one where the record gives you one — '+
    'otherwise "Salesforce" or "Customer" and the seat it needs), and a done-condition.\n'+
    '- Two columns of ownership: what Salesforce does, what the customer does. A plan where the '+
    'customer owns nothing is not a mutual action plan.\n'+
    '- Then a short section "What is missing before this is credible" — the qualification gaps '+
    'this record actually shows. Be specific about which one you cannot see rather than listing '+
    'everything generically.\n'+
    '- Then "Say this to get agreement on the plan" — three or four sentences he can send.\n'+
    '- Never name a methodology or framework. No jargon acronyms in the output.\n'+
    '- Never invent a person, a price, a contract term or a date the customer has agreed to. '+
    'Write [CONFIRM] where he must fill something in.\n'+
    '- Plain text. Short lines. No markdown headers.';

  try{
    const txt = await window.cowork.askClaude(prompt, []);
    box.innerHTML = '<div class="card" style="margin-top:10px">'+
      '<h3>Mutual action plan &mdash; '+esc((o.Name||'').slice(0,60))+'</h3>'+
      '<textarea id="mapTxt-'+id+'" rows="22">'+esc(String(txt||''))+'</textarea>'+
      '<div class="row" style="margin-top:9px">'+
        '<button class="btn ghost" id="mapCopy-'+id+'">Copy</button>'+
        '<button class="btn ghost" id="mapRedo-'+id+'">Rewrite</button>'+
        '<span class="sp"></span>'+
        '<span class="meta">Nothing is written to Salesforce. Replace every [CONFIRM] '+
          'before this goes to the customer.</span>'+
      '</div></div>';
    $('mapCopy-'+id).onclick = ()=>copyOut('mapTxt-'+id,'mapCopy-'+id);
    $('mapRedo-'+id).onclick = ()=>{ box.dataset.open='0'; buildMap(id); };
  }catch(e){
    box.innerHTML = '<div class="note err" style="margin-top:10px">Could not build it: '+
      esc(e.message)+'</div>';
  }
}
document.addEventListener('click', e=>{
  const b = e.target.closest('[data-map]');
  if(!b) return;
  e.stopPropagation();
  buildMap(b.dataset.map);
});

/* ── What I owe each core AE ─────────────────────────────────────────────
   Grouped by the core AE who owns the account, because that is how the work
   actually arrives. Reuses famRoll and needs no new query. */
function renderByAe(){
  const box = $('byaeBox'); if(!box) return;
  const live = scoped().filter(isLive);
  const groups = {};
  /* The record OWNER is the fact; the account's mapped core AE is context.
     This was the other way round, and on live data that filed deals under the
     account's mapped core AE — so the AEs who actually own that pipeline
     showed $0, and seven figures were credited to someone who owns none
     of it. Owner first, account mapping only as the fallback. */
  const keyFor = o => {
    const own = coreName(o.Owner && o.Owner.Name);
    if(own && isCoreAE(own)) return own;
    return coreAeOf(famOfOpp(o).slug) || 'Not a core AE';
  };
  live.forEach(o=>{
    const k = keyFor(o);
    (groups[k] = groups[k] || []).push(o);
  });
  const order = CORE_AES.filter(a=>groups[a])
    .concat(Object.keys(groups).filter(k=>CORE_AES.indexOf(k) === -1).sort());

  $('byaeNote').innerHTML = truncNote() + dropNote() + '<div class="note">Your open pipeline grouped by '+
    'the core AE who <strong>owns the record</strong> &mdash; '+CORE_AES.join(', ')+
    '. Where the owner is not one of them (a renewals queue, the Success team, '+
    'a solution engineer) the deal falls to whoever is the core AE on the '+
    'account. The Record owner column shows which case each row is. Amounts are '+
    '<strong>your</strong> share. "Needs an SFR" is the bucket L1 exposure you '+
    'carry on their deals; agree any opportunity change with them before making '+
    'it.</div>';

  if(!live.length){
    box.innerHTML = '<div class="card"><div class="empty">No open pipeline in '+
      'scope.</div></div>';
    return;
  }
  box.innerHTML = order.map(k=>{
    const rows = groups[k].slice().sort((a,b)=>specAmt(b)-specAmt(a));
    const tot  = rows.reduce((t,o)=>t+specAmt(o),0);
    const commit = rows.filter(o=>o.ForecastCategoryName==='Commit'||
                                  o.ForecastCategoryName==='Best Case')
                       .reduce((t,o)=>t+specAmt(o),0);
    /* SFR_KNOWN, matching the Pipeline row and Signals. Without it a failed SFR
       read reported every L1 deal as missing one, with a dollar figure. */
    const noSfr = SFR_KNOWN()
      ? rows.filter(o=>isL1(o) && !SFR_BY_OPP().get(o.Id) && realOpp(o)) : [];
    /* A deal never touched is the quietest one there is; filtering nulls out
       reported "30d" while something on the list had no activity at all. */
    const ages = rows.map(o=>{ const d = daysAgo(o.LastActivityDate);
                               return d == null ? Infinity : d; });
    const oldest = ages.length ? Math.max(...ages) : null;
    return '<div class="card" style="margin-bottom:14px">'+
      '<h3>'+esc(k)+' <span class="chip">'+money(tot)+'</span>'+
        '<button class="btn sm ghost" data-copytable="#ae-'+keyHash(k)+
          '" style="float:right;font-weight:500">Copy</button></h3>'+
      '<div class="kpis" style="margin:10px 0 12px">'+
        kpi('','My pipeline',money(tot),rows.length+' opportunit'+(rows.length===1?'y':'ies'))+
        kpi('t','Commit + best case',money(commit),'his forecast categories')+
        (SFR_KNOWN()
          ? kpi(noSfr.length?'r':'g','Needs an SFR',noSfr.length,
              noSfr.length?money(noSfr.reduce((t,o)=>t+specAmt(o),0))+' outside my number'
                          :'all L1 deals covered')
          : kpi('','Needs an SFR','—','SFR read failed — cannot verify'))+
        kpi((oldest===Infinity||oldest>45)?'o':'','Quietest deal',
            oldest==null?'—':oldest===Infinity?'never':oldest+'d',
            oldest===Infinity?'one deal has no activity ever logged'
                             :'since last logged activity')+
      '</div>'+
      '<div class="tw"><table id="ae-'+keyHash(k)+'"><thead><tr>'+
        '<th scope="col">Opportunity</th><th scope="col">Account</th>'+
        '<th scope="col">Stage</th><th scope="col" class="num">My amount</th>'+
        '<th scope="col">Close</th><th scope="col">Record owner</th>'+
        '<th scope="col">SFR</th>'+
      '</tr></thead><tbody>'+
      rows.slice(0,15).map(o=>{
        const sfr = SFR_BY_OPP().get(o.Id);
        const own = (o.Owner && o.Owner.Name) || '';
        return '<tr>'+
          '<td><a href="'+SF_URL+'Opportunity/'+idAttr(o.Id)+'/view" target="_blank" '+
            'rel="noopener noreferrer">'+esc(String(o.Name).slice(0,54))+' ↗</a></td>'+
          '<td style="font-size:11.5px">'+esc((o.Account&&o.Account.Name)||'—')+'</td>'+
          '<td style="font-size:11px">'+esc(o.StageName||'')+'</td>'+
          '<td class="num"><strong>'+moneyFull(specAmt(o))+'</strong></td>'+
          '<td style="font-size:11.5px">'+fmtDate(o.CloseDate)+'</td>'+
          /* Grouping prefers the account-team mapping over Owner.Name, so a deal
             can legitimately sit under one core AE while another owns the
             record. That used to be invisible. */
          '<td style="font-size:11px">'+esc(own||'—')+
            (own && coreName(own) !== k ? ' <span class="tag grey" title="Grouped under '+
              esc(k)+' by account alignment, not record ownership">not '+
              esc(String(k).split(' ')[0])+'</span>' : '')+'</td>'+
          '<td>'+(sfr?'<span class="tag g">'+esc(sfr.Name)+'</span>'
                     :!SFR_KNOWN()?'<span class="tag grey">unknown</span>'
                     :isL1(o)&&realOpp(o)?'<span class="tag risk">missing</span>'
                     :'<span class="tag grey">not needed</span>')+'</td>'+
        '</tr>';
      }).join('')+
      '</tbody></table></div>'+
      (rows.length>15?'<div class="meta" style="margin-top:7px">Showing the 15 '+
        'largest of '+rows.length+'.</div>':'')+
    '</div>';
  }).join('');
}

/* ── One ranked list of what to actually do today ────────────────────────
   Pulls from the four places this used to be scattered across: today's customer
   meetings, SFR hygiene flags, the highest-weight signals, and threads waiting
   on a reply. Each row carries its own action, so nothing here is a dead end. */
function renderTodayDo(){
  const box = $('todayDo'); if(!box) return;
  const items = [];
  const nowK = todayStr();

  /* Customer meetings today, prep-first. */
  (S.events||[]).filter(e=>e.status!=='cancelled' && evDayKey(e)===nowK && !isAllDay(e))
    .forEach(e=>{
      const ext = evAttendees(e).filter(isExternal);
      if(!ext.length) return;
      const f = evFam(e);
      const t = new Date(evStart(e)).toLocaleTimeString('en-US',
        {hour:'numeric',minute:'2-digit'}).replace(' ','');
      /* teal is "customer" everywhere else in this app; risk is the red used
         for zombies and past-due. A meeting that is going fine was the reddest
         thing on the page. */
      items.push({w:100, tag:'Customer meeting', cls:'teal',
        t:(e.summary||'(no title)')+' · '+t,
        d:(f?f.disp+' · ':'')+ext.length+' external attendee'+(ext.length===1?'':'s'),
        act:f?{label:'Open the account', go:()=>{ goTab('book', true); showFam(f.slug); }}:null});
    });

  /* SFR hygiene, largest first — these are what quietly cost the number. */
  (S.sfrs||[]).filter(sfrOpen).map(r=>({r, f:sfrFlags(r)})).filter(x=>x.f.length)
    .sort((a,b)=>amt(b.r)-amt(a.r)).slice(0,4)
    .forEach(({r,f})=>items.push({w:80 + Math.min(amt(r)/50000, 15),
      tag:'Forecast hygiene', cls:'warm',
      t:r.Name+' · '+(r.Account_Name__c||'')+' · '+money(amt(r)),
      d:f[0],
      /* Opens the edit panel on that record. Sending him to a tab with 40 rows
         to find it again is a signpost, not an action. */
      act:{label:'Fix this SFR', go:()=>{
        goTab('sfr', true);
        setTimeout(()=>editRecord('SpecialistForecast__c', r.Id, 'fix-'+idAttr(r.Id)), 80);
      }}}));

  /* Replies people are waiting on, external first. */
  waitingThreads().filter(t=>!isDone('mail:'+t.id))
    .filter(t=>isExternal(lastMsg(t).sender||''))
    .sort((a,b)=>msgSortKey(b)-msgSortKey(a)).slice(0,4)
    .forEach(t=>{
      /* Not a 10-char slice: it turns "Fri, 4 Sep 2026 …" into
       "Fri, 4 Sep", which V8 reads as 2001 — the row printed "9133 days ago"
       and every such thread tied at the weight ceiling. */
    /* internalDate is epoch MILLISECONDS as a string — Date.parse of a digit
       string is NaN, so this lost the age and the weight bonus. applyInbox
       already wrapped it correctly. */
    const m = lastMsg(t);
    const d = daysAgo(m.date || (m.internalDate ? new Date(+m.internalDate) : null));
      /* cls:'o' was a .kpi accent letter, not a .tag class — there is no
         .tag.o, so this pill rendered with no colour at all. */
      items.push({w:60 + (d==null?0:Math.min(d*2, 20)),
        tag:'Waiting on you', cls:'warm',
        t:(m.subject||'(no subject)'),
        d:(m.sender||'')+(d==null?'':' · '+(d===0?'today':d+' day'+(d===1?'':'s')+' ago')),
        act:{label:'Draft a reply', go:()=>{ goTab('inbox', true);
                                             setTimeout(()=>draftReply(t), 80); }}});
    });

  /* Anything already over its allowance. */
  usageRows().filter(x=>x.over && !isDone('use:'+x.r.Id)).slice(0,2)
    .forEach(x=>items.push({w:90, tag:'In overage', cls:'risk',
      t:x.acct+' · '+x.type,
      d:'Over the allowance now'+(x.upsell?' · upsell '+num(x.upsell):''),
      act:{label:'Go to usage', go:()=>{ goTab('signals', true);
        setTimeout(()=>{ const b=$('usageBox'); if(b)
          b.scrollIntoView({behavior:'smooth',block:'start'}); }, 80); }}}));

  items.sort((a,b)=>b.w-a.w);

  if(!items.length){
    box.innerHTML = '<div class="card"><div class="empty">Nothing pressing. '+
      'No customer meeting today, no forecast hygiene flag, no reply overdue and '+
      'nothing in overage. A good day to prospect.</div></div>';
    return;
  }
  box.innerHTML = '<div class="card" style="margin-bottom:16px">'+
    items.slice(0,9).map((it,i)=>
      '<div class="row" style="gap:9px;padding:9px 0;'+
        (i?'border-top:1px solid var(--line);':'')+'align-items:flex-start">'+
        '<span class="tag '+it.cls+'" style="flex:none;margin-top:1px">'+esc(it.tag)+'</span>'+
        '<div style="flex:1;min-width:0">'+
          '<strong style="font-size:12.5px">'+esc(String(it.t).slice(0,84))+'</strong>'+
          '<div class="meta" style="margin-top:2px">'+esc(String(it.d).slice(0,120))+'</div>'+
        '</div>'+
        (it.act?'<button class="btn sm ghost" data-todo="'+i+'" style="flex:none">'+
          esc(it.act.label)+'</button>':'')+
      '</div>').join('')+
    '</div>';
  box.querySelectorAll('[data-todo]').forEach(b=>{
    const it = items[+b.dataset.todo];
    if(it && it.act) b.onclick = it.act.go;
  });
}

/* ═══════════════ What changed since last time ═══════════════
   Signals was a snapshot with no memory: it could tell him a close date was in
   the past, but never that it MOVED. Being surprised on a forecast call is
   almost always about a delta, not a level.

   So: keep one small snapshot of every in-scope opportunity and SFR in
   localStorage, and diff against it. Amounts and dates only — no names, no
   account strings, because this is persisted to disk. Keyed by record Id, which
   is not confidential on its own. */
function readSnapshot(){
  try{ const raw = localStorage.getItem(LS.snap);
    if(!raw) return null;
    const s2 = JSON.parse(raw);
    return (s2 && s2.o && s2.s) ? s2 : null;
  }catch(e){ return null; }
}
/* Read ONCE, at parse time, before any load can overwrite it.
   The previous version called takeSnapshot() at the end of loadAll() and then
   diffed by re-reading localStorage — so changesSince() compared today's state
   against the snapshot written seconds earlier and always found nothing. Worse,
   it printed a confident "nothing moved" rather than failing visibly. */
const PREV_SNAP = readSnapshot();
let SNAP_WRITTEN = false;
function takeSnapshot(){
  /* Once per page load. reloadAll() must not destroy the baseline the user is
     still comparing against. */
  if(SNAP_WRITTEN) return;
  try{
    const snap = {t: Date.now(), o:{}, s:{}};
    /* What is stored, precisely, because this lands on disk outside the file:
         - a SALTED hash of each record Id (not the Id)
         - the specialist amount, in dollars, in the clear
         - the close date, in the clear
         - salted hashes of stage / category / judgement, and a counts flag
       So the file does not persist any name — not an account, a person or a
       deal. It does persist commercial figures and dates against an opaque
       key. The salt is per install and lives in the same store, which defeats
       precomputation rather than a determined local reader. */
    (S.opps||[]).filter(isDigital).forEach(o=>{ snap.o[keyHash(o.Id)] = [
      specAmt(o), o.CloseDate||'',
      keyHash(o.StageName||''), keyHash(o.ForecastCategoryName||'') ]; });
    (S.sfrs||[]).forEach(r=>{ snap.s[keyHash(r.Id)] = [
      amtRaw(r), r.ForecastCloseDate__c||'',
      keyHash(r.ForecastStage__c||''), keyHash(r.ForecastStatus__c||''),
      /* Toggling ExcludeFromCalculation__c moves a record's whole contribution
         between $X and $0 in every tile — the single field change with the
         largest effect on his number, and it was invisible to this diff. */
      sfrCounts(r) ? 1 : 0 ]; });
    localStorage.setItem(LS.snap, JSON.stringify(snap));
    SNAP_WRITTEN = true;
  }catch(e){}
}
/* Diff, newest-material-first. Returns {age, rows} or null on a first run. */
function changesSince(){
  const prev = PREV_SNAP;
  if(!prev) return null;
  const rows = [];
  const dayOf = ms => Math.max(0, Math.round((Date.now()-ms)/864e5));
  /* Stage and category are compared as hashes, so the diff can say THAT they
     changed but not what they were — an acceptable trade for not writing
     picklist values to disk. The amounts and dates are the actionable part. */
  (S.opps||[]).filter(isDigital).forEach(o=>{
    const p = prev.o[keyHash(o.Id)];
    if(!p){ rows.push({w:2, k:'new', o, t:'New in your pipeline',
      d:money(specAmt(o))+' · '+esc(o.StageName||'')}); return; }
    /* `p[0] && amtNow &&` meant $500K → $0 produced no row at all, which is the
       largest single-record move there is. Zero is a value. */
    const amtNow = specAmt(o);
    if(p[0] !== amtNow &&
       (!p[0] || !amtNow || Math.abs(amtNow-p[0]) / Math.max(p[0],amtNow) > 0.05))
      rows.push({w:(!amtNow || amtNow<p[0])?5:3, k:'amt', o,
        t:!amtNow ? 'My amount zeroed'
          : !p[0] ? 'My amount set'
          : amtNow<p[0] ? 'My amount cut' : 'My amount raised',
        d:money(p[0])+' → '+money(amtNow)});
    if((p[1]||'') !== (o.CloseDate||''))
      rows.push({w:(!o.CloseDate || o.CloseDate>p[1])?5:3, k:'date', o,
        t:!o.CloseDate ? 'Close date cleared'
          : !p[1] ? 'Close date set'
          : o.CloseDate>p[1] ? 'Close date slipped' : 'Close date pulled in',
        d:(p[1]?fmtDate(p[1]):'not set')+' → '+
          (o.CloseDate?fmtDate(o.CloseDate):'not set')});
    if(p[2] && o.StageName && p[2] !== keyHash(o.StageName))
      rows.push({w:4, k:'stage', o, t:'Stage changed',
        d:'now '+esc(o.StageName)});
    if(p[3] && o.ForecastCategoryName && p[3] !== keyHash(o.ForecastCategoryName))
      rows.push({w:4, k:'cat', o, t:'Forecast category changed',
        d:'now '+esc(o.ForecastCategoryName)});
  });
  (S.sfrs||[]).forEach(r=>{
    const p = prev.s[keyHash(r.Id)];
    if(!p) return;
    if(p[3] && r.ForecastStatus__c && p[3] !== keyHash(r.ForecastStatus__c))
      rows.push({w:5, k:'judge', sfr:r, t:'SFR judgement changed',
        d:'now '+esc(r.ForecastStatus__c)});
    const a2 = amtRaw(r);
    if(p[0] !== a2 &&
       (!p[0] || !a2 || Math.abs(a2-p[0]) / Math.max(p[0],a2) > 0.05))
      rows.push({w:(!a2 || a2<p[0])?5:3, k:'sframt', sfr:r,
        t:!a2 ? 'SFR amount zeroed'
          : !p[0] ? 'SFR amount set'
          : a2<p[0] ? 'SFR amount cut' : 'SFR amount raised',
        d:money(p[0])+' → '+money(a2)});
    if(p.length > 4 && p[4] !== (sfrCounts(r)?1:0))
      rows.push({w:6, k:'excl', sfr:r,
        t:sfrCounts(r)?'Back in the forecast':'Excluded from the forecast',
        d:sfrCounts(r)?'now counts '+money(amtRaw(r))
                      :'no longer counts &mdash; was '+money(p[0])});
  });
  /* Gone, not changed: closed, re-owned, or slipped past the horizon. Silence
     about a deal leaving is the same failure as silence about it slipping. */
  const nowO = new Set((S.opps||[]).filter(isDigital).map(o=>keyHash(o.Id)));
  Object.keys(prev.o).forEach(k=>{
    if(nowO.has(k)) return;
    rows.push({w:5, k:'gone', gone:true, t:'No longer in your book',
      d:'was '+money(prev.o[k][0])+' closing '+fmtDate(prev.o[k][1])+
        ' — closed, re-owned, or past the horizon'});
  });
  rows.sort((a,b)=>b.w-a.w);
  return {age: dayOf(prev.t), rows};
}
function renderChanges(){
  const box = $('changeBox'); if(!box) return;
  const c = changesSince();
  if($('changeCount')) $('changeCount').textContent = c ? c.rows.length : '';
  if(!c){
    box.innerHTML = '<div class="card"><div class="empty">'+
      'Nothing to compare against yet &mdash; this is the first load that recorded a '+
      'snapshot. From your next visit onward this shows what moved since the last '+
      'time you opened the app.</div></div>';
    return;
  }
  const when = c.age===0 ? 'earlier today' : c.age===1 ? 'yesterday' : c.age+' days ago';
  if(!c.rows.length){
    box.innerHTML = '<div class="card"><div class="empty">Nothing moved since '+
      esc(when)+'. No amount, date, stage, forecast category or SFR judgement '+
      'changed on your Digital book.</div></div>';
    return;
  }
  box.innerHTML =
    '<div class="note">Compared against your last visit, '+esc(when)+'. '+
      'Slips, cuts and backward stage moves are listed first &mdash; those are the '+
      'ones that change your number.</div>'+
    '<div class="tbl-wrap"><table><thead><tr>'+
      '<th>What changed</th><th>Record</th><th>Was → now</th><th></th>'+
    '</tr></thead><tbody>'+
    c.rows.slice(0,30).map(r=>{
      const bad = r.w >= 4;
      const nm = r.gone ? 'a deal that left your book'
        : r.o ? r.o.Name : (r.sfr.Name+' · '+(r.sfr.Account_Name__c||''));
      const url = r.gone ? null
        : r.o ? SF_URL+'Opportunity/'+idAttr(r.o.Id)+'/view'
              : SF_URL+'SpecialistForecast__c/'+idAttr(r.sfr.Id)+'/view';
      return '<tr><td><span class="tag '+(bad?'risk':'grey')+'">'+esc(r.t)+'</span></td>'+
        '<td>'+(url
          ? '<a href="'+url+'" target="_blank" rel="noopener noreferrer">'+
            esc(String(nm).slice(0,58))+' ↗</a>'
          : '<span style="color:var(--ink-3)">'+esc(nm)+'</span>')+
          (r.o && r.o.Account ? '<div class="meta">'+esc(r.o.Account.Name||'')+'</div>' : '')+
        '</td>'+
        '<td style="font-size:11.5px">'+r.d+'</td>'+
        '<td style="font-size:11px">'+esc(r.gone ? '—'
          : r.o ? (r.o.Owner&&r.o.Owner.Name||'') : 'your SFR')+'</td>'+
      '</tr>';
    }).join('')+
    '</tbody></table></div>'+
    (c.rows.length>30?'<div class="meta" style="margin-top:7px">Showing the 30 that '+
      'matter most of '+c.rows.length+'.</div>':'');
}

/* ═══════════════ WRITE tab ═══════════════
   No new generation logic: it reuses draft(), handleObjection() and the METHOD
   prompt layer. What is new is that all of it is reachable in one place instead
   of being scattered three and four clicks deep across the old flat tabs. */
function renderWrite(){
  const fams = famRoll().filter(f=>f.accts.size);
  fillSelect('wFam', fams.map(f=>({v:f.slug, l:f.disp})), '— pick one —');
  fillSelect('wObjFam', fams.map(f=>({v:f.slug, l:f.disp})), 'Pick a family for context');
  fillWriteWho();

  const open = (S.sfrs||[]).filter(sfrOpen);
  const cq = open.filter(r=>normQ(r.FiscalQuarter__c)===CUR_Q);
  $('writeKpis').innerHTML =
    kpi('','This quarter',money(cq.reduce((t,r)=>t+amt(r),0)),
        cq.length+' open SFRs in '+CUR_Q)+
    kpi('t','Commit',money(open.filter(r=>r.ForecastStatus__c==='Commit')
        .reduce((t,r)=>t+amt(r),0)),'your judgement, any quarter')+
    kpi('o','Needs a next step',
        open.filter(r=>!String(r.Next_Steps__c||'').trim()).length,
        'open SFRs with the field blank');
  $('writeNote').innerHTML = '<div class="note">Everything here reads your live '+
    'Salesforce, Gmail and Drive data. Drafts are drafts &mdash; nothing sends and '+
    'nothing is written to Salesforce.</div>';
}
/* The person list depends on which family is chosen, and contacts only exist
   once that family has been read. Offer to load it rather than showing an
   empty select with no explanation. */
function fillWriteWho(){
  const slug = $('wFam') ? $('wFam').value : '';
  const sel = $('wWho'); if(!sel) return;
  if(!slug){ fillSelect('wWho', [], '— pick a family first —'); return; }
  const rows = S.contacts[slug];
  if(!rows){
    fillSelect('wWho', [], 'loading contacts…');
    /* Once only: loadContacts now always records a result, so a failure lands
       in the branch below rather than re-entering here. */
    loadContacts(slug).then(fillWriteWho);
    return;
  }
  fillSelect('wWho', rows.map((c,i)=>({v:String(i),
    l:c.Name + (c.Title ? ' — '+String(c.Title).slice(0,42) : '')})),
    rows.length ? '— pick a person —' : 'no contacts on this family');
}
if($('wFam'))    $('wFam').addEventListener('change', fillWriteWho);
if($('wGo'))     $('wGo').onclick = ()=>{
  const slug = $('wFam').value, idx = $('wWho').value, kind = $('wKind').value;
  if(!slug || idx===''){ $('wOut').innerHTML =
    '<div class="note warn" style="margin-top:10px">Pick a family and a person first.</div>';
    return; }
  draft(slug, +idx, kind, 'wOut');
};
if($('wObjGo')) $('wObjGo').onclick = ()=>handleObjection('wObjFam','wObjIn','wObjOut');

/* ── Forecast narrative ──────────────────────────────────────────────
   The single highest-value thing the app was missing: he had tiles, and a
   forecast call needs prose. Everything it needs is already in memory. */
async function writeForecast(){
  const out = $('fnOut'); if(!out) return;
  const aud = $('fnAud') ? $('fnAud').value : 'mike';
  out.innerHTML = '<div class="empty" style="padding:12px"><span class="spin"></span> '+
    'Reading your forecast and writing it up…</div>';

  const all = S.sfrs || [];
  const open = all.filter(sfrOpen);
  const cq = open.filter(r=>normQ(r.FiscalQuarter__c)===CUR_Q);
  /* Fenced. This is the highest-consequence prompt in the app — its output goes
     to his manager — and it was the only one interpolating raw Name and
     Next_Steps__c, both free text writable by whoever owns the record. */
  const line = r => '- '+fence('R', (r.Name||'')+' · '+(r.Account_Name__c||''))+' · '+
    money(amt(r))+' · '+(r.ForecastStatus__c||'no judgement')+' · '+
    (r.ForecastStage__c||'no stage')+' · closes '+(r.ForecastCloseDate__c||'no date')+
    ' · next step: '+(String(r.Next_Steps__c||'').trim()
      ? fence('NEXT', r.Next_Steps__c) : 'BLANK');
  /* The hygiene block interpolated x.r.Name raw into the prompt whose output
     goes to his manager. */
  const flagLine = x => '- '+fence('R', x.r.Name||'')+': '+x.f.join('; ');
  const grp = j => cq.filter(r=>r.ForecastStatus__c===j);
  const flagged = open.map(r=>({r, f:sfrFlags(r)})).filter(x=>x.f.length);
  const ch = changesSince();
  const q = getQuota();
  const wonFY = all.filter(r=>sfrWon(r) && inCurFY(r)).reduce((t,r)=>t+amt(r),0);

  const facts =
    'QUARTER: '+CUR_Q+'   TODAY: '+todayStr()+'\n'+
    (q ? 'TARGET: '+money(q)+'   CLOSED WON THIS FY: '+money(wonFY)+
         '   GAP: '+money(Math.max(q-wonFY,0))+'\n' : 'TARGET: not set in the app\n')+
    '\nCOMMIT ('+CUR_Q+'):\n'+(grp('Commit').map(line).join('\n')||'- none')+
    '\n\nBEST CASE ('+CUR_Q+'):\n'+(grp('Best Case').map(line).join('\n')||'- none')+
    '\n\nPIPELINE ('+CUR_Q+'):\n'+(grp('Pipeline').map(line).join('\n')||'- none')+
    '\n\nOPEN IN LATER QUARTERS:\n'+
      (open.filter(r=>normQ(r.FiscalQuarter__c)!==CUR_Q).slice(0,12).map(line).join('\n')||'- none')+
    '\n\nHYGIENE FLAGS (these are what quietly cost the number):\n'+
      (flagged.slice(0,10).map(flagLine).join('\n')||'- none')+
    (ch && ch.rows.length
      ? '\n\nCHANGED SINCE HIS LAST VISIT ('+ch.age+' days ago):\n'+
        ch.rows.slice(0,12).map(r=>'- '+r.t+': '+
          fence('C', r.gone ? '(a deal that left the book)'
                            : (r.o?r.o.Name:r.sfr.Name))+' — '+
          String(r.d).replace(/<[^>]*>/g,'')).join('\n')
      : '');

  const prompt = METHOD+'\n\n'+UNTRUSTED_NOTE+
    '\n=== HIS FORECAST, LIVE FROM SALESFORCE ===\n'+facts+
    '\n\nWrite the forecast narrative you will actually say out loud'+
    (aud==='mgr' ? ' to '+MANAGER_NAME+', your manager, on a forecast call.'
     : aud==='core' ? ' to '+coreAeList()+', the core AEs whose accounts these are.'
     : ' to yourself, as prep notes before the call.')+'\n\n'+
    'Structure, in this order and with these headings:\n'+
    'COMMIT — what is closing this quarter and why you believe it. Name the deal, the '+
    'number, and the one thing that has to happen.\n'+
    'BEST CASE — what could land, and precisely what it depends on.\n'+
    'AT RISK — what you are worried about. Be specific about which deal and which '+
    'signal, not generically cautious.\n'+
    'WHAT CHANGED — only if there is real movement to report.\n'+
    'WHAT I NEED — the asks. Name people where the data names them.\n\n'+
    'Rules:\n'+
    '- Every number comes from the data above. Never invent one, never round one up.\n'+
    '- A blank next step is a real finding — say so rather than glossing it.\n'+
    '- You are the Digital specialist on accounts owned by the core AEs. '+
    'Never imply a deal is yours to move unilaterally; where an '+
    'opportunity change is needed, frame it as something to agree with the owner.\n'+
    '- Short lines. No markdown headers beyond the five above. No preamble, no '+
    'sign-off, no methodology names.\n'+
    '- If the data does not support a section, write one line saying so and move on. '+
    'A thin honest forecast beats a padded one.';

  try{
    const txt = await window.cowork.askClaude(prompt, []);
    out.innerHTML = '<div class="card" style="margin-top:11px">'+
      '<h3>'+esc(CUR_Q)+' forecast narrative</h3>'+
      '<textarea id="fnTxt" rows="24">'+esc(String(txt||''))+'</textarea>'+
      '<div class="row" style="margin-top:9px">'+
        '<button class="btn ghost" id="fnCopy">Copy</button>'+
        '<button class="btn ghost" id="fnRedo">Rewrite</button>'+
        '<span class="sp"></span>'+
        '<span class="meta">Read it before you send it. Every figure traces to a '+
          'live SFR.</span>'+
      '</div></div>';
    say('Forecast narrative ready in the text box below.');
    $('fnCopy').onclick = ()=>copyOut('fnTxt','fnCopy');
    $('fnRedo').onclick = writeForecast;
  }catch(e){
    out.innerHTML = '<div class="note err" style="margin-top:10px">Could not write it: '+
      esc(plainErr(e.message))+'</div>';
  }
}
