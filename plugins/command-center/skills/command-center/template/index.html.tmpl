        return '<label style="display:flex;gap:8px;align-items:flex-start">'+
          '<input id="hpf-'+esc(x.k)+'" type="checkbox" style="width:auto;margin-top:3px"'+
          (cur && cur.v ? ' checked' : '')+'>'+
          '<span>'+esc(x.label)+
            '<span class="meta" style="display:block">'+esc(x.target)+
