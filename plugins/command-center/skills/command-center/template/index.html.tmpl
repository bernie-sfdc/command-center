            kv('Marketing Cloud amount',Number(o.Marketing_Amount__c)?moneyFull(o.Marketing_Amount__c):'—')+
            kv('Data 360 amount',Number(o.Data_Cloud_Amount__c)?moneyFull(o.Data_Cloud_Amount__c):'—')+
            kv('Agentforce amount',Number(o.Agentforce_Amount__c)?moneyFull(o.Agentforce_Amount__c):'—')+
            (sfr?kv('SFR judgement',esc((sfr.ForecastStatus__c||'not set')+' · '+
              (sfr.ForecastStage__c||'—'))):'')+
