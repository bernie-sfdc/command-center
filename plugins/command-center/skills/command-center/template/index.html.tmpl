    waveGuard(args);
  } else if(tool === SFW){
    const m = String((args && args.method) || '').toUpperCase();
    if(m !== 'PATCH' && m !== 'POST')
      throw new Error('this app only ever PATCHes or POSTs: '+m+' refused');
    const u = String((args && args.url) || '');
    if(!WRITE_OK.some(re=>re.test(u)))
      throw new Error('write path not permitted by this app: '+u);
    const obj = (/\/sobjects\/([A-Za-z_]+[A-Za-z0-9_]*)/.exec(u) || [])[1];
    const spec = Object.prototype.hasOwnProperty.call(WRITE_FIELDS, obj)
               ? WRITE_FIELDS[obj] : null;
    if(!spec) throw new Error('no writable field list for '+obj);
    const ok = spec[m] || [];
    if(!ok.length) throw new Error('this app never '+m+'es a '+obj);
    const body = (args && args.body) || {};
    const bad = Object.keys(body).filter(k=>ok.indexOf(k) < 0);
    if(bad.length)
      throw new Error('this app never writes '+obj+'.'+bad.join(', '));
  }
  if(!window.cowork || typeof window.cowork.callMcpTool !== 'function')
    throw new Error('the Cowork connector bridge is not available in this page');
  /* Logged so the debug log answers "did this even reach the connector?".
     A bridge-level refusal leaves no trace otherwise, which cost an hour of
     guessing when Salesforce silently stopped answering. */
  let r;
  try{
    r = await window.cowork.callMcpTool(tool, args);
  }catch(e){
    console.error('[connector] '+tool.replace(/^mcp__[^_]+__/,'')+' threw: '+
      (e && e.message || e));
    throw e;
  }
  if(r && r.isError)
    console.error('[connector] '+tool.replace(/^mcp__[^_]+__/,'')+' error: '+
      ((r.content && r.content[0] && r.content[0].text) || 'unknown'));
  if(!r) return null;
  if(r.isError) throw new Error((r.content&&r.content[0]&&r.content[0].text)||'tool error');
  let out = r.structuredContent;
  if(out === undefined || out === null){
    const t = r.content && r.content[0] && r.content[0].text;
    /* Slack and Drive sometimes return markdown, not JSON. Parsing blindly
       surfaced "Slack failed" for calls that actually succeeded. */
    if(!t) return null;
    try{ out = JSON.parse(t); }catch(e){ out = {results:t}; }
  }
  return out;
}

/* esc() is HTML-escaping only — it happily passes "javascript:..." straight
   into an href. Calendar conferenceUrl in particular is set by whoever sent
   the invite, i.e. an external party. */
function safeUrl(u){
  try{
    const p = new URL(String(u||''), location.href);
    return (p.protocol === 'https:' || p.protocol === 'http:') ? p.href : '#';
  }catch(e){ return '#'; }
}
/* Salesforce Ids are concatenated into SOQL and into href/id attributes. The
   shape check means a malformed connector response cannot reshape a query. */
const sfId = v => /^[a-zA-Z0-9]{15,18}$/.test(String(v||'')) ? String(v) : null;
/* For markup. Every Salesforce Id that reaches an href, an id or a data-*
   attribute goes through this, so a malformed connector response yields a dead
   link rather than a chance to break out of the attribute. The SOQL side has
   used sfId since the last audit; this closes the render side. */
const idAttr = v => sfId(v) || '';
const sfIdList = arr => [...arr].map(sfId).filter(Boolean);
/* SOQL string literal. Both call sites interpolate app-owned constants
   (FAMILIES display names, SKU_MAP terms), so this is not a live injection —
   but they sanitised by DELETING quotes, which silently corrupts a name like
   "O'Brien" and teaches the next edit the wrong habit. Escape, don't strip:
   backslash and quote for the literal, % and _ because both call sites feed a
   LIKE and an unescaped wildcard widens the match. */
const soqlLit = v => String(v == null ? '' : v)
  .replace(/\\/g, '\\\\')
  .replace(/'/g, "\\'")
  .replace(/[%_]/g, m => '\\' + m);
/* Drive's query language, where % and _ carry no special meaning. */
const driveLit = v => String(v == null ? '' : v)
  .replace(/\\/g, '\\\\')
  .replace(/'/g, "\\'");
async function soql(q){
  const res = await call(SF, {url:'/services/data/'+APIV+'/query', method:'GET', queryParams:{q}});
  if(!res || res.status_code !== 200) throw new Error('SOQL '+(res&&res.status_code));
  return (res.body && res.body.records) || [];
}
function setPill(id, state, label){
  const el = $(id); if(!el) return;
  el.innerHTML = '<span class="dot'+(state==='ok'?'':state==='err'?' err':
    state==='warn'?' warn':' idle')+'"></span>'+esc(label);
}

/* =================== LOAD =================== */
async function loadAll(){
  $('pTime').textContent = 'loading…';

  /* Split into what the first screen needs and what it does not.
     The default tab is My SFRs, which needs Salesforce only — waiting on Drive,
     Slack, Gmail and Calendar before painting anything made the app feel five
     times slower than it is. Those four keep loading and repaint their own tabs
     as they land. */
  /* The entitlement read needs the account list, so the account-team job is
     hoisted out and awaited by name. It used to sit in the same parallel batch,
     which meant the usage query ran against an empty account list every load
     and silently found nothing. */
  const teamJob = (async()=>{
    S.teams = await soql(
      "SELECT AccountId, Account.Name, TeamMemberRole FROM AccountTeamMember "+
      "WHERE UserId = '"+ME_ID+"' LIMIT 300");
    /* The UI used to claim this list was filtered to the Marketing Cloud AE role
       while the query had no role predicate and TeamMemberRole was selected and
       never read. Rather than narrow the query — other roles on these accounts
       are still his to work — the role is now actually used: kept for the note
       below, so the copy can state what the data is instead of asserting a
       filter that was not being applied. */
    S.teamRoles = [...new Set(S.teams.map(t=>t.TeamMemberRole).filter(Boolean))].sort();
  })().catch(e=>{ S.err.team = e.message;
    console.error('[SF account team] '+e.message); });

  const core = [
    (async()=>{
      const oppsRaw = await soql(
        "SELECT Id, Name, StageName, Amount, CloseDate, ForecastCategoryName, OwnerId, Owner.Name, "+
        "Account.Name, AccountId, LastActivityDate, Type, "+
        "Marketing_Amount__c, Data_Cloud_Amount__c, Agentforce_Amount__c "+
        "FROM Opportunity WHERE AccountId IN (SELECT AccountId FROM AccountTeamMember "+
        "WHERE UserId = '"+ME_ID+"') AND IsClosed = false "+
        /* The horizon is applied in the query, not just in the UI. 218 open
           opportunities arriving so that 28 could be shown was work nobody
           needed — and a zombie from 2023 is not planning information. */
        /* 400 days back, not 120. isZombie is a 90-day test, so a 120-day floor
           meant "Include zombies" could only ever surface a 30-day slice and
           the Book banner's "oldest is X" was bounded by the query rather than
           by the data. Hygiene debt under-reported with nothing saying so. */
        "AND CloseDate >= LAST_N_DAYS:400 AND CloseDate <= "+HORIZON+" "+
        /* And only records that could possibly be his: a specialist amount, a
           Signature Success plan, a renewal (context for the Renewals view), or
           a name that reads like one of his products (the fix queue — deals
           that look like his but carry no amount, which is the thing worth
           knowing about). 218 open opportunities became 57 arriving and 28
           counted, instead of 218 arriving to show 28. */
        "AND (Marketing_Amount__c > 0 OR Data_Cloud_Amount__c > 0 "+
        "OR Agentforce_Amount__c > 0 OR Type = 'Success Plan' "+
        "OR Type LIKE '%Renewal%' OR Name LIKE '%Marketing Cloud%' "+
        "OR Name LIKE '%MCE%' OR Name LIKE '%MCAE%' OR Name LIKE '%Data 360%' "+
        "OR Name LIKE '%Data Cloud%' OR Name LIKE '%Agentforce%' "+
        "OR Name LIKE '%MC -%') "+
        /* DESC, so if the cap is hit the rows that survive are the near-term
           ones. ASC kept the oldest and silently dropped this quarter. */
        "ORDER BY CloseDate DESC LIMIT 400");
      /* The door filter. Fetched wide so the dropped count can be shown, then
         narrowed once here rather than in each of the eight consumers. */
      const door = atTheDoor(oppsRaw);
      S.opps = door.keep;
      S.dropped = door.drop;
      stampOpps();
      S.got.sf = true;
      setPill('pSf','ok','Salesforce · '+S.opps.length+' opps'+
        (S.dropped.length ? ' · '+S.dropped.length+' out of scope' : ''));
    })().catch(e=>{ S.err.sf = e.message;
      console.error('[SF opportunities] '+e.message);
      setPill('pSf','err','Salesforce failed'); }),

    /* SFRs / SAFs — the specialist forecast. Marketing Cloud only, per the operator's role.
       Field_Product_Lead__c is empty on every record, so ForecastType__c is the filter. */
    (async()=>{
      S.sfrs = await soql(
        "SELECT Id, Name, Account_Name__c, ForecastAmount__c, "+
        "ForecastStage__c, ForecastStatus__c, ForecastType__c, ForecastCloseDate__c, "+
        "FiscalYear__c, FiscalQuarter__c, TOP_Deal__c, "+
        "ExcludeFromCalculation__c, Next_Steps__c, CreatedDate, "+
        /* LastModifiedDate drives "Timely SFR Updates"; the judgement field
           decides which records that metric even applies to. */
        "LastModifiedDate, Management_Forecast_Judgement__c, "+
        "Opportunity__c, Opportunity__r.Name, Opportunity__r.StageName, "+
        "Opportunity__r.Amount, Opportunity__r.Marketing_Amount__c "+
        "FROM SpecialistForecast__c WHERE OwnerId = '"+ME_ID+"' "+
        "AND ForecastType__c = 'Marketing Cloud' "+
        "ORDER BY ForecastCloseDate__c DESC LIMIT 300");
      /* Name-based rules only: an SFR has no Type, so the renewal-date rule
         cannot apply to it, and its own close date is already flagged against
         the horizon on the SFR tab. */
      const sfrDrop = S.sfrs.filter(x=>NOT_MINE_RE.test(String(x.Name || '')) ||
        NOT_MINE_RE.test(String((x.Opportunity__r && x.Opportunity__r.Name) || '')));
      if(sfrDrop.length){
        S.sfrs = S.sfrs.filter(x=>sfrDrop.indexOf(x) < 0);
        S.sfrDropped = sfrDrop.length;
      }
      S.got.sfr = true; setPill('pSfr','ok','SFRs · '+S.sfrs.length);
    })().catch(e=>{ S.err.sfr = e.message;
      console.error('[SF specialist forecasts] '+e.message);
      setPill('pSfr','err','SFRs failed'); }),

    teamJob,
  ];

  const later = [
    /* Closed Won inside the current fiscal year, on his accounts, carrying a
       specialist amount. Two HPF metrics need it: YTD attainment (the numerator)
       and Engaged ACV Participation. Not in the core batch — nothing on the
       default tab reads it. */
    (async()=>{
      const fy = CUR_FY_N();
      S.won = await soql(
        "SELECT Id, Name, CloseDate, Amount, Type, Owner.Name, "+
        "Account.Name, AccountId, LastActivityDate, "+
        "Marketing_Amount__c, Data_Cloud_Amount__c, Agentforce_Amount__c "+
        "FROM Opportunity WHERE AccountId IN (SELECT AccountId FROM "+
        "AccountTeamMember WHERE UserId = '"+ME_ID+"') "+
        "AND IsWon = true "+
        "AND CloseDate >= "+(2000+fy-1)+"-02-01 AND CloseDate <= "+(2000+fy)+"-01-31 "+
        "AND (Marketing_Amount__c > 0 OR Data_Cloud_Amount__c > 0 "+
        "OR Agentforce_Amount__c > 0 OR Type = 'Success Plan') "+
        "ORDER BY CloseDate DESC LIMIT 200");
      /* Same rules on the attainment numerator: a MuleSoft win is not his
         number either. The renewal-date rule is inert here — these already
         closed inside the fiscal year. */
      const wd = atTheDoor(S.won);
      S.won = wd.keep;
      S.wonDropped = wd.drop;
      S.got.won = true;
    })().catch(e=>{ S.err.won = e.message;
      console.error('[SF closed won] '+e.message); }),

    /* The real HPF numbers, straight from the dataset behind the AE & FLM
       Performance Dashboard. One row per person per quarter. */
    (async()=>{
      const F = ['EMP_NM','EMP_ID','EMP_MGR_NM','FY_Q','MACRO_SEGMENT',
        'FORMATTED_SELLING_ROLE','L1_CLOUD','L2_CLOUD','SELLER_GROUP','TENURE_BAND',
        'OUTPUT_KPI_PROGRESS_INDICATOR','OUTPUT_KPI_PROGRESS_INSIGHTS','PROJ_OFF_TRACK',
        'CQ_QAP_COMPLETION','CQ_QUOTA_ATTAINMENT_YTD','CQ_ACV','CQ_ACV_THRESHOLD',
        'CQ_ACV_PARTICIPATION','CQ_PG','CQ_PG_THRESHOLD','CQ_PG_PARTICIPATION',
        'CQ_AVG_ACTIVITIES','CQ_ENABLEMENT_COMPLETION','CQ_ENABLEMENT_ASSIGNED',
        'CQ_ENABLEMENT_COMPLETED','QTR_CHCKN_CMPLT_AE','CQ_OP','CQ_COMMIT_OP',
        'PQ_1_QUOTA_ATTAINMENT_YTD','PQ_1_ACV','PQ_1_ACV_PARTICIPATION','PQ_1_PG',
        'PQ_1_PG_PARTICIPATION','PQ_2_QUOTA_ATTAINMENT_YTD','PQ_2_ACV',
        'PQ_2_ACV_PARTICIPATION','PQ_3_QUOTA_ATTAINMENT_YTD','PQ_3_ACV',
        'PQ_3_ACV_PARTICIPATION'];
      const res = await call(SFW, {
        url:'/services/data/'+APIV+'/wave/query', method:'POST',
        body:{query:'q = load "'+WAVE_KPI+'"; '+
          /* Matched on the Org62 user name, so no employee id is hardcoded. */
          'q = filter q by EMP_NM matches "'+HPF_ME+'"; '+
          'q = foreach q generate '+F.map(f=>f+' as '+f).join(', ')+'; '+
          'q = limit q 5;'},
      });
      /* The connector hands back the whole REST envelope, so the records sit at
         body.results.records. Reading res.results.records found nothing and the
         tab reported "no row for this user" on a call that had succeeded. */
      const recs = (res && res.body && res.body.results && res.body.results.records)
                || (res && res.results && res.results.records) || [];
      if(!recs.length) throw new Error('no HPF row for this user in the dataset');
      S.hpfRow = recs[0];
      S.got.hpfRow = true;
    })().catch(e=>{ S.err.hpfRow = e.message;
      console.error('[HPF dataset] '+e.message); }),

    /* Completed activities he logged, for the conversation-cadence metric.
       Counted server-side — the number is all this needs. */
    (async()=>{
      const r = await soql(
        "SELECT COUNT(Id) n FROM Task WHERE OwnerId = '"+ME_ID+"' "+
        "AND ActivityDate = LAST_N_DAYS:84");
      /* null, not 0, when the aggregate comes back in an unexpected shape —
         otherwise "the read did not parse" renders as "you logged nothing". */
      const c = r[0] && (r[0].n != null ? r[0].n : r[0].expr0);
      S.taskCount = Number.isFinite(Number(c)) ? Number(c) : null;
      S.got.tasks = true;
    })().catch(e=>{ S.err.tasks = e.message; }),

    (async()=>{
      /* Full display names, not first words. "Cook" and "Henry" pulled in
         unrelated documents that then fell through famOf into "other" and
         contributed nothing — while consuming a page budget shared across nine
         families, so one document-heavy account could starve the other eight
         and report drive:0 for them. */
      /* Account names alone missed "MC Next architecture — 1:1 BU to Data
         Space" entirely. Titles only, still — which the Drive section now
         says out loud rather than implying full-text search. */
      /* driveLit, not soqlLit: this is a Drive query, where % and _ are ordinary
         characters — escaping them would inject stray backslashes into a title
         match. Only the quote and the backslash need escaping here. */
      const q = FAMILIES.map(f=>"title contains '"+
          driveLit(f.disp.replace(/é/g,'e').trim())+"'")
        .concat(['Marketing Cloud','Data 360','Agentforce','MCAE','MCE+','POV']
          .map(t=>"title contains '"+driveLit(t)+"'"))
        .join(' or ');
      const res = await call(DRIVE, {query:q, pageSize:100, excludeContentSnippets:true});
      S.drive = (res && res.files) || [];
      S.got.drive = true; setPill('pDrive','ok','Drive · '+S.drive.length);
    })().catch(e=>{ S.err.drive = e.message; setPill('pDrive','err','Drive failed'); }),

    (async()=>{
      const res = await call(SLACK, {query:'from:<@'+SLACK_ME+'>', limit:20,
        include_context:false, response_format:'concise', sort:'timestamp'});
      S.slack = (res && res.results) || '';
      S.got.slack = true; setPill('pSlack','ok','Slack · connected');
    })().catch(e=>{ S.err.slack = e.message; setPill('pSlack','err','Slack failed'); }),

    /* Calendar invites and automated notifications are filtered server-side where
       Gmail lets us, then again client-side by NOISE_RE / INVITE_RE. */
    (async()=>{
      /* pageSize caps at 50, and 21 days of mail is more than 50 threads — the
         single-page version silently truncated the inbox and the "waiting on
         me" count with it. Page until the window is covered. */
      const q = 'newer_than:21d -in:draft -in:chats '+
        '-subject:(Invitation OR "Updated invitation" OR "Accepted:" OR "Declined:" '+
        'OR "Canceled event" OR "Invitation from" OR "New event" OR "Notes:" OR "Meeting records:") '+
        '-from:(calendar-notification@google.com OR gemini-notes@google.com '+
        'OR meetings-noreply@google.com OR drive-shares-dm-noreply@google.com)';
      const all = [], seen = new Set();
      let token = null, guard = 0;
      do{
        const args = {query:q, pageSize:50, view:'THREAD_VIEW_MINIMAL'};
        if(token) args.pageToken = token;
        let res;
        try{
          res = await call(GMAIL, args);
        }catch(e){
          /* Page 1 failing is a real failure. Page 3 failing after two good
             pages is not a reason to throw away 100 threads — the host refuses
             calls while the window is backgrounded, and that used to wipe the
             whole inbox read. */
          if(!all.length) throw e;
          console.error('[gmail] stopped paging after '+all.length+' threads: '+e.message);
          break;
        }
        ((res && res.threads) || []).forEach(t=>{
          if(t && t.id && !seen.has(t.id)){ seen.add(t.id); all.push(t); }
        });
        token = res && res.nextPageToken;
        setPill('pMail','warn','Gmail · '+all.length+'…');
      /* Two pages, not four. Each page is a serial round trip of 1–3.5s, and the
         only thing pages 3 and 4 changed was the send-rate denominator — which
         truncNote and the "Emails sent" tile already declare as a floor. */
      } while(token && ++guard < 2);
      S.threads = all.filter(keepThread);
      stampThreads();
      S.got.mail = true; setPill('pMail','ok','Gmail · '+S.threads.length);
    })().catch(e=>{ S.err.mail = e.message; setPill('pMail','err','Gmail failed'); }),

    /* Slack that is actually addressed to him: DMs, group DMs, and @-mentions.
       Channel chatter is deliberately excluded. */
    (async()=>{
      const [dm, mention] = await Promise.all([
        call(SLACKP, {query:'to:<@'+SLACK_ME+'>', limit:30,
          include_context:false, response_format:'concise', sort:'timestamp'}),
        call(SLACKP, {query:'<@'+SLACK_ME+'>', limit:30,
          include_context:false, response_format:'concise', sort:'timestamp'}),
      ]);
      S.slackDM = parseSlack((dm&&dm.results)||'').concat(parseSlack((mention&&mention.results)||''));
      const seen = new Set();
      S.slackDM = S.slackDM.filter(m=>{ const k=m.who+m.text.slice(0,40);
        if(seen.has(k)) return false; seen.add(k); return true; });
      S.got.dm = true; setPill('pDM','ok','Slack DMs · '+S.slackDM.length);
    })().catch(e=>{ S.err.dm = e.message; setPill('pDM','err','Slack DMs failed'); }),

    (async()=>{
      S.events = await fetchEvents(-14, 45);
      S.got.cal = true;
      /* Paging forward reported a truncated window; the first load did not, so a
         partial calendar opened looking complete. */
      setPill('pCal', fetchEvents.partial?'warn':'ok',
              'Calendar · '+S.events.length+(fetchEvents.partial?' (partial)':''));
    })().catch(e=>{ S.err.cal = e.message; setPill('pCal','err','Calendar failed'); }),

    /* Consumption and overage. This is the data behind the Usage Upsell
       Dashboard — I had previously concluded it was not in Org62, having looked
       at Rate_Plan_Usage__c, which is dead 2010-era legacy. It is actually on
       sfbase__EntitlementSchedule__c, and it carries the dashboard's own
       RecommendedUpsellQuantity__c and EstimatedOverageDate__c formulas, so the
       app does not have to reimplement the maths.

       Two steps because SOQL refuses a nested semi-join: entitlements by
       account, then schedules by entitlement. */
    /* Two steps, run in parallel, with the filtering pushed into the org.

       An audit suggested collapsing this to one query by filtering on the parent
       path — WHERE sfbase__Entitlement__r.sfbase__Account__c IN (…). Tested
       against Org62: rejected, "cannot have more than one level of
       relationships". A nested semi-join is refused too. So two steps really are
       required; what was wrong was doing the second one serially and fetching
       almost everything.

       Now: the chunks run concurrently, and the actionability test lives in the
       WHERE clause. Measured on a 15-entitlement sample: 23 rows fetched before,
       1 after. Restricted schedules are excluded here rather than in JS, which
       matches how the Usage Upsell Dashboard behaves.

       Why the predicate is complete: "predicted overage" means the allowance
       runs out before the term ends, which means projected usage exceeds the
       allowance, which means RecommendedUpsellQuantity__c is positive. So
       (balance < 0 OR upsell > 0) already covers every predicted row — no
       actionable schedule is filtered out. (SOQL cannot compare two fields in a
       WHERE, so the date-vs-date test could not go server-side anyway.) */
    (async()=>{
      await teamJob;                       /* needs the account list first */
      const accts = sfIdList(new Set((S.teams||[]).map(t=>t.AccountId)));
      if(!accts.length){ S.got.ent = true; return; }
      const ents = await soql(
        "SELECT Id FROM sfbase__Entitlement__c WHERE sfbase__Account__c IN ("+
        accts.map(i=>"'"+i+"'").join(',')+") LIMIT 800");
      const ids = sfIdList(ents.map(e=>e.Id));
      if(!ids.length){ S.got.ent = true; return; }
      const chunks = [];
      for(let i=0; i<ids.length; i+=200) chunks.push(ids.slice(i, i+200));
      const FIELDS =
        "SELECT Id, Name, sfbase__Entitlement__r.sfbase__Account__c, "+
        "sfbase__Entitlement__r.sfbase__Account__r.Name, "+
        "sfbase__Entitlement__r.UsageType__r.Name, "+
        "sfbase__Allowance__c, Usage__c, Remaining_Balance__c, AverageDailyUsage__c, "+
        "EstimatedOverageDate__c, RecommendedUpsellQuantity__c, "+
        "AddOnOpportunityCreated__c, Usage_Classification__c, sfbase__EndDate__c "+
        "FROM sfbase__EntitlementSchedule__c WHERE sfbase__Entitlement__c IN (";
      const WHERE =
        ") AND sfbase__EndDate__c >= TODAY "+
        "AND (NOT Usage_Classification__c LIKE '%Restricted%') "+
        "AND (Remaining_Balance__c < 0 OR RecommendedUpsellQuantity__c > 0) "+
        "ORDER BY RecommendedUpsellQuantity__c DESC NULLS LAST LIMIT 200";
      const pages = await Promise.all(chunks.map(c=>
        soql(FIELDS + c.map(i=>"'"+i+"'").join(',') + WHERE)));
      S.ent = [].concat(...pages);
      ENT_TRUNC = pages.some(pg=>pg.length >= TRUNC.ent);
      S.got.ent = true;
    })().catch(e=>{ S.err.ent = e.message; }),
  ];

  /* Each late source repaints the tab it feeds, but only if he is looking at it. */
  /* One settle per microtask batch instead of one per finished job. Six late
     jobs each triggered invalidateDerived() + a forced repaint + a connBanner
     rebuild, so a Signals or Accounts tab painted up to eight times per load,
     each time rebuilding famRoll from scratch. ('pov' was in this list and has
     no entry in RENDER, so it never repainted anyway.) */
  const FEEDS = ['book','signals','today','inbox','pov','hpf'];
  let settleQueued = false;
  const settle = ()=>{
    if(settleQueued || !S.loaded) return;
    settleQueued = true;
    Promise.resolve().then(()=>{
      settleQueued = false;
      invalidateDerived();
      /* Un-paint every tab a late source feeds, not just the current one.
         PAINTED is only cleared by renderAll(), which runs once before the six
         late jobs — so a tab visited during load was painted with empty data
         and then never repainted, showing an empty calendar and "Nothing on the
         calendar today" until a manual Reload. */
      FEEDS.forEach(t=>PAINTED.delete(t));
      /* Only repaint if the tab he is on is actually fed by a late source. On
         the default tab (My SFRs, fed by none of them) six late jobs used to
         force four to seven full renderSfr passes — three select rebuilds, flags
         over every SFR and ~100KB of innerHTML each time — for data that tab
         never reads. The badges still update, because navCounts needs no paint. */
      if(FEEDS.indexOf(cur) >= 0) paint(cur, true);
      syncNavCounts();
      connBanner();
    });
  };
  later.forEach(pr=>pr.then(settle));

  await Promise.all(core);
  S.loaded = true;
  $('pTime').textContent = new Date().toLocaleString('en-US',
    {month:'short',day:'numeric',hour:'numeric',minute:'2-digit'});
  renderAll();
  /* Then settle the rest so a later Reload starts from a complete state. */
  await Promise.all(later.map(p=>p.catch(()=>null)));
  invalidateDerived();
  FEEDS.forEach(t=>PAINTED.delete(t));
  paint(cur, true);
  connBanner();
  /* Record the state AFTER rendering, so this load's "what changed" was diffed
     against the previous visit rather than against itself. */
  if(!S.err.sf && !S.err.sfr) takeSnapshot();
}

/* =================== DERIVE =================== */
/* Opportunity Id → SFR. Replaces two linear scans that ran inside per-row
   loops (141 rows × 46 SFRs = 6,486 comparisons, twice). */
/* Was the SFR read successful? Without this, a failed query made every L1 opp
   claim "no SFR" — asserting forecast exposure that may not exist. */
/* "Did the SFR read succeed?" — not "are there any?". Requiring length>0 meant a
   rep with genuinely zero SFRs, who most needs the "no SFR" flag, was told the
   data had not loaded on every L1 deal. */
function SFR_KNOWN(){ return !S.err.sfr && S.got.sfr === true && Array.isArray(S.sfrs); }
/* A capped read is not a complete read, and every total downstream would
   under-report without saying so. */
const TRUNC = {opps:400, sfrs:300, ent:200};
/* Set by the entitlement job when any single chunk came back full. S.ent is a
   concatenation of up to four LIMIT 200 chunks, so testing its total length
   raised a false cap warning as soon as two chunks returned 100 rows each. */
let ENT_TRUNC = false;
function truncNote(){
  const hit = [];
  if((S.opps||[]).length >= TRUNC.opps) hit.push('opportunities');
  if((S.sfrs||[]).length >= TRUNC.sfrs) hit.push('specialist forecast records');
  if(ENT_TRUNC)                         hit.push('entitlement schedules');
  if(!hit.length) return '';
  /* The old copy said "narrow the scope in the header, or ask for the cap to be
     raised", and claimed the nearest-term records were kept. Both were wrong:
     the header scope is a client-side filter over what already arrived, and the
     query orders by CloseDate DESC, so a cap hit drops the SOONEST records. */
  return '<div class="note warn"><strong>This read hit its cap.</strong> The '+
    hit.join(' and ')+' list came back full, so some records were not fetched '+
    'and every total below may under-report. The query orders by close date '+
    'descending, so what was dropped is the <strong>nearest-term</strong> end '+
    '&mdash; the records that matter most. The header scope filters what is '+
    'already here and cannot widen this; the cap has to be raised in the query.'+
    '</div>';
}
let _sfrByOpp = null;
function SFR_BY_OPP(){
  if(!_sfrByOpp){
    _sfrByOpp = new Map();
    (S.sfrs||[]).forEach(s=>{ if(s.Opportunity__c) _sfrByOpp.set(s.Opportunity__c, s); });
  }
  return _sfrByOpp;
}
/* famRoll rebuilds 11 objects and rescans every opp, team and Drive file. It
   was called 14× per load and once per calendar event card. Cached per render
   pass; invalidated whenever the underlying data or scope changes. */
let _famRoll = null;
function invalidateDerived(){
  _sig = null; _hpf = null;
  _famRoll = null; _sfrByOpp = null; _waiting = null;
  /* Clear the per-record stamps too, or a scope change or reload would keep
     classifying against the previous read. */
  /* `= undefined`, not `delete`. `delete` transitions the object out of its
     hidden class into dictionary mode, so every later field read on those ~800
     records stayed slow for the rest of the session — and this runs on every
     settle. Every reader below tests `!= null` / `!== undefined` / truthiness,
     so undefined reads as "not cached" exactly as a missing property did. */
  (S.opps||[]).forEach(o=>{ o._port = o._spec = o._other = o._fam = undefined; });
  (S.drive||[]).forEach(d=>{ d._fam = undefined; });
  _usage = null;
  (S.threads||[]).forEach(t=>{
    t._last = t._t = t._waiting = t._fam = undefined; });
  (S.events||[]).forEach(e=>{ e._at = e._fam = e._cust = undefined; });
  Object.keys(S.contacts||{}).forEach(k=>(S.contacts[k]||[])
    .forEach(c=>{ c._role = c._md = undefined; }));
}
function famRoll(){
  if(_famRoll) return _famRoll;
  return (_famRoll = famRollBuild());
}
/* Stamped, like Drive files. famOf is nine regexes and was being called per
   pipeline row, per roll-up and per signal on the same records. */
function famOfOpp(o){
  if(!o) return OTHER;
  return o._fam !== undefined ? o._fam
       : (o._fam = famOf(o.Account && o.Account.Name));
}
function famRollBuild(){
  const m = {};
  const ensure = f => m[f.slug] || (m[f.slug] = {...f, opps:[], zombies:[], accts:new Set(),
    total:0, best:0, pastDue:0, drive:0});
  FAMILIES.forEach(ensure); ensure(OTHER);
  scoped().forEach(o=>{
    const f = famOfOpp(o);
    const e = ensure(f);
    if(o.AccountId) e.accts.add(o.AccountId);
    if(isZombie(o)){ e.zombies.push(o); return; }   // zombies never count as pipeline
    e.opps.push(o);
    /* specAmt, so the Accounts tab agrees with Pipeline and with his quota.
       Summing Opportunity.Amount here meant a family's "live pipeline" included
       the core AE's Sales and Service share of every shared deal. */
    e.total += specAmt(o);
    if(o.ForecastCategoryName==='Best Case'||o.ForecastCategoryName==='Commit')
      e.best += specAmt(o);
    if(o.CloseDate && o.CloseDate < today) e.pastDue++;
  });
  S.teams.forEach(t=>{ const e = ensure(famOf(t.Account && t.Account.Name)); e.accts.add(t.AccountId); });
  S.drive.forEach(d=>{ const e = ensure(famFor(d)); e.drive++; });
  return Object.values(m).sort((a,b)=>b.total-a.total);
}
/* "Real" means it carries a specialist amount — a deal worth $1M of Sales Cloud
   and $0 of his products is not real pipeline for him. */
const realOpp = o => specAmt(o) > 0;

/* =================== RENDER: SFR / SAF =================== */
const SF_URL = 'https://org62.lightning.force.com/lightning/r/';

/* ---- SFR state, single source of truth --------------------------------
   "08 - Closed" is a PREFIX shared by Closed Won and Closed Lost, so matching
   on it counted every loss as a win — and moved it from the denominator's loss
   side into the numerator, breaking win rate twice over. Lost is tested first. */
const LOST_RE = /^(Dead|.*closed[\s_-]*lost|.*no decision|.*duplicate|.*no opportunity)/i;
const WON_RE  = /closed[\s_-]*won/i;
const sfrLost = s => LOST_RE.test(s.ForecastStage__c||'');
const sfrWon  = s => !sfrLost(s) &&
  (s.ForecastStatus__c === 'Closed Won' || WON_RE.test(s.ForecastStage__c||''));
/* One definition of "open", used by the SFR tab AND Analytics. The two used to
   disagree, so identical records produced different totals on each tab. */
const sfrOpen = s => !sfrWon(s) && !sfrLost(s);
/* Salesforce flags some SFRs to exclude from the forecast. Summing them made
   these tiles disagree with the manager's roll-up with no visible reason. */
const sfrCounts = s => s.ExcludeFromCalculation__c !== true;
const amt    = s => sfrCounts(s) ? (Number(s.ForecastAmount__c)||0) : 0;
const amtRaw = s => Number(s.ForecastAmount__c)||0;
/* Judgement ladder, strongest first. */
const JUDGE = ['Closed Won','Commit','Best Case','Pipeline','Omitted'];
/* One colour map for both the specialist judgement and the opportunity forecast
   category. They used to have separate maps that disagreed: Best Case was teal
   on one tab and amber on the other, Pipeline amber on one and blue on the
   other — and both columns were headed "Forecast" despite being different
   Salesforce fields. */
const FC_COLOUR = {
  'Closed Won':'g', 'Commit':'g', 'Best Case':'teal',
  'Pipeline':'warm', 'Omitted':'grey', 'Closed Lost':'risk',
};
const fcColour = v => FC_COLOUR[v] || 'grey';
function judgeTag(v){
  if(!v) return '<span class="tag risk">not set</span>';
  return '<span class="tag '+fcColour(v)+'">'+esc(v)+'</span>';
}
/* Stage numbers are the leading digits of the picklist label. */
function stageNum(s){ const m = /^(\d+)/.exec(s||''); return m ? +m[1] : null; }

function sfrFlags(s){
  const f = [];
  if(!s.ForecastStatus__c) f.push('No forecast judgement set');
  const sn = stageNum(s.ForecastStage__c), on = stageNum(s.Opportunity__r&&s.Opportunity__r.StageName);
  if(sn!=null && on!=null && on - sn >= 2)
    f.push('Opp is at stage '+on+', your SFR still says '+sn);
  if(!Number(s.ForecastAmount__c) && sfrOpen(s)) f.push('Amount is $0');
  const cd = s.ForecastCloseDate__c;
  if(cd && cd < today && sfrOpen(s)) f.push('Close date passed ('+fmtDate(cd)+')');
  /* Follows the horizon rather than a hardcoded 2028 date, so an SFR closing
     past what the app even fetches is flagged. */
  if(cd && cd > HORIZON && sfrOpen(s))
    f.push('Close date is past the '+fmtDate(HORIZON)+' horizon ('+fmtDate(cd)+')');
  /* Compare like with like. ForecastAmount__c is the Marketing Cloud line;
     Opportunity.Amount is the whole deal including Sales, Service and Platform.
     Comparing them flagged essentially every shared deal — the normal case for a
     specialist — and pushed that onto the default tab, into the today list above
     real work, and into the narrative that goes to his manager. */
  const mc = Number(s.Opportunity__r && s.Opportunity__r.Marketing_Amount__c);
  const fa = Number(s.ForecastAmount__c)||0;
  if(Number.isFinite(mc) && mc > 0 && fa > 0 &&
     Math.abs(mc-fa)/Math.max(mc,fa) > 0.5)
    f.push('Forecast is '+money(fa)+' but the opportunity\'s Marketing Cloud '+
           'line says '+money(mc));
  return f;
}

function renderSfr(){
  const all = S.sfrs;
  /* Declared here, not further down: the note below reads it, and a const in
     its temporal dead zone throws rather than reading as undefined. This one
     stayed hidden until Salesforce started answering again. */
  const excluded = all.filter(s=>!sfrCounts(s));
  if(S.err.sfr){
    $('sfrNote').innerHTML = '<div class="note err">SFR read failed: '+esc(S.err.sfr)+'</div>';
  } else {
    /* Short, and no longer claims the filter hides nothing — the filter is
       server-side, so the app cannot actually know that. */
    $('sfrNote').innerHTML = truncNote() + dropNote() +
      '<div class="note">Unlike Pipeline, this read has <strong>no close-date '+
      'ceiling</strong> &mdash; an SFR closing past '+fmtDate(HORIZON)+' is shown '+
      'and flagged rather than hidden, because a forecast record you own that far '+
      'out is a hygiene problem, not noise.</div>'+
      '<div class="note">'+all.length+
      ' Marketing Cloud SFRs, live from Org62.'+
      (excluded.length?' <strong>'+excluded.length+' excluded from forecast</strong> by Salesforce '+
        'and not counted in these totals.':'')+'</div>';
  }

  fillSelect('sAcct', [...new Set(all.map(s=>s.Account_Name__c).filter(Boolean))].sort(),
             'All accounts');
  fillSelect('sQtr',  [...new Set(all.map(s=>s.FiscalQuarter__c).filter(Boolean))].sort(),
             'All quarters');
  fillSelect('sStat', [...new Set(all.map(s=>s.ForecastStatus__c).filter(Boolean))]
             .sort((a,b)=>JUDGE.indexOf(a)-JUDGE.indexOf(b)), 'All judgements');

  const open = all.filter(sfrOpen);
  const cq = open.filter(s=>normQ(s.FiscalQuarter__c)===CUR_Q);
  const commit = open.filter(s=>s.ForecastStatus__c==='Commit');
  const best   = open.filter(s=>s.ForecastStatus__c==='Best Case');
  /* sfrWon, not a raw status match. A record whose STAGE advanced to a closed-won
     stage while the judgement picklist still read Commit was excluded from the
     open tiles (sfrOpen defers to sfrWon) AND from this one — a booking on none
     of the five tiles, while the quota strip above counted it. */
  const won    = all.filter(sfrWon);
  /* amt() returns 0 for ExcludeFromCalculation__c records, so these tiles now
     match what the manager's forecast report sees. */
  const sum = a => a.reduce((t,s)=>t+amt(s),0);

  renderQuota(all);

  /* Each tile is a live drill-down into the records behind it. */
  const wonFY = won.filter(inCurFY);
  S.sfrBuckets = {
    commit:{label:'Commit',           rows:commit},
    best:  {label:'Best Case',        rows:best},
    cq:    {label:CUR_Q+' open',      rows:cq},
    open:  {label:'Open pipeline',    rows:open},
    won:   {label:'Closed won '+CUR_Q.split(' ')[0], rows:wonFY},
  };
  /* Focusable and announced: the keyboard handler further down claimed to cover
     .kpi.click but nothing here carried tabindex, so it could never fire. The
     chevron is the visible tell that these five tiles drill and ~25 others in
     the app do not. */
  const tile = (cls,k,val,sub)=>
    '<div class="kpi '+cls+' click" data-k="'+k+'" tabindex="0" role="button" '+
    'aria-expanded="'+(SFR_DRILL===k)+'" '+
    'title="Open the '+S.sfrBuckets[k].rows.length+' SFRs behind this">'+
    '<div class="lbl">'+esc(S.sfrBuckets[k].label)+'</div><div class="val">'+val+'</div>'+
    '<div class="sub">'+sub+'</div></div>';

  /* count owned by navCounts() */
  $('sfrKpis').innerHTML =
    tile('g','commit',money(sum(commit)),commit.length+' SFR'+(commit.length===1?'':'s'))+
    tile('t','best',money(sum(best)),best.length+' SFR'+(best.length===1?'':'s'))+
    tile('o','cq',money(sum(cq)),cq.length+' SFRs this quarter')+
    tile('p','open',money(sum(open)),open.length+' live SFRs')+
    tile('','won',money(sum(wonFY)),wonFY.length+' booked');

  document.querySelectorAll('#sfrKpis .kpi[data-k]').forEach(el=>
    el.onclick = ()=>sfrDrill(el.dataset.k));

  /* Flags */
  const flagged = open.map(s=>({s, f:sfrFlags(s)})).filter(x=>x.f.length)
    .sort((a,b)=>(Number(b.s.ForecastAmount__c)||0)-(Number(a.s.ForecastAmount__c)||0));
  $('sfrFlags').innerHTML = flagged.length ? flagged.slice(0,12).map(({s,f})=>
    '<div class="card"><h3><a href="'+SF_URL+'SpecialistForecast__c/'+idAttr(s.Id)+'/view" target="_blank" '+
      'rel="noopener noreferrer">'+esc(s.Name)+'</a> &mdash; '+esc(s.Account_Name__c||'')+
      ' <span class="tag warm">'+money(s.ForecastAmount__c)+'</span></h3>'+
    '<div class="meta">'+esc(s.ForecastStage__c||'')+' &middot; '+
      esc(s.FiscalQuarter__c||'')+' &middot; closes '+fmtDate(s.ForecastCloseDate__c)+'</div>'+
    '<ul style="margin:8px 0 0;padding-left:17px;font-size:12px;line-height:1.65;color:var(--ink-2)">'+
      f.map(x=>'<li>'+esc(x)+'</li>').join('')+'</ul>'+
    '<div class="row" style="margin-top:10px">'+
      '<button class="btn sm" data-edit="'+idAttr(s.Id)+'" data-edit-obj="SpecialistForecast__c" '+
        'data-edit-host="fix-'+idAttr(s.Id)+'">Fix these fields</button>'+
      (s.Opportunity__c
        ? '<button class="btn sm ghost" data-edit="'+idAttr(s.Opportunity__c)+'" data-edit-obj="Opportunity" '+
          'data-edit-host="fixo-'+idAttr(s.Id)+'">Set the opportunity next step</button>'
        : '')+
    '</div>'+
    '<div id="fix-'+idAttr(s.Id)+'"></div><div id="fixo-'+idAttr(s.Id)+'"></div>'+
    '</div>').join('')
    : '<div class="card"><div class="empty">No hygiene issues on your open SFRs.</div></div>';

  /* Roll-up: quarter × judgement */
  const byQ = {};
  open.forEach(s=>{
    const q = normQ(s.FiscalQuarter__c)||'—', j = s.ForecastStatus__c||'not set';
    /* amt(), not the raw field: the note above this table promises excluded
       records are "not counted in these totals", and this is one of the two
       places that broke the promise. */
    byQ[q] = byQ[q]||{}; byQ[q][j] = (byQ[q][j]||0) + amt(s);
  });
  /* Any ForecastStatus__c the org uses that is not in JUDGE used to contribute
     to neither a cell nor the Total, so the roll-up could disagree with the
     tiles above it by the value of those records — silently, and with a Copy
     button attached. Union the fixed ladder with whatever actually turned up. */
  const seenJ = new Set();
  Object.values(byQ).forEach(r=>Object.keys(r).forEach(k=>seenJ.add(k)));
  const cols = [...new Set([...JUDGE.filter(j=>j!=='Closed Won'), 'not set',
                            ...[...seenJ].sort()])];
  $('sfrRollup').innerHTML =
    '<thead><tr><th>Quarter</th>'+cols.map(c=>'<th class="num">'+esc(c)+'</th>').join('')+
      '<th class="num">Total</th></tr></thead><tbody>'+
    Object.keys(byQ).sort().map(q=>{
      const row = byQ[q], tot = cols.reduce((t,c)=>t+(row[c]||0),0);
      return '<tr><td><strong>'+esc(q)+'</strong>'+(q===CUR_Q?' <span class="tag teal">current</span>':'')+'</td>'+
        cols.map(c=>'<td class="num">'+(row[c]?money(row[c]):'<span style="color:var(--ink-3)">—</span>')+'</td>').join('')+
        '<td class="num"><strong>'+money(tot)+'</strong></td></tr>';
    }).join('')+'</tbody>';

  /* A drill panel left open across a Reload used to keep showing the old
     figures, which made stale numbers look confirmed. Rebuild it against the
     new buckets instead. */
  if(SFR_DRILL && S.sfrBuckets[SFR_DRILL]) sfrDrill(SFR_DRILL, true);
  else { SFR_DRILL = null; const dp = $('sfrDrillPanel');
         if(dp){ dp.style.display='none'; dp.innerHTML=''; } }

  applySfr();
}
/* ═══════════════ Guarded Salesforce writes ═══════════════
   Only these fields, only from this panel, only after the operator confirms a
   before/after he can actually read.

   Deliberately NOT writable: Opportunity StageName, Amount and CloseDate.
   Most of the opportunities in this book belong to the core AEs — you are
   the Digital specialist on their accounts, not the
   owner. Changing another rep's forecast number from a side tool is how you
   lose the relationship that makes the specialist model work. Those stay
   read-only, and the panel says so out loud.

   The specialist forecast is different: those records are his. */
const WRITABLE = {
  SpecialistForecast__c: [
    {f:'ForecastStatus__c',    label:'Forecast judgement', type:'picklist',
     opts:()=>JUDGE},
    {f:'ForecastStage__c',     label:'Specialist stage',   type:'picklist',
     /* Picklist values are read off his own records rather than guessed —
        this org's stage list is long and renamed often. */
     opts:()=>[...new Set((S.sfrs||[]).map(x=>x.ForecastStage__c).filter(Boolean))].sort()},
    {f:'ForecastAmount__c',    label:'Forecast amount',    type:'number'},
    {f:'ForecastCloseDate__c', label:'Forecast close date',type:'date'},
  ],
  Opportunity: [
    {f:'NextStep', label:'Next step', type:'text'},
  ],
};

function editKey(obj,id){ return 'ed-'+obj+'-'+id; }

/* ═══════════════ Guarded creates ═══════════════
   The app's two loudest flags — "no SFR on a bucket L1 deal" and "nothing
   logged against this contact" — had no in-app remedy. Both told him to go and
   do it in Org62. These two creates close that, through exactly the same
   confirm-then-write panel as the field edits: a preview of every value, an
   explicit click, no retry on refusal, and a manual fallback that hands over the
   values if the write tool is not authorised. */
const CREATABLE = {
  SpecialistForecast__c: {
    label:'specialist forecast record',
    /* Only the fields the morning brief already proposes. */
    build:o=>({
      Opportunity__c:      sfId(o.Id),
      Account_Name__c:     (o.Account && o.Account.Name) || '',
      ForecastType__c:     'Marketing Cloud',
      ForecastAmount__c:   Number(o.Marketing_Amount__c)||0,
      ForecastCloseDate__c: o.CloseDate || null,
      ForecastStatus__c:   'Pipeline',
    }),
    pretty:{Opportunity__c:'Opportunity', Account_Name__c:'Account',
            ForecastType__c:'Forecast type', ForecastAmount__c:'Forecast amount',
            ForecastCloseDate__c:'Forecast close date',
            ForecastStatus__c:'Judgement'},
  },
  Task: {
    label:'completed activity',
    build:x=>({
      Subject:      x.subject,
      Description:  x.notes || '',
      WhoId:        x.whoId ? sfId(x.whoId) : undefined,
      WhatId:       x.whatId ? sfId(x.whatId) : undefined,
      ActivityDate: todayStr(),
      Status:       'Completed',
      OwnerId:      ME_ID,
    }),
    pretty:{Subject:'Subject', Description:'Notes', WhoId:'Contact',
            WhatId:'Related to', ActivityDate:'Date', Status:'Status',
            OwnerId:'Owner'},
  },
};

function createPanel(obj, body, host, after){
  const box = typeof host === 'string' ? $(host) : host;
  if(!box) return;
  /* hasOwnProperty, matching editRecord. Raw property access meant
     CREATABLE['__proto__'] passed the guard — it failed closed further down,
     but the asymmetry is what a future edit trips over. */
  if(!Object.prototype.hasOwnProperty.call(CREATABLE, obj)) return;
  const C = CREATABLE[obj]; if(!C) return;
  const uid = 'cr-'+obj+'-'+Math.random().toString(36).slice(2,8);
  const shown = Object.keys(body).filter(k=>body[k] !== undefined);
  box.innerHTML = '<div class="note warn" style="margin-top:10px">'+
    '<strong>Create this '+esc(C.label)+'?</strong>'+
    '<div class="tw" style="margin-top:8px"><table><thead><tr>'+
      '<th scope="col">Field</th><th scope="col">Value</th>'+
    '</tr></thead><tbody>'+
      shown.map(k=>'<tr><td><strong>'+esc(C.pretty[k]||k)+'</strong></td>'+
        '<td>'+esc(body[k]===null?'— empty —':String(body[k]))+'</td></tr>').join('')+
    '</tbody></table></div>'+
    '<div class="row" style="margin-top:10px">'+
      '<button class="btn" id="'+uid+'-go">Create it in Salesforce</button>'+
      '<button class="btn ghost" id="'+uid+'-x">Cancel</button>'+
    '</div><div id="'+uid+'-out"></div></div>';
  $(uid+'-x').onclick = ()=>{ box.innerHTML = ''; };
  $(uid+'-go').onclick = async()=>{
    const b = $(uid+'-go'); b.disabled = true; b.textContent = 'Creating…';
    const out = $(uid+'-out');
    const manual = why =>
      '<div class="note warn" style="margin-top:10px"><strong>Nothing was '+
        'created.</strong> '+esc(why)+
        '<div style="margin-top:7px">Create it yourself with these values:</div>'+
        '<ul style="margin:6px 0 0;padding-left:18px;line-height:1.7">'+
          shown.map(k=>'<li><strong>'+esc(C.pretty[k]||k)+'</strong> → '+
            '<span class="mono">'+esc(String(body[k]))+'</span></li>').join('')+
        '</ul></div>';
    try{
      const res = await call(SFW, {
        url:'/services/data/'+APIV+'/sobjects/'+obj,
        method:'POST', body,
      });
      const code = res && res.status_code;
      const id = res && res.body && res.body.id;
      if((code === 201 || code === 200) && id){
        /* Replace the WHOLE panel, not just the output slot. `out` is a sibling
           of the button, so overwriting it left an enabled "Create it in
           Salesforce" button above a "Created." message — one more click and a
           duplicate record. */
        box.innerHTML = '<div class="note" style="margin-top:10px">'+
          '<strong>Created.</strong> '+
          '<a class="btn sm" href="'+SF_URL+obj+'/'+idAttr(id)+'/view" target="_blank" '+
            'rel="noopener noreferrer" style="margin-left:8px">Open it in Org62 ↗</a>'+
          '<button class="btn sm ghost" id="'+uid+'-rl" style="margin-left:6px">'+
            'Reload the app</button></div>';
        const rl = $(uid+'-rl'); if(rl) rl.onclick = ()=>reloadAll();
        say('Created the '+C.label+'.');
        if(after) after(id);
        return;
      }
      const detail = (res && res.body && JSON.stringify(res.body).slice(0,300)) ||
                     ('status '+code);
      out.innerHTML = manual('Salesforce refused it: '+detail);
    }catch(e){
      const m = String(e && e.message || e);
      out.innerHTML = manual(
        /not permitted|bridge is not available|not currently shown/i.test(m)
          ? 'This app can read Org62 but is not authorised to write to it. That '+
            'is a permission setting on the Salesforce connector, not something '+
            'the app can fix.'
          : plainErr(m));
    }finally{
      if(b){ b.disabled = false; b.textContent = 'Create it in Salesforce'; }
    }
  };
  box.scrollIntoView({behavior:'smooth', block:'nearest'});
}

