                (c.dupes>1?' <span class="tag grey" title="'+c.dupes+
                  ' duplicate Org62 records merged into this row">×'+c.dupes+'</span>':'')+
                '<span class="tag '+(md.key==='eb'?'g':md.key==='champ'?'teal':md.key==='tech'?'p':
                  md.key==='compl'?'warm':'grey')+'" title="'+esc(md.hint)+'">'+esc(md.label)+'</span>'+
                '<span class="tag grey">'+esc(fn.label)+'</span>'+
                '<span class="sp"></span>'+
                '<span class="meta">'+(d==null?'<span style="color:var(--sf-red)">never touched</span>':d+'d ago')+'</span>'+
              '</div>'+
              '<div class="meta" style="margin-top:3px">'+esc(c.Title||'title unknown')+
                ' &middot; '+esc(c.Account&&c.Account.Name||'')+'</div>'+
              '<div class="row" style="margin-top:7px;gap:6px">'+
                '<button class="btn sm ghost" data-k="li"    data-c="'+i+'" data-f="'+slug+'">LinkedIn InMail</button>'+
                '<button class="btn sm ghost" data-k="disc"  data-c="'+i+'" data-f="'+slug+'">Discovery meeting</button>'+
                '<button class="btn sm ghost" data-k="agent" data-c="'+i+'" data-f="'+slug+'">Live agent build</button>'+
              '</div>'+
              '<div id="sd-'+slug+'-'+i+'" style="display:none"></div></div>';
          }).join('')+'</div>';
      }).join('');

    document.querySelectorAll('#peopleList button[data-c]').forEach(b=>
      b.onclick = e=>{ e.stopPropagation(); draft(b.dataset.f, +b.dataset.c, b.dataset.k); });

    document.querySelectorAll('#peopleList .stk').forEach(el=>
      el.onclick = e=>{
        if(e.target.closest('button') || e.target.closest('a')) return;
        stakeholderDetail(el.dataset.f, +el.dataset.s);
