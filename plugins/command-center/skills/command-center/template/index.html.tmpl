function specAmt(o){
  if(!o) return 0;
  return o._spec != null ? o._spec : (o._spec = specAmtRaw(o));
}
/* The part of the deal that is somebody else's. Shown as context, never added
   to his totals. */
const otherAmt = o => o && o._other != null
  ? o._other : Math.max((Number(o.Amount)||0) - specAmt(o), 0);

