           got:{}};

/* Inbox noise. Invites are handled on Gmail directly, so they never belong here. */
const INVITE_RE = /^(invitation|updated invitation|accepted|declined|tentative|canceled event|cancelled event|new event|notes|meeting records|re: invitation)\b[: ]/i;
const NOISE_RE  = /(noreply|no-reply|notifications?@|donotreply|employeecomms|techcomms|revopscomms|chatter-notifications|mailer-daemon|@myworkday|hackerrankforwork|insiders@salesforce|@mail\.salesforce)/i;
function keepThread(t){
  const m = (t.messages||[]);
  if(!m.length) return false;
  const last = m[m.length-1];
  if(INVITE_RE.test(last.subject||'')) return false;
  if(m.every(x=>NOISE_RE.test(x.sender||''))) return false;
  return true;
}

/* Gmail may return a bare address or RFC-5322 `"Name" <addr>`. Assuming the
   former made three things fail silently at once: every thread read "waiting on
   you", "From Customers" read 0, and the external-only filter emptied the list. */
const addrOf = s => (String(s||'').match(/<([^>]+)>/) || [,String(s||'')])[1]
  .trim().toLowerCase();
/* Any salesforce.com subdomain is internal — eu.salesforce.com was counting as
   a customer. Anchored on the address, not the whole display-name string. */
const isExternal = s => { const a = addrOf(s);
  return !!a && a.includes('@') && !/@([\w-]+\.)*salesforce\.com$/.test(a); };

/* ---- Dismissals -------------------------------------------------------
   "Done" is local only: it hides the row here and never touches Gmail or
   Slack. Archiving is a separate, explicit action. Both are reversible. */
/* Namespaced and versioned. The old generic 'ae-done' / 'ae-scope' keys could
   collide with any other artifact on the same origin — and the values embed
   opportunity names and Slack sender names, so a collision leaked data, not
   just state. */
const LS = {done:'ae-cc:v3:done', scope:'ae-cc:v2:scope', snap:'ae-cc:v3:snap'};
/* Signal keys used to embed opportunity and account names verbatim, so deal
   names ended up in localStorage — outside this file, in the browser profile.
   A short stable hash keeps the "same signal recomputes to the same key"
   property without writing the business string to disk. */
/* Salted per install. Unsalted djb2 over a closed set of ~15 picklist labels is
   a fifteen-entry rainbow table — I could recover "08 - Closed Lost" from a
   stored hash, which makes the "can say THAT it changed but not what it was"
   claim false. The salt lives in the same store, so it defeats precomputation
   rather than a determined local reader; that is the honest bar here. */
const KSALT = (function(){
  try{
    let v = localStorage.getItem('ae-cc:v3:salt');
    if(!v){
      v = (crypto && crypto.getRandomValues
        ? [...crypto.getRandomValues(new Uint8Array(8))]
            .map(b=>b.toString(16).padStart(2,'0')).join('')
        : String(Math.random()).slice(2) + Date.now().toString(36));
      localStorage.setItem('ae-cc:v3:salt', v);
    }
    return v;
  }catch(e){ return 'nosalt'; }
})();
function keyHash(str){
  let h = 5381;
  const t = KSALT + '|' + String(str);
  for(let i=0;i<t.length;i++) h = ((h*33) ^ t.charCodeAt(i)) >>> 0;
  return h.toString(36);
}
let DONE = {};
try{ DONE = JSON.parse(localStorage.getItem(LS.done) || '{}'); }catch(e){ DONE = {}; }
/* Store a day-number, not {at,label} — neither field was ever read back, and
   at ~5k entries the old shape re-serialised 371KB on every single click. */
const DAY = () => Math.floor(Date.now()/864e5);
function saveDone(){
  /* Drop anything older than 90 days so this cannot grow without bound. */
  const cut = DAY() - 90;
  for(const k in DONE) if(typeof DONE[k] === 'number' && DONE[k] < cut) delete DONE[k];
  try{ localStorage.setItem(LS.done, JSON.stringify(DONE)); }catch(e){}
}
function isDone(k){ return DONE[k] != null; }
/* markDone used to take a second "category" argument that was silently
   discarded at four call sites. The prefix in the key is the category. */
function markDone(k){ DONE[k] = DAY(); saveDone();
  /* The prefix IS the section, so the undo bar can be scoped. A single global
     LAST_DONE meant clearing an email then visiting Signals showed
     "Signal cleared. [Undo]" — and Undo un-cleared the email. */
  LAST_DONE = {key:k, kind:String(k).split(':')[0]};
}
/* The most recent dismissal, so a row can offer an inline Undo instead of just
   vanishing and leaving him to find a checkbox. */
let LAST_DONE = null;
function undoLast(){ if(LAST_DONE){ unDone(LAST_DONE.key); LAST_DONE = null; } }
function undoBar(kind, label){
  if(!LAST_DONE || LAST_DONE.kind !== kind) return '';
  return '<div class="note" style="margin:0 0 10px;display:flex;align-items:center;gap:9px">'+
    '<span>'+esc(label||'Marked done.')+'</span>'+
    '<button class="btn sm ghost" id="undoBtn">Undo</button></div>';
}
function wireUndo(after){
  const b = $('undoBtn');
  if(b) b.onclick = ()=>{ undoLast(); if(after) after(); };
}
function unDone(k){ delete DONE[k]; saveDone(); }
function doneCount(){ return Object.keys(DONE).length; }
/* Per-section, because the inbox chip and its Restore button used the global
   count — so the KPI tile could read "Cleared 2" while the chip beneath it read
   "12 cleared", and Restore appeared when nothing email or Slack had been
   cleared at all. */
const doneIn = (...pfx) => Object.keys(DONE)
  .filter(k=>pfx.some(p=>String(k).startsWith(p))).length;
const doneInbox = () => doneIn('mail:','dm:');
/* Slack lines have no stable id, so key off sender + timestamp. */
/* Hashed for the same reason as sig: keys — m.who is a real person's name and
   this key is persisted to localStorage. */
const dmKey = m => 'dm:' + keyHash(m.who + ':' + m.ts);

/* The Slack connector returns concise results as numbered markdown lines:
   "12. #channel-or-DM-label - Sender Name: body 2026-09-04 12:40:35 EDT" */
function parseSlack(txt){
  const out = [];
  (txt||'').split('\n').forEach(line=>{
    const m = /^\s*\d+\.\s+(.+?)\s+-\s+([^:]+):\s*([\s\S]*?)\s*(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})\s*\w*$/.exec(line);
    if(!m) return;
    const [,where,who,text,ts] = m;
    const dm = /^(DM|Group DM)\b/i.test(where);
    if(who.trim() === CC.user.fullName) return;      // his own messages
    if(!text.trim()) return;                            // reactions / empty
    out.push({where:where.trim(), who:who.trim(), text:text.trim(), ts, dm});
  });
  return out;
}

/* ---- Digital portfolio ----------------------------------------------------
   Classified off the three Opportunity product roll-ups, not off deal names.
   Each is a SUM over Opportunity Products, so a non-zero value means the SKU
   is actually on the opp:
     Marketing_Amount__c    → "Marketing Amount"
