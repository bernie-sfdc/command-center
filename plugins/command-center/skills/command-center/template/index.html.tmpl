  return '<div class="exd-in">'+
          '<div class="row" style="flex-wrap:wrap;margin-bottom:9px">'+
            '<a class="btn sm" href="'+SF_URL+'Opportunity/'+idAttr(o.Id)+'/view" target="_blank" '+
              'rel="noopener noreferrer">Open opportunity in Org62 ↗</a>'+
            (o.AccountId?'<a class="btn sm ghost" href="'+SF_URL+'Account/'+idAttr(o.AccountId)+'/view" '+
              'target="_blank" rel="noopener noreferrer">Open account ↗</a>':'')+
            (sfr
              ? '<a class="btn sm ghost" href="'+SF_URL+'SpecialistForecast__c/'+idAttr(sfr.Id)+'/view" '+
                'target="_blank" rel="noopener noreferrer">'+esc(sfr.Name)+' ↗</a>'
              /* realOpp, matching the collapsed row. Without it a name-only
                 $0 fix-queue deal was told it needed an SFR — and offered a
