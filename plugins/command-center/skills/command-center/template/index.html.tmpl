          '<td class="num">'+(t.att == null ? '—' : pct(t.att))+'</td>'+
          '<td class="num">'+(t.acv == null ? '—' : moneyFull(t.acv))+'</td>'+
          '<td>'+(t.acvP === 'Y' ? '🟢 Y' : t.acvP === 'N' ? '🔴 N'
