          (ports.some(p=>p.src==='name')?'<div class="note warn" style="margin:9px 0 0">'+
            'This opp is classified as Digital by <strong>deal name only</strong> — no Opportunity '+
            'Products carry a Marketing, Data or Agentforce amount. Attach products, or it will not '+
            'roll up correctly for anyone.</div>':'')+
          '<div class="row" style="margin-top:11px">'+
            '<button class="btn sm" data-map="'+idAttr(o.Id)+'">Build a mutual action plan</button>'+
            /* The "no SFR" flag now has a remedy on the same row that raises it. */
            (isL1(o) && !sfr && realOpp(o) && SFR_KNOWN()
              ? '<button class="btn sm" data-newsfr="'+idAttr(o.Id)+'" '+
                'data-host="fixn-'+idAttr(o.Id)+'">Create the missing SFR</button>'
              : '')+
