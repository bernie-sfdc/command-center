                  : isL1(o) && !realOpp(o)
                    ? '<span class="tag grey">no specialist amount — not counted</span>'
                    : '<span class="tag grey">bucket L2 — no SFR required</span>')+
          '</div>'+
          '<div class="kv-grid">'+
            kv('Opportunity Id','<span class="mono">'+esc(o.Id)+'</span>')+
            kv('Type',esc(o.Type||'—'))+
            kv('Stage',esc(o.StageName))+
            kv('Forecast category',esc(o.ForecastCategoryName||'—'))+
            kv('My amount',specAmt(o)?moneyFull(specAmt(o)):'—')+kv('Whole deal',Number(o.Amount)?moneyFull(o.Amount):'—')+
            kv('Close date',fmtDate(o.CloseDate)+(overdue?' <span class="tag risk">past due</span>':''))+
            kv('Core AE / owner',esc(o.Owner&&o.Owner.Name||'—'))+
