   local, so the old one-liner returned 1 for something that happened today —
   which made "today" unreachable after 8am and fired every staleness badge a
   day early. Verified against a fixed clock before and after. */
const daysAgo = d => {
  if(!d) return null;
  const a = new Date(); a.setHours(0,0,0,0);
  const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(d));
  if(m) return Math.round((a - new Date(+m[1], +m[2]-1, +m[3])) / 864e5);
  /* Gmail can return RFC-5322 ("Fri, 4 Sep 2026 12:40:35 -0400"), which the
     ISO test above rejects — and the inbox then printed "null days ago" and
     never fired the staleness badge. msgTime already knew this; daysAgo did
     not. Parse it, then reduce to a local calendar day. */
